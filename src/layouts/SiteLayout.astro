---
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";

interface Props {
	title: string;
	description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@400..800&display=swap" rel="stylesheet" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>
		<SiteHeader />
		<slot />
		<SiteFooter />
	</body>
</html>

<style is:global>
	:root {
		--paper: #f5f0e7;
		--reading: #fcfaf6;
		--charcoal: #1d2421;
		--slate: #68726d;
		--amber: #d96b18;
		--amber-wash: #f4dfce;
		--rule: #d8d1c6;
		--text-primary: var(--charcoal);
		--text-secondary: var(--slate);
		--font-sans: "Source Sans 3", "Segoe UI", Arial, sans-serif;
		--font-weight-regular: 400;
		--font-weight-semibold: 600;
		--font-weight-bold: 700;
		--font-weight-heavy: 800;
		--type-nav: 1rem;
		--type-display: clamp(3.2rem, 5.5vw, 4.25rem);
		--type-section: clamp(2.35rem, 4vw, 4rem);
		--type-lead: clamp(1.125rem, 1.5vw, 1.25rem);
		--type-body: 1rem;
		--type-card: 1rem;
		--type-caption: 0.875rem;
		--leading-display: 1.12;
		--leading-heading: 1.18;
		--leading-lead: 1.5;
		--leading-body: 1.6;
		--leading-card: 1.5;
		--leading-caption: 1.4;
		--tracking-display: -0.015em;
		--tracking-heading: -0.01em;
		--tracking-nav: 0;
		--tracking-caption: 0.08em;
		--shell: min(1180px, calc(100vw - 48px));
	}

	* { box-sizing: border-box; }
	html { scroll-behavior: smooth; }
	body { margin: 0; background: var(--paper); color: var(--text-primary); font-family: var(--font-sans); font-size: var(--type-body); font-weight: var(--font-weight-regular); line-height: var(--leading-body); -webkit-font-smoothing: antialiased; }
	a { color: inherit; }
	button, input, select, textarea { font: inherit; }
	button { cursor: pointer; }
	p, h1, h2, h3, blockquote { margin-top: 0; }
	h1, h2, h3 { color: inherit; font-weight: var(--font-weight-bold); }
	h1 { max-width: 980px; margin-bottom: 34px; font-size: var(--type-display); line-height: var(--leading-display); letter-spacing: var(--tracking-display); }
	h1 em { color: var(--text-secondary); font-style: normal; }
	h2 { margin-bottom: 24px; font-size: var(--type-section); line-height: var(--leading-heading); letter-spacing: var(--tracking-heading); }
	h3 { margin-bottom: 12px; font-size: 1.42rem; line-height: var(--leading-heading); letter-spacing: var(--tracking-heading); }
	.shell { width: var(--shell); margin-inline: auto; }
	.section { padding: 110px 0; }
	.section-rule { border-bottom: 1px solid var(--rule); }
	.skip-link { position: fixed; top: 12px; left: 12px; z-index: 100; padding: 10px 15px; background: var(--amber); color: var(--charcoal); font-weight: 700; transform: translateY(-150%); }
	.skip-link:focus { transform: translateY(0); }
	.button { display: inline-flex; align-items: center; justify-content: center; min-height: 50px; padding: 12px 19px; border: 2px solid var(--amber); background: var(--amber); color: var(--charcoal); font-weight: 750; text-decoration: none; transition: background-color 140ms ease, color 140ms ease, transform 140ms ease; }
	.button:hover { background: var(--charcoal); border-color: var(--charcoal); color: var(--paper); transform: translateY(-2px); }
	:where(a, button, input, select, textarea, summary, [tabindex]):focus-visible { outline: 3px solid var(--amber); outline-offset: 4px; }

	@media (max-width: 720px) {
		:root { --shell: min(100% - 32px, 1180px); }
		h1 { font-size: clamp(2.6rem, 11.5vw, 3.6rem); }
		h2 { font-size: clamp(2.1rem, 9vw, 3.25rem); }
		.section { padding: 78px 0; }
	}

	@media (prefers-reduced-motion: reduce) {
		html { scroll-behavior: auto; }
		.button { transition: none; }
	}
</style>
