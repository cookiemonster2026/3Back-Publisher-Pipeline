---
import type { MarkdownInstance } from "astro";
import { posix } from "node:path";
import SiteLayout from "../../layouts/SiteLayout.astro";
import AcceptanceChecklist from "../../components/AcceptanceChecklist.astro";
import { acceptanceSnapshots } from "../../data/acceptance-snapshots.js";
import { doneHistory } from "../../data/deployment-milestones.js";
import { pageSeo, STAFF_DOCS, canonicalUrl } from "../../seo/registry.mjs";
import redirectsSource from "../../../public/_redirects?raw";
import pageMetadataSource from "../../seo/registry.mjs?raw";

export function getStaticPaths() {
	return STAFF_DOCS.map((page) => ({ params: { slug: page.slug || undefined }, props: { page } }));
}

const { page } = Astro.props;
const documents = import.meta.glob<MarkdownInstance<Record<string, unknown>>>([
	"../../../AGENTS.md",
  "../../../Reviewer Agents.md",
	"../../data/acceptance-snapshots/*.md",
	"../../../docs/website-acceptance-checklist.md",
	"../../../docs/publishing/Site-Intent-Map-v1.9.md",
	"../../../docs/publishing/technical-manifest.md",
	"../../../docs/publishing/3Back-Publisher-Role-v0.2.md",
	"../../../docs/publishing/contact-form.md",
	"../../../docs/publishing/Site-Backlog.md",
	"../../../docs/brand/source/3Back-Minimum-Viable-Brand-and-Design-Brief-v0.1.md",
	"../../../docs/brand/source/3Back-Brand-Brief-Appendix-SA-Course-Ecosystem-v0.1.md",
]);
let sourceHtml = "";
if (page.source) {
	const document = await documents[page.source.startsWith("src/") ? `../../${page.source.slice(4)}` : `../../../${page.source}`]();
	// Preserve source text; nest its heading hierarchy beneath the page title.
	sourceHtml = (await document.compiledContent()).replace(/<(\/?)(h)([1-5])(\b[^>]*)>/g, (_tag, slash, h, depth, rest) => `<${slash}${h}${Number(depth) + 1}${rest}>`);
	sourceHtml = sourceHtml.replace(/href="([^"#][^"]*)"/g, (attribute, href: string) => {
		if (/^(?:[a-z]+:|\/)/i.test(href)) return attribute;
		const [target, fragment] = href.split("#");
		const resolved = target.startsWith("docs/") || target === "AGENTS.md" ? target : posix.normalize(posix.join(posix.dirname(page.source!), target));
		const readingCopy = STAFF_DOCS.find((entry) => entry.source === resolved);
		if (readingCopy) return `href="${readingCopy.path}${fragment ? `#${fragment}` : ""}"`;
		if (resolved === "docs/brand/source/3Back-Visual-Direction-Tile-v0.4.pdf") return 'href="/assets/docs/3Back-Visual-Direction-Tile-v0.4.pdf"';
		return attribute;
	});
}
const metadata = pageSeo[page.path];
const docsBySlug = Object.fromEntries(STAFF_DOCS.map((entry) => [entry.slug, entry]));
const docGroups = [
	{ label: "Work Results", slugs: ["backlog", "acceptance-results", "client-errors"] },
	{ label: "Technical", slugs: ["technical-manifest", "redirect-map", "page-metadata", "contact-form", "lms"] },
	{ label: "Marketing", slugs: ["brand", "visual-direction", "site-intent-map", "appendix-a"] },
	{ label: "Procedures", slugs: ["publisher-role", "agents", "reviewer-agents", "acceptance-testing"] },
];
const milestoneDate = new Intl.DateTimeFormat("en-US", { year: "numeric", month: "long", day: "numeric", timeZone: "America/Chicago" });
const milestoneTime = new Intl.DateTimeFormat("en-US", { hour: "numeric", minute: "2-digit", timeZone: "America/Chicago", timeZoneName: "short" });
const milestoneGroups = Object.entries(Object.groupBy(doneHistory, (milestone) => milestoneDate.format(new Date(milestone.completedAt))));
const redirectRows = redirectsSource
	.split(/\r?\n/)
	.map((line) => line.trim())
	.filter((line) => line && !line.startsWith("#"))
	.map((line) => {
		const [from, to, status] = line.split(/\s+/);
		return { from, to, status };
	});
---

<SiteLayout metadata={metadata}>
<main id="main" class="policy-page"><article class:list={["shell", "policy-content", { "acceptance-page": page.slug.startsWith("acceptance-") }]}>
	{!page.slug && <p class="eyebrow">Staff</p>}
	<h1>{page.label}</h1>
	{page.slug ? <p class="docs-back"><span><a href="/docs/">Docs</a>{page.slug.startsWith("acceptance-results") && <> › <a href="/docs/acceptance-testing/">Acceptance Testing</a></>}</span>{page.slug === "acceptance-testing" && <a href="/docs/acceptance-results/">Archive</a>}</p> : <>
		<p>Docs is 3Back’s internal hub. These pages are protected by Cloudflare Access and restricted to people on the <a href="/docs/approved-access-list/">approved access list</a>. Connections are encrypted with HTTPS, and the pages are configured to prevent search-engine indexing.</p>
		<p>Operational Grip is 3Back’s doctrine and the foundation for how it governs itself and delivers its services. This hub brings together reading copies of the current control files that guide that work.</p>
		<div class="doc-groups">
			{docGroups.map((group) => <section>
				<h2>{group.label}</h2>
				<ul>{group.slugs.map((slug) => <li><a href={docsBySlug[slug].path}>{docsBySlug[slug].label}</a></li>)}
					{group.label === "Technical" && <>
						<li><a href="https://3back.com/sitemap-index.xml">Sitemap</a></li>
						<li><a href="https://github.com/cookiemonster2026/3Back-Publisher-Pipeline">GitHub Repository</a></li>
					</>}
				</ul>
			</section>)}
		</div>
	</>}
	{page.slug.startsWith("acceptance-") ? <AcceptanceChecklist snapshotId={page.slug.split("/")[1]} html={sourceHtml} results={page.slug.startsWith("acceptance-results/")} archive={page.slug === "acceptance-results"} /> : sourceHtml && <div class="source-document" set:html={sourceHtml} />}
	{page.slug === "visual-direction" && <p><a href="/assets/docs/3Back-Visual-Direction-Tile-v0.4.pdf">Open Visual Direction PDF</a></p>}
	{page.slug === "approved-access-list" && <div class="source-document">
		<p>This list records the people and email addresses approved to access the staff Docs pages.</p>
		<h2>Approved people</h2>
		<h3>Marcelo Lopez Jr.</h3>
		<ul><li><a href="mailto:marcelo@3back.com">marcelo@3back.com</a></li><li><a href="mailto:marcelo.lopezjr@3back.com">marcelo.lopezjr@3back.com</a></li></ul>
		<h3>Douglas Shimp</h3>
		<ul><li><a href="mailto:doug.shimp@3back.com">doug.shimp@3back.com</a></li><li><a href="mailto:doug@3back.com">doug@3back.com</a></li></ul>
		<h2>Update the list</h2>
		<p>To request an addition, provide the person’s name and email address to the builder in Codex. The builder updates the Cloudflare Access policy and this list, then verifies that the approved person can sign in.</p>
		<p>Cloudflare Access controls sign-in. Updating this page alone does not grant access.</p>
	</div>}
	{page.slug === "page-metadata" && <div class="registry-display">
		<p>Page-by-page settings from the website registry. These describe intended configuration, not proof of deployment or search-engine indexing. Preview builds keep all pages out of search results.</p>
		<div class="registry-scroll" tabindex="0" role="region" aria-label="Page registry table">
		<table class="registry-table">
			<caption>{Object.keys(pageSeo).length} registered pages. Open a page’s metadata for titles, descriptions, and sharing settings.</caption>
			<thead><tr><th scope="col">Page</th><th scope="col">Status</th><th scope="col">Search visibility</th><th scope="col">Missing work</th></tr></thead>
			<tbody>{Object.values(pageSeo).sort((a, b) => a.path.localeCompare(b.path)).map((entry) => <tr>
				<th scope="row"><a href={entry.path}>{entry.title.replace(/ \| 3Back$/, "")}</a><small>{entry.path}</small>
					<details><summary>Metadata details</summary><dl>
						<dt>Page title</dt><dd>{entry.title}</dd>
						<dt>Description</dt><dd>{entry.description}</dd>
						<dt>Preferred URL</dt><dd><a href={canonicalUrl(entry.path)}>{canonicalUrl(entry.path)}</a></dd>
						<dt>Sharing title</dt><dd>{entry.social.title}</dd>
						<dt>Sharing description</dt><dd>{entry.social.description}</dd>
						<dt>Sharing type</dt><dd>{entry.social.type}</dd>
						<dt>Sharing image</dt><dd>{entry.social.image ? <><a href={entry.social.image.src}>View image</a><br />{entry.social.image.alt}</> : "No image specified"}</dd>
						<dt>Structured data</dt><dd>{entry.structuredData ? "Configured" : "Not specified"}</dd>
						{STAFF_DOCS.find(doc => doc.path === entry.path) && <><dt>Staff source file</dt><dd>{STAFF_DOCS.find(doc => doc.path === entry.path)?.source || "Generated staff page"}</dd></>}
					</dl></details>
				</th>
				<td>{entry.status === "stub" ? "Unfinished stub" : "Complete"}</td>
				<td>{entry.indexability === "index, follow" ? "Indexing allowed" : "Excluded from indexing"}</td>
				<td>{entry.status === "stub" ? <ul>{entry.missingWork.map(item => <li>{item}</li>)}</ul> : "None listed"}</td>
			</tr>)}</tbody>
		</table></div>
		<details class="source-document"><summary>View registry source</summary><pre tabindex="0" aria-label="Registry source"><code>{pageMetadataSource}</code></pre></details>
	</div>}
	{page.slug === "redirect-map" && <>
		<p>This is the deployed redirect and rewrite configuration from <code>public/_redirects</code>.</p>
		<table class="redirect-map">
			<thead><tr><th>Source</th><th>Destination</th><th>Status</th></tr></thead>
			<tbody>{redirectRows.map((redirect) => <tr><td><code>{redirect.from}</code></td><td><code>{redirect.to}</code></td><td>{redirect.status}</td></tr>)}</tbody>
		</table>
	</>}
	{page.slug === "lms" && <>
		<p>path.3back.com is the Thinkific classroom. It is not an Astro route on 3back.com.</p>
		<p><a href="https://path.3back.com">Open path.3back.com</a></p>
		<p>What is there: A-CSM, CSP-SM, A-CSPO, and CSP-PO on demand, plus Mechanics of Scrum and the CSM Study Guide.</p>
		<p>The <a href="/training">/training</a> hybrid link points at path.3back.com. There is no LMS manual in this repo.</p>
	</>}
	{page.slug === "client-errors" && <>
		<p>Weekly first-party script failures. Four weeks kept. Email still goes to staff.</p>
		<p id="history-status" role="status">Loading reports.</p>
		<div id="client-error-history"></div>
	</>}
	{page.slug === "backlog" && <>
		{milestoneGroups.map(([date, milestones]) => <section>
			<h3>{date}</h3>
			<ol class="deployment-history" reversed start={milestones?.length}>{milestones?.map((milestone) => <li>
				<time datetime={milestone.completedAt}>{milestoneTime.format(new Date(milestone.completedAt))}</time>
				<span>{acceptanceSnapshots.find(snapshot => snapshot.milestoneCompletedAt === milestone.completedAt) ? <a href={acceptanceSnapshots.find(snapshot => snapshot.milestoneCompletedAt === milestone.completedAt)!.path}>{milestone.description}</a> : milestone.description}</span>
			</li>)}</ol>
		</section>)}
	</>}
</article></main>
</SiteLayout>

<style>

	.registry-display { min-width: 0; }
	.registry-scroll { max-width: 100%; overflow-x: auto; margin-block: 28px; }
	.registry-table { width: 100%; min-width: 680px; border-collapse: collapse; table-layout: fixed; }
	.registry-table caption { text-align: left; margin-bottom: 16px; }
	.registry-table th, .registry-table td { padding: 16px; border: 1px solid var(--rule); text-align: left; vertical-align: top; overflow-wrap: anywhere; }
	.registry-table thead { background: var(--reading); }
	.registry-table th:first-child { width: 40%; }
	.registry-table tbody th { font-weight: 400; }
	.registry-table tbody th > a { font-weight: 700; }
	.registry-table small { display: block; margin-top: 8px; font-size: .875rem; }
	.registry-table details { margin-top: 16px; }
	.registry-display summary { cursor: pointer; font-weight: 600; }
	.registry-display :is(summary, .registry-scroll):focus-visible { outline: 3px solid var(--amber); outline-offset: 3px; }
	.registry-table dt { font-weight: 700; margin-top: 16px; }
	.registry-table dd { margin: 4px 0 0; }
	.registry-table ul { padding-left: 18px; margin: 0; }

 .source-document :global(.review-pass) { color: #008a3d; font-weight: 700; }
 .source-document :global(.review-fail) { color: #ff1616; font-weight: 700; }
 .source-document :global(.review-pending) { color: #2588e8; font-weight: 700; }
 .source-document :global(.review-judgment) { color: #c44b00; font-weight: 700; }
	.policy-content { max-width: 880px; padding-block: clamp(72px, 10vw, 120px); }
	h1 { padding-bottom: 28px; border-bottom: 4px solid var(--amber); }
  .policy-content.acceptance-page { padding-top: 28px; }
  .acceptance-page h1 { margin-block: 0 12px; }
  .acceptance-page .docs-back { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; margin-block: 0 12px; }
	.policy-content :global(h2) { margin: 52px 0 18px; font-size: clamp(1.65rem, 3vw, 2.35rem); }
	.policy-content :global(ul) { margin-bottom: 28px; padding-left: 24px; }
	.policy-content :global(li) { margin-bottom: 12px; }
	.policy-content :global(a) { text-decoration-color: var(--amber); text-underline-offset: 3px; }
	.eyebrow { font-size: 0.875rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
	.source-document { min-width: 0; overflow-wrap: anywhere; }
	.source-document :global(pre) { max-width: 100%; overflow: auto; padding: 16px; background: var(--reading); border: 1px solid var(--rule); }
	.source-document :global(table) { display: block; max-width: 100%; overflow-x: auto; border-collapse: collapse; margin-block: 24px; }
	.source-document :global(th), .source-document :global(td) { min-width: 120px; padding: 10px; border: 1px solid var(--rule); text-align: left; vertical-align: top; }
	.source-document :global(th) { background: var(--reading); }
	.source-document :global(h3), .source-document :global(h4) { margin-top: 32px; }
	#client-error-history :global(iframe) { width: 100%; height: 640px; border: 1px solid var(--rule); background: var(--reading); }
	.doc-groups { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(20px, 4vw, 48px); margin-top: 40px; }
	.doc-groups section { min-width: 0; }
	.doc-groups h2 { margin-top: 0; font-size: clamp(1.35rem, 2.2vw, 1.8rem); }
	.doc-groups ul { padding-left: 20px; }
	.deployment-history { padding-left: 24px; }
	.deployment-history :global(time) { display: block; font-weight: 700; }
	.redirect-map { display: block; max-width: 100%; overflow-x: auto; border-collapse: collapse; margin-block: 24px; }
	.redirect-map th, .redirect-map td { min-width: 120px; padding: 10px; border: 1px solid var(--rule); text-align: left; vertical-align: top; }
	.redirect-map th { background: var(--reading); }
	@media (max-width: 960px) { .doc-groups { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
	@media (max-width: 720px) { .doc-groups { grid-template-columns: 1fr; gap: 8px; } }
</style>

<script>
	const history = document.getElementById("client-error-history");
	const status = document.getElementById("history-status");
	if (history && status) {
		fetch("/api/client-errors/history", { credentials: "same-origin", referrerPolicy: "no-referrer", cache: "no-store" })
			.then(async (response) => { if (!response.ok) throw new Error("History unavailable"); return response.json(); })
			.then((result) => {
				if (!Array.isArray(result.weeks)) throw new Error("Invalid history");
				status.textContent = result.weeks.length ? "" : "No reports yet.";
				for (const week of result.weeks.slice(0, 4)) {
					const section = document.createElement("section");
					const heading = document.createElement("h2"); heading.textContent = week.subject;
					const frame = document.createElement("iframe"); frame.title = `JavaScript errors ${week.week}`;
					frame.setAttribute("sandbox", ""); frame.referrerPolicy = "no-referrer";
					frame.srcdoc = `<meta charset="utf-8"><meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline'"><style>body{font:16px/1.6 sans-serif;color:#1d2421;padding:16px;overflow-wrap:anywhere}table{border-collapse:collapse;display:block;overflow:auto}td,th{border:1px solid #d8d1c6;padding:8px;text-align:left}</style>${week.html}`;
					section.append(heading, frame); history.append(section);
				}
			})
			.catch(() => { status.textContent = "Reports are unavailable right now. Please try again later."; });
	}
</script>
