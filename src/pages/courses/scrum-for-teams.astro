or:var(--amber)}.request-copy h2{max-width:520px;font-size:clamp(2.3rem,4.7vw,4.4rem);line-height:1.04}.request-copy p:last-child{max-width:500px;font-size:1.125rem;line-height:1.62}.private-inquiry-form,.form-success{padding:clamp(26px,4vw,42px);border-top:4px solid var(--amber);background:var(--paper);color:var(--charcoal)}.form-fields{display:grid;grid-template-columns:1fr 1fr;gap:20px}.field{display:grid;gap:7px}.field-full{grid-column:1/-1}.field label{font-size:.875rem;font-weight:700}.field label span{color:var(--text-secondary);font-size:.75rem;font-weight:600;letter-spacing:.03em;text-transform:uppercase}.field input,.field textarea{width:100%;padding:12px 13px;border:1px solid #a9ada6;border-radius:0;background:#fff;color:var(--charcoal);font:inherit}.field textarea{resize:vertical}.turnstile-wrap{min-height:65px;margin-top:24px}.form-error{margin:0 0 18px;color:#9e2a18;font-weight:600}.submit-button{width:100%}.submit-button:disabled{cursor:not-allowed;opacity:.6}.form-success h3{font-size:1.75rem}.form-success p{margin-bottom:0}.quiet-links{padding:30px 0 38px;border-bottom:1px solid var(--rule)}.quiet-links .shell{display:flex;flex-wrap:wrap;gap:14px 34px}.quiet-links a{color:var(--charcoal);font-weight:700;text-underline-offset:5px;text-decoration-color:var(--amber);text-decoration-thickness:2px}
@media(max-width:850px){.hero-shell{grid-template-columns:1fr}.hero-copy{padding-bottom:30px}.ai-note{margin:0 0 46px;max-width:690px}.three-column,.ground-grid{grid-template-columns:1fr}.three-column article,.three-column article+article,.ground-grid article,.ground-grid article+article{padding:24px 0;border-left:0;border-bottom:1px solid var(--rule)}.section-number{margin-bottom:12px}.ground-heading{grid-template-columns:1fr;gap:6px}.private-inquiry-grid{grid-template-columns:1fr}}
