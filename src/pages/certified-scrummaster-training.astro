---
import SiteLayout from "../layouts/SiteLayout.astro";
import { Image } from "astro:assets";
import heroImage from "../assets/certified-scrummaster/csm-geometric-craft.jpg";
import workbookImage from "../assets/certified-scrummaster/csm-open-workbook.jpg";
import { pageSeo } from "../seo/registry.mjs";

const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? "";
---

<SiteLayout metadata={pageSeo["/certified-scrummaster-training"]}>
	<main id="main" class="csm-page">
		<section class="csm-hero"><div class="shell hero-grid"><div class="hero-copy"><p class="eyebrow">Scrum Alliance® credential</p><h1>Certified ScrumMaster® Training</h1><p class="framing-line">The official Certified ScrumMaster® course, delivered by trainers who have been part of the Scrum Alliance story since the founding era.</p><p class="hero-action"><button class="primary-cta" type="button" data-private-request-trigger aria-expanded="false" aria-controls="private-course-request">Request an on-site (or private virtual) course</button></p></div><div class="hero-visual"><figure class="hero-image"><Image src={heroImage} alt="Layered paper forms with a small amber light" layout="constrained" widths={[600, 900, 1168]} sizes="(max-width: 760px) 100vw, 46vw" priority /></figure><aside class="credential-panel" aria-label="Certified ScrumMaster credential"><img src="/assets/courses/sa-csm.png" alt="Scrum Alliance Certified ScrumMaster certification badge" width="150" height="150" /><p>Official CSM® credential</p></aside></div></div></section>
		<section id="private-course-request" class="private-request" aria-labelledby="private-request-title" hidden><div class="shell private-request-grid"><div><p class="eyebrow">Private course request</p><h2 id="private-request-title">Tell us about your team.</h2><p>We will follow up by email to discuss a private onsite or virtual CSM course.</p></div><form class="private-request-form" action="/api/csm-private-request" method="post" data-private-request-form novalidate><div class="form-fields"><div class="field"><label for="csm-first-name">First name</label><input id="csm-first-name" name="first_name" autocomplete="given-name" required /></div><div class="field"><label for="csm-last-name">Last name</label><input id="csm-last-name" name="last_name" autocomplete="family-name" required /></div><div class="field"><label for="csm-email">Email</label><input id="csm-email" name="email" type="email" autocomplete="email" required /></div><div class="field"><label for="csm-confirm-email">Email again</label><input id="csm-confirm-email" name="confirm_email" type="email" autocomplete="email" required /></div><div class="field field-full"><label for="csm-company">Company name</label><input id="csm-company" name="company_name" autocomplete="organization" required /></div><div class="field field-full"><label for="csm-note">Note</label><textarea id="csm-note" name="note" rows="5" required></textarea></div></div><div class="turnstile-wrap">{turnstileSiteKey ? <div class="cf-turnstile" data-sitekey={turnstileSiteKey}></div> : <p class="form-error">This form is not configured yet.</p>}</div><p class="form-error" role="alert" data-form-error hidden></p><button class="primary-cta submit-button" type="submit" disabled={!turnstileSiteKey}>Send request</button><p class="form-success" role="status" data-form-success hidden>Thank you. We received your request and will reply by email.</p></form></div></section>
		<section class="section what-is-section section-rule"><div class="shell content-grid"><h2>What the CSM is</h2><div class="body-copy"><p>The Certified ScrumMaster® (CSM®) is the foundational credential from Scrum Alliance. It gives you a solid understanding of the Scrum framework: accountabilities, events, and artifacts, and the practical skill to apply it with a real team.</p><p>The course is 16 hours of live instruction taught by a Certified Scrum Trainer®. There are no formal prerequisites. After the course you take the Scrum Alliance exam (50 questions, 37 correct to pass). Two attempts are included. Upon passing you receive the CSM certification and membership.</p></div></div></section>
		<section class="why-section"><div class="shell why-grid"><div><p class="eyebrow eyebrow-light">Why take it with 3Back</p><h2>Delivered continuously from the days of inception to the present.</h2></div><div class="why-copy"><p>More than 25,000 students have trained with us. We know what it takes for the credential to stick in real organizations, not just on a résumé.</p><p>Our classes emphasize judgment and applied practice. You leave able to guide a team, not just recite the framework.</p></div></div></section>
		<section class="section inclusions-section section-rule"><div class="shell content-grid"><h2>What you get with 3Back</h2><div class="body-copy"><ul class="inclusions-list"><li>Official 16-hour CSM course taught by a Certified Scrum Trainer®</li><li>Scrum Study Guide</li><li>Practice exams</li><li>Access to our LMS for course materials and exam preparation</li><li>Exam fee and two attempts included</li><li>Two-year Scrum Alliance membership upon passing</li><li>99% pass rate supported by the Study Guide, practice exams, and LMS</li></ul><figure class="workbook-image"><Image src={workbookImage} alt="Open blank workbook beside a dark notebook" layout="constrained" widths={[480, 720, 960]} sizes="(max-width: 760px) 100vw, 48vw" loading="lazy" /></figure><p class="resource-line"><a href="/downloads/certified-scrummaster-data-sheet.pdf">Download the CSM data sheet</a> for the full agenda and logistics details.</p><p class="resource-line">Questions about the credential or course logistics? See the <a href="/scrum-alliance-courses-faq/#certified-scrummaster">Scrum Alliance Courses FAQ</a>.</p></div></div></section>
		<section class="section teams-section section-rule"><div class="shell content-grid"><h2>How teams take the course</h2><div class="body-copy"><p>Most organizations that work with us bring the course in as private training: onsite or virtual, so the whole group learns the same language and practices together.</p><p>Open enrollment seats are also available through our scheduled events when that fits better.</p><p>Either path leads to the same credential and the same preparation support.</p><p class="team-actions"><button class="primary-cta" type="button" data-private-request-trigger aria-expanded="false" aria-controls="private-course-request">Request an on-site (or private virtual) course</button><a class="secondary-cta" href="/events">View course schedule</a></p></div></div></section>
		<section class="section audience-section"><div class="shell content-grid"><h2>Who this is for</h2><div class="body-copy"><p>Primarily for leaders and managers who are sending people or whole teams.</p><p>It is also right for individuals who want to become a more effective member of a Scrum team. The CSM teaches the skills that let one person contribute to a team that actually works.</p></div></div></section>
		<section class="closing-actions"><div class="shell"><h2>Choose the right course path.</h2><div class="closing-links"><button class="primary-cta" type="button" data-private-request-trigger aria-expanded="false" aria-controls="private-course-request">Request an on-site (or private virtual) course</button><a class="secondary-cta" href="/events">View course schedule</a><a class="secondary-cta" href="/downloads/certified-scrummaster-data-sheet.pdf">Download the CSM data sheet</a><a class="secondary-cta" href="/scrum-alliance-courses-faq/#certified-scrummaster">Scrum Alliance Courses FAQ</a></div><p class="attribution">Certified ScrumMaster® is a certification mark of Scrum Alliance, Inc.</p></div></section>
	</main>
</SiteLayout>

<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<script>
	declare global { interface Window { turnstile?: { reset(): void } } }
	const requestSection = document.querySelector("#private-course-request");
	const requestForm = document.querySelector("[data-private-request-form]");
	const requestTriggers = document.querySelectorAll("[data-private-request-trigger]");
	if (requestSection instanceof HTMLElement && requestForm instanceof HTMLFormElement) {
		const error = requestForm.querySelector("[data-form-error]"); const success = requestForm.querySelector("[data-form-success]"); const button = requestForm.querySelector("button[type='submit']"); const firstName = requestForm.querySelector<HTMLInputElement>("[name='first_name']"); const email = requestForm.querySelector<HTMLInputElement>("[name='email']"); const confirmEmail = requestForm.querySelector<HTMLInputElement>("[name='confirm_email']");
		const openRequest = () => { requestSection.hidden = false; requestTriggers.forEach((trigger) => trigger.setAttribute("aria-expanded", "true")); requestSection.scrollIntoView({ behavior: "smooth", block: "start" }); window.setTimeout(() => firstName?.focus(), 250); };
		requestTriggers.forEach((trigger) => trigger.addEventListener("click", openRequest));
		const validateEmails = () => { if (email && confirmEmail) confirmEmail.setCustomValidity(email.value && confirmEmail.value && email.value !== confirmEmail.value ? "Email addresses must match." : ""); };
		email?.addEventListener("input", validateEmails); confirmEmail?.addEventListener("input", validateEmails);
		requestForm.addEventListener("submit", async (event) => { event.preventDefault(); validateEmails(); if (!(error instanceof HTMLElement) || !(success instanceof HTMLElement) || !(button instanceof HTMLButtonElement)) return; error.hidden = true; success.hidden = true; if (!requestForm.reportValidity()) return; button.disabled = true; button.textContent = "Sending..."; try { const response = await fetch(requestForm.action, { method: "POST", body: new FormData(requestForm), headers: { Accept: "application/json" } }); const result = await response.json().catch(() => ({})); if (!response.ok) throw new Error(typeof result.error === "string" ? result.error : "We could not send your request. Please try again."); requestForm.reset(); success.hidden = false; window.turnstile?.reset(); } catch (submissionError) { error.textContent = submissionError instanceof Error ? submissionError.message : "We could not send your request. Please try again."; error.hidden = false; window.turnstile?.reset(); } finally { button.disabled = false; button.textContent = "Send request"; } });
	}
</script>

<style>
	.csm-hero { padding: 110px 0 84px; border-bottom: 1px solid var(--rule); background: var(--paper); } .hero-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(380px, .9fr); gap: clamp(42px, 7vw, 112px); align-items: center; } .hero-copy { max-width: 700px; } .hero-visual { display: grid; gap: 18px; } .hero-image { margin: 0; border-bottom: 4px solid var(--amber); background: #e8dfd3; } .hero-image :global(img), .workbook-image :global(img) { display: block; width: 100%; height: auto; } .eyebrow { margin: 0 0 16px; color: var(--amber-text); font-size: var(--type-caption); font-weight: var(--font-weight-heavy); letter-spacing: var(--tracking-caption); text-transform: uppercase; } .hero-copy h1 { margin-bottom: 24px; } .framing-line { max-width: 720px; margin-bottom: 32px; font-size: var(--type-lead); font-weight: var(--font-weight-semibold); line-height: var(--leading-lead); } .hero-action { margin: 0; }
	.primary-cta, .secondary-cta { display: inline-flex; align-items: center; justify-content: center; min-height: 50px; padding: 12px 19px; font: inherit; font-weight: var(--font-weight-bold); line-height: 1.25; text-align: center; text-decoration: none; cursor: pointer; } .primary-cta { border: 2px solid var(--amber); background: var(--amber); color: var(--charcoal); box-shadow: 5px 5px 0 var(--charcoal); } .primary-cta:hover { background: var(--charcoal); border-color: var(--charcoal); color: var(--paper); box-shadow: 5px 5px 0 var(--amber); } .secondary-cta { border: 1px solid currentColor; color: inherit; } .secondary-cta:hover { background: var(--charcoal); border-color: var(--charcoal); color: var(--paper); }
	.credential-panel { display: flex; align-items: center; justify-content: center; gap: 16px; padding: 0; text-align: left; } .credential-panel img { width: 90px; height: 90px; object-fit: contain; } .credential-panel p { margin: 0; color: var(--text-secondary); font-size: var(--type-caption); font-weight: var(--font-weight-bold); letter-spacing: .04em; text-transform: uppercase; }
	.private-request { padding: 74px 0; border-bottom: 1px solid var(--rule); background: #ece8e0; } .private-request-grid { display: grid; grid-template-columns: minmax(0, .75fr) minmax(360px, .85fr); gap: clamp(46px, 8vw, 120px); align-items: start; } .private-request h2 { margin-bottom: 16px; font-size: clamp(2rem, 3.6vw, 3.4rem); } .private-request-grid > div > p:last-child { max-width: 420px; font-size: var(--type-lead); line-height: var(--leading-lead); } .private-request-form { padding: clamp(26px, 4vw, 42px); border-top: 4px solid var(--amber); background: var(--paper); box-shadow: 0 12px 30px rgba(29, 36, 33, .08); } .form-fields { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; } .field { display: grid; gap: 7px; } .field-full { grid-column: 1 / -1; } .field label { color: var(--charcoal); font-size: var(--type-caption); font-weight: var(--font-weight-bold); } .field input, .field textarea { width: 100%; border: 1px solid #a9ada6; border-radius: 0; background: #fff; color: var(--charcoal); padding: 12px 13px; font: inherit; } .field textarea { resize: vertical; } .turnstile-wrap { min-height: 65px; margin-top: 24px; } .form-error { margin: 0 0 18px; color: #9e2a18; font-weight: var(--font-weight-semibold); } .submit-button { width: 100%; } .submit-button:disabled { cursor: not-allowed; opacity: .6; } .form-success { margin: 20px 0 0; color: #315d42; font-weight: var(--font-weight-semibold); line-height: 1.5; }
	.content-grid { display: grid; grid-template-columns: minmax(220px, .8fr) minmax(0, 1.45fr); gap: clamp(32px, 8vw, 130px); } .content-grid h2 { margin: 0; font-size: clamp(2rem, 3.6vw, 3.4rem); } .body-copy { max-width: 720px; } .body-copy p { font-size: 1.125rem; } .body-copy p:last-child { margin-bottom: 0; } .workbook-image { margin: 38px 0 0; border-top: 3px solid var(--amber); } .what-is-section { background: var(--reading); }
	.why-section { padding: 90px 0; background: var(--charcoal); color: var(--paper); border-top: 5px solid var(--amber); } .why-grid { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, .9fr); gap: clamp(34px, 8vw, 130px); } .eyebrow-light { color: #f2a56f; } .why-section h2 { max-width: 660px; margin-bottom: 0; font-size: clamp(2.15rem, 4vw, 3.7rem); } .why-copy { max-width: 570px; font-size: 1.25rem; line-height: 1.55; } .why-copy p:last-child { margin-bottom: 0; }
	.inclusions-list { display: grid; gap: 0; margin: 0 0 32px; padding: 0; list-style: none; border-top: 2px solid var(--charcoal); } .inclusions-list li { padding: 15px 0 15px 34px; border-bottom: 1px solid var(--rule); font-size: 1.0625rem; font-weight: var(--font-weight-semibold); line-height: 1.45; position: relative; } .inclusions-list li::before { content: ""; position: absolute; top: 23px; left: 4px; width: 13px; height: 7px; border-bottom: 3px solid var(--amber); border-left: 3px solid var(--amber); transform: rotate(-45deg); } .resource-line a { color: var(--amber-text); font-weight: var(--font-weight-bold); text-decoration-color: var(--amber); text-decoration-thickness: 2px; text-underline-offset: 4px; } .teams-section { background: #ece8e0; } .team-actions { display: flex; flex-wrap: wrap; gap: 16px; align-items: center; margin-top: 32px; } .audience-section { padding-bottom: 104px; }
	.closing-actions { padding: 76px 0; background: var(--charcoal); color: var(--paper); border-top: 5px solid var(--amber); } .closing-actions h2 { max-width: 600px; margin-bottom: 30px; font-size: clamp(2rem, 4vw, 3.4rem); } .closing-links { display: flex; flex-wrap: wrap; gap: 14px; } .closing-actions .secondary-cta { color: var(--paper); } .closing-actions .secondary-cta:hover { background: var(--paper); border-color: var(--paper); color: var(--charcoal); } .attribution { margin: 32px 0 0; color: #b9c1bc; font-size: var(--type-caption); }
	@media (max-width: 760px) { .csm-hero { padding: 80px 0 62px; } .hero-grid, .private-request-grid, .content-grid, .why-grid { grid-template-columns: 1fr; } .hero-visual { gap: 20px; } .hero-image { max-width: 620px; } .credential-panel { width: fit-content; justify-self: center; flex-direction: column; gap: 8px; text-align: center; } .form-fields { grid-template-columns: 1fr; }.field-full { grid-column: auto; } .private-request { padding: 64px 0; } .content-grid { gap: 22px; } .why-section { padding: 68px 0; } .why-grid { gap: 28px; } .section { padding: 72px 0; } .audience-section { padding-bottom: 74px; } .closing-actions { padding: 64px 0; } .primary-cta, .team-actions .secondary-cta, .closing-links .secondary-cta { width: 100%; } .closing-links { display: grid; } }
</style>
