---
import { Image } from "astro:assets";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { pageSeo } from "../../seo/registry.mjs";
import cover from "../../assets/scrum-mastering-1/guidebook-cover.png";
import badge from "../../assets/scrum-mastering-1/rsm1-badge.png";
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? "";
const chapters = ["Scrum in a Nutshell", "The Scrum Team", "The Team's Scrum Master", "Modes of the Scrum Master", "People Outside the Team", "The Team Swarm", "Leadership", "The Backlog", "Technical Debt", "The Story's Definition of Done", "Velocity, Size, and Effort", "Backlog Refinement", "Planning Day", "The Daily Scrum", "Scaling an Organization"];
const clusters = [chapters.slice(0, 4), chapters.slice(4, 8), chapters.slice(8, 12), chapters.slice(12)];
const progression = [
 ["Study", "Learn each module's official objectives with the agent tutor."],
 ["Apply", "Connect the material to your own work and domain experience."],
 ["Check", "Take an official objective-based check."],
 ["Unlock", "Score at least 80% to unlock the next module."],
 ["Earn RSM1", "Complete all requirements within 12 months to earn RSM1."],
];
---
<SiteLayout metadata={pageSeo["/training/scrum-mastering-1"]}>
<main id="main" class="sm1-page">
 <section class="sm1-hero">
  <div class="shell">
   <nav class="breadcrumb" aria-label="Breadcrumb"><ol><li><a href="/">3Back</a></li><li><a href="/training">Training</a></li><li aria-current="page">Scrum Mastering I</li></ol></nav>
   <div class="hero-grid">
    <div class="hero-title"><p class="eyebrow">Scrum Leadership Series</p><h1>Scrum Mastering I: Facilitating Improvement</h1><p class="hero-heading">Learn to lead the improvement game.</p></div>
    <div class="hero-artifacts">
     <div class="hero-badge"><Image src={badge} alt="Recognized Scrum Master 1 credential badge." width={210} height={205} loading="eager" fetchpriority="high" /><p>Earn the Recognized Scrum Master 1 credential.</p></div>
     <div class="hero-cover"><Image src={cover} alt="Cover of Scrum Mastering I: Facilitating Improvement by Dan Rawsthorne and Doug Shimp." width={180} widths={[120, 180, 270, 360]} sizes="(max-width: 600px) 100px, (max-width: 900px) 150px, 180px" loading="eager" fetchpriority="high" /><p>Printed guidebook included</p></div>
    </div>
    <div class="hero-body"><p>Scrum gives a team a way to organize around complex work. SM1 shows you how a Scrum Master helps that team make decisions, confront impediments, protect accountability, and continuously improve how the work gets done.</p><p>Study at your own pace with an agent tutor grounded in the SM1 guidebook. Apply each idea to your own work and demonstrate your understanding of the learning objectives module by module. Complete the requirements to earn the <a href="https://scrumguide.org/recognized-courses/scrum-master-1/">Recognized Scrum Master 1</a> (RSM1) credential, recognized by the Scrum Guide Organization and verifiable at ScrumGuide.org.</p></div>
    <div class="hero-offer"><p class="offer-line">$150 | Printed guidebook included | 12 months to complete</p><button class="enrollment" type="button" disabled>Enrollment coming soon</button><p class="shipping">Printed-book delivery is limited to available destinations. Additional shipping charges may apply.</p><a class="shipping-policy" href="/policies">Course policies</a></div>
   </div>
  </div>
 </section>
 <div class="proof-strip"><ul class="shell"><li>15 modules</li><li>80% to advance</li><li>12 months</li><li>RSM1 credential</li></ul></div>
<section class="commercial-split section-rule"><div class="shell"><h2>Take Scrum Mastering I</h2><p class="split-lead">Same course. Two ways to take it.</p><div class="delivery-grid"><div><h3>Public self-paced</h3><p>Study on your own with the guidebook, the agent tutor, and the module checks. $150. Printed guidebook included.</p><button class="enrollment" type="button" disabled>Enrollment coming soon</button></div><div><h3>Private Live</h3><p>Same material, delivered to your team onsite or virtually.</p><button class="primary-cta" type="button" data-private-request-trigger aria-controls="sm1-private-inquiry" aria-expanded="false">Request a private SM1 course</button></div></div></div></section>
<section id="sm1-private-inquiry" class="private-inquiry" aria-labelledby="sm1-private-inquiry-title" hidden><div class="shell private-inquiry-grid"><div><p class="eyebrow">Private Live course inquiry</p><h2 id="sm1-private-inquiry-title" tabindex="-1">Tell us about your Scrum Team.</h2><p>Tell us about your Scrum Team and training needs. We'll reply by email to schedule a 15- to 30-minute conversation and determine whether a private onsite or virtual SM1 course is the right fit.</p></div><div><form class="private-inquiry-form" action="/api/sm1-private-inquiry" method="post" data-sm1-private-form novalidate><div class="form-fields"><div class="field"><label for="sm1-first-name">First name</label><input id="sm1-first-name" name="first_name" autocomplete="given-name" required maxlength="80" /></div><div class="field"><label for="sm1-last-name">Last name</label><input id="sm1-last-name" name="last_name" autocomplete="family-name" required maxlength="80" /></div><div class="field"><label for="sm1-email">Email</label><input id="sm1-email" name="email" type="email" autocomplete="email" required maxlength="254" /></div><div class="field"><label for="sm1-confirm-email">Email again</label><input id="sm1-confirm-email" name="confirm_email" type="email" autocomplete="email" required maxlength="254" /></div><div class="field field-full"><label for="sm1-company">Company name</label><input id="sm1-company" name="company_name" autocomplete="organization" required maxlength="160" /></div><div class="field field-full"><label for="sm1-note">Tell us about your Scrum Team and training needs.</label><textarea id="sm1-note" name="note" rows="5" required maxlength="4000"></textarea></div></div><div class="turnstile-wrap">{turnstileSiteKey ? <div class="cf-turnstile" data-sitekey={turnstileSiteKey}></div> : <p class="form-error">This form is not configured yet.</p>}</div><p id="sm1-private-form-error" class="form-error" role="alert" tabindex="-1" data-form-error hidden></p><button class="primary-cta submit-button" type="submit" disabled={!turnstileSiteKey}>Send inquiry</button></form><div class="form-success" role="status" tabindex="-1" data-form-success hidden><h3>Thank you. We received your inquiry.</h3><p>We'll reply by email to schedule a 15- to 30-minute conversation about your Scrum Team and training needs. Please look for our reply.</p></div></div></div></section>
<section class="domain-guides-band"><div class="shell split"><h2>Foundation is not capability.</h2><div class="section-body"><p>SM1 can give shared language and a better way to see the work. It does not develop Domain Guides. That happens in the live work of this company, with your people, over months.</p><a class="secondary-cta" href="/domain-guides">Explore the Domain Guides program</a></div></div></section>
<section class="sm1-section section-rule"><div class="shell split"><h2>Go beyond running Scrum events</h2><div class="section-body"><p>A Scrum Master does more than schedule meetings and repeat framework rules. SM1 develops a practical account of the role from inside the Team: how authority works, how decisions are made, how improvement is facilitated, and how the Team stays accountable for its work.</p>
<p>Through the course, you will learn to:</p>
<ul><li>Distinguish the responsibilities of the Team Member, Product Owner, Scrum Master, Business Owner, Stakeholder, and Subject Matter Expert</li><li>Facilitate Team decisions, Retrospectives, and Intraspectives</li><li>Organize work through the Team Swarm</li><li>Protect Product Owner priority decisions and Team accountability</li><li>Expose Technical Debt and strengthen the Definition of Done</li><li>Improve refinement, planning, daily adaptation, and organizational scaling decisions</li></ul></div></div></section>
<section class="sm1-section section-rule"><div class="shell split"><h2>Learn to lead the improvement game.</h2><div class="section-body"><p>This goes well beyond classic Scrum Guide material. SM1 is about how a Scrum Master helps a team decide, confront impediments, protect accountability, and improve the work.</p>
<p>You will examine the Team Swarm, seven Team Values, Agreement-Based Planning, the Team Captain, Abnormal Termination, the book&#x27;s treatment of Technical Debt, and the distinction between Acceptance Criteria and Standard of Care.</p></div></div></section>
<section class="sm1-section section-rule"><div class="shell"><h2>Demonstrate what you understand</h2><p>Work through 15 modules with expert guidance.</p><ol class="progression">{progression.map(([title, copy], index) => <li><span class="step-number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span><h3>{title}</h3><p>{copy}</p></li>)}</ol><p>When an answer reveals a gap, the tutor returns to the missed objectives before you try again.</p></div></section>
<section class="credential-band"><div class="shell credential-grid"><Image src={badge} alt="Recognized Scrum Master 1 credential badge." width={138} height={135} loading="lazy" /><div><h2>Recognition based on demonstrated understanding, not attendance alone</h2><p>Earn RSM1 by completing all 15 modules and passing the required objective-based checks within 12 months. The credential recognizes demonstrated understanding of the Scrum Mastering I learning objectives. Domain experience is where that understanding is put to work.</p>
<p>Your RSM1 credential is recognized by the Scrum Guide Organization and verifiable at ScrumGuide.org.</p></div></div></section>
<section class="sm1-section section-rule"><div class="shell split"><h2>What your $150 includes</h2><div class="section-body"><ul><li>Twelve months of access to the complete self-paced SM1 course</li><li>An agent tutor grounded in the SM1 guidebook</li><li>Official objective-based knowledge checks</li><li>A printed copy of Scrum Mastering I: Facilitating Improvement</li><li>The <a href="https://scrumguide.org/recognized-courses/scrum-master-1/">Recognized Scrum Master 1</a> credential</li><li>Recognition and verification through ScrumGuide.org</li></ul>
<p>The public self-paced course does not include a live instructor or office hours.</p></div></div></section>
<section class="sm1-section section-rule"><div class="shell"><h2>15 modules. One complete course.</h2><p>Each module follows the corresponding chapter of the Scrum Mastering I guidebook.</p><div class="curriculum">{clusters.map((cluster, index) => <ol start={index * 4 + 1}>{cluster.map(chapter => <li>{chapter}</li>)}</ol>)}</div></div></section>
<section class="sm1-section section-rule"><div class="shell split"><h2>Put it to work in your domain</h2><div class="section-body"><p>The course can teach the material and test your understanding. It cannot supply your domain experience for you. The value comes from recognizing how these ideas appear in the work you are already doing and deciding how to apply them there.</p></div></div></section>
<section class="reviews-band"><div class="shell split"><div><p class="eyebrow">Client reviews</p><h2>The reviews are ours.</h2></div><div class="section-body"><p>More than 25,000 people have coached and trained with 3Back.</p><a class="secondary-cta" href="/reviews/">Read 3Back reviews</a></div></div></section>
<section class="closing-actions"><div class="shell"><h2>Choose the right course path.</h2><div class="closing-links"><button class="enrollment" type="button" disabled>Enrollment coming soon</button><button class="primary-cta" type="button" data-private-request-trigger aria-controls="sm1-private-inquiry" aria-expanded="false">Request a private SM1 course</button><a class="secondary-cta" href="/training/scrum-mastering-1-data-sheet/">Download the SM1 data sheet</a><a class="secondary-cta" href="/domain-guides">Explore Domain Guides</a></div></div></section>
</main>
</SiteLayout>
<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<script>
 declare global { interface Window { turnstile?: { reset(): void } } }
 const inquirySection = document.querySelector("#sm1-private-inquiry");
 const inquiryHeading = document.querySelector("#sm1-private-inquiry-title");
 const inquiryForm = document.querySelector("[data-sm1-private-form]");
 const inquiryTriggers = document.querySelectorAll("[data-private-request-trigger]");
 if (inquirySection instanceof HTMLElement && inquiryForm instanceof HTMLFormElement) {
  const error = inquiryForm.querySelector("[data-form-error]"); const success = inquirySection.querySelector("[data-form-success]"); const button = inquiryForm.querySelector("button[type='submit']"); const email = inquiryForm.querySelector<HTMLInputElement>("[name='email']"); const confirmEmail = inquiryForm.querySelector<HTMLInputElement>("[name='confirm_email']");
  const openInquiry = () => { inquirySection.hidden = false; inquiryTriggers.forEach((trigger) => trigger.setAttribute("aria-expanded", "true")); inquirySection.scrollIntoView({ behavior: "smooth", block: "start" }); window.setTimeout(() => { if (inquiryHeading instanceof HTMLElement) inquiryHeading.focus(); }, 250); };
  inquiryTriggers.forEach((trigger) => trigger.addEventListener("click", openInquiry));
  const validateEmails = () => { if (email && confirmEmail) confirmEmail.setCustomValidity(email.value && confirmEmail.value && email.value !== confirmEmail.value ? "Email addresses must match." : ""); };
  email?.addEventListener("input", validateEmails); confirmEmail?.addEventListener("input", validateEmails);
  inquiryForm.addEventListener("submit", async (event) => { event.preventDefault(); validateEmails(); if (!(error instanceof HTMLElement) || !(success instanceof HTMLElement) || !(button instanceof HTMLButtonElement)) return; error.hidden = true; inquiryForm.removeAttribute("aria-describedby"); if (!inquiryForm.reportValidity()) return; button.disabled = true; button.textContent = "Sending..."; try { const response = await fetch(inquiryForm.action, { method: "POST", body: new FormData(inquiryForm), headers: { Accept: "application/json" } }); const result = await response.json().catch(() => ({})); if (!response.ok) throw new Error(typeof result.error === "string" ? result.error : "We could not send your inquiry. Please try again."); inquiryForm.reset(); inquiryForm.hidden = true; success.hidden = false; success.focus(); } catch (submissionError) { error.textContent = submissionError instanceof Error ? submissionError.message : "We could not send your inquiry. Please try again."; error.hidden = false; inquiryForm.setAttribute("aria-describedby", error.id); error.focus(); window.turnstile?.reset(); } finally { if (!inquiryForm.hidden) { button.disabled = false; button.textContent = "Send inquiry"; } } });
 }
</script>
<style>
.sm1-page { overflow-wrap: break-word; }
.sm1-hero { padding: 26px 0 44px; }
.breadcrumb { margin-bottom: 24px; font-size: .875rem; }
.breadcrumb ol { display: flex; flex-wrap: wrap; gap: 8px 16px; list-style: none; margin: 0; padding: 0; }
.breadcrumb li + li::before { content: "/"; margin-right: 16px; color: var(--slate); }
.hero-grid { display: grid; grid-template-columns: minmax(0, 1fr) 300px; column-gap: 68px; align-items: start; }
.hero-title { grid-column: 1; }
.eyebrow { margin-bottom: 10px; color: var(--amber-text); font-weight: 700; font-size: .875rem; letter-spacing: .08em; text-transform: uppercase; }
h1 { font-size: clamp(2.25rem, 3.8vw, 3.35rem); line-height: 1.12; margin-bottom: 14px; }
.hero-heading { font-size: 1.6rem; font-weight: 600; line-height: 1.2; margin-bottom: 20px; }
.hero-artifacts { grid-column: 2; grid-row: 1 / 4; display: grid; gap: 24px; justify-items: center; align-self: center; text-align: center; }
.hero-badge img { display: block; width: 210px; height: auto; margin-inline: auto; }
.hero-cover img { display: block; width: 180px; height: auto; margin-inline: auto; box-shadow: 0 12px 24px rgb(29 36 33 / 12%); }
.hero-badge p, .hero-cover p { margin: 10px 0 0; font-size: .875rem; font-weight: 700; line-height: 1.35; }
.hero-body { grid-column: 1; }
.hero-body p { margin-bottom: 16px; font-size: 1.0625rem; line-height: 1.5; }
.hero-offer { grid-column: 1; }
.offer-line { margin: 6px 0 14px; font-size: 1.125rem; font-weight: 700; }
.enrollment { display: inline-flex; align-items: center; justify-content: center; min-height: 48px; padding: 11px 22px; border: 1px solid var(--slate); background: transparent; color: var(--charcoal); opacity: 1; font-weight: 700; cursor: default; }
.shipping { max-width: 630px; margin: 12px 0 0; font-size: .875rem; line-height: 1.45; }
.shipping-policy { display: inline-block; margin-top: 4px; font-size: .875rem; font-weight: 600; }
a { text-underline-offset: 3px; }
.breadcrumb a, .hero-body a, .shipping-policy { transition: color 160ms ease, text-decoration-thickness 160ms ease; }
.breadcrumb a:hover, .breadcrumb a:focus-visible, .hero-body a:hover, .hero-body a:focus-visible, .shipping-policy:hover, .shipping-policy:focus-visible { color: var(--amber-text); text-decoration-thickness: 2px; }
.primary-cta, .secondary-cta { display: inline-flex; align-items: center; justify-content: center; min-height: 48px; padding: 11px 18px; font: inherit; font-weight: 700; line-height: 1.25; text-align: center; text-decoration: none; cursor: pointer; transition: background-color 160ms ease, border-color 160ms ease, color 160ms ease, box-shadow 160ms ease, transform 160ms ease; }
.primary-cta { border: 2px solid var(--amber); background: var(--amber); color: var(--charcoal); box-shadow: 4px 4px 0 var(--charcoal); }
.secondary-cta { border: 1px solid currentColor; background: transparent; color: var(--charcoal); }
.primary-cta:hover, .primary-cta:focus-visible { border-color: var(--charcoal); background: var(--charcoal); color: var(--paper); box-shadow: 4px 4px 0 var(--amber); transform: translateY(-2px); }
.secondary-cta:hover, .secondary-cta:focus-visible { border-color: var(--charcoal); background: var(--charcoal); color: var(--paper); transform: translateY(-2px); }
.proof-strip { border-block: 1px solid var(--rule); }
.proof-strip ul { display: grid; grid-template-columns: repeat(4, 1fr); list-style: none; padding-block: 21px; padding-left: 0; margin-block: 0; }
.proof-strip li { font-weight: 700; text-align: center; border-right: 1px solid var(--rule); }
.proof-strip li:last-child { border: 0; }
.private-inquiry { padding: 72px 0; scroll-margin-top: 24px; border-bottom: 1px solid var(--rule); background: var(--reading); }
.private-inquiry-grid { display: grid; grid-template-columns: minmax(0, .75fr) minmax(360px, .85fr); gap: clamp(46px, 8vw, 120px); align-items: start; }
.private-inquiry-grid > div:first-child > p:last-child { max-width: 440px; font-size: 1.125rem; line-height: 1.6; }
.private-inquiry-form { padding: clamp(26px, 4vw, 42px); border-top: 4px solid var(--amber); background: var(--paper); box-shadow: 0 12px 30px rgb(29 36 33 / 8%); }
.form-fields { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
.field { display: grid; gap: 7px; }
.field-full { grid-column: 1 / -1; }
.field label { color: var(--charcoal); font-size: .875rem; font-weight: 700; }
.field input, .field textarea { width: 100%; padding: 12px 13px; border: 1px solid #a9ada6; border-radius: 0; background: #fff; color: var(--charcoal); font: inherit; }
.field textarea { resize: vertical; }
.turnstile-wrap { min-height: 65px; margin-top: 24px; }
.form-error { margin: 0 0 18px; color: #9e2a18; font-weight: 600; }
.submit-button { width: 100%; }
.submit-button:disabled { cursor: not-allowed; opacity: .6; transform: none; box-shadow: none; }
.form-success { padding: 32px; border-top: 4px solid var(--amber); background: var(--paper); box-shadow: 0 12px 30px rgb(29 36 33 / 8%); }
.form-success h3 { font-size: 1.5rem; }
.form-success p { margin-bottom: 0; }
.sm1-section { padding: 78px 0; }
h2 { font-size: clamp(1.9rem, 3vw, 2.65rem); }
.split { display: grid; grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr); gap: 80px; }
.section-body p:last-child { margin-bottom: 0; }
.section-body ul { padding-left: 22px; margin-block: 22px; }
.section-body li { margin-bottom: 12px; }
.progression { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); list-style: none; padding: 0; margin: 32px 0; border-top: 3px solid var(--amber); }
.progression li { padding: 22px 20px 10px 0; margin-right: 20px; border-right: 1px solid var(--rule); transition: background-color 160ms ease-out, box-shadow 160ms ease-out; }
.progression li:last-child { border: 0; margin-right: 0; }
.progression li:hover { background: var(--amber-wash); box-shadow: inset 0 3px 0 var(--amber); }
.step-number { display: block; color: var(--amber-text); font-size: .875rem; font-weight: 700; margin-bottom: 18px; }
.progression h3 { font-size: 1.375rem; }
.progression p { line-height: 1.5; }
.credential-band { padding: 70px 0; background: var(--charcoal); color: var(--paper); }
.credential-grid { display: grid; grid-template-columns: 138px minmax(0, 820px); gap: 64px; align-items: center; }
.credential-grid img { width: 138px; height: auto; }
.credential-grid h2 { max-width: 760px; }
.credential-grid p:last-child { margin: 0; }
.curriculum { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 32px; }
.curriculum ol { margin: 12px 0 0; padding: 18px 0 0 24px; border-top: 1px solid var(--slate); }
.curriculum li { margin: 0 0 14px; padding-left: 4px; }
.curriculum li::marker { color: var(--amber-text); font-weight: 600; }
.commercial-split { padding: 70px 0; }
.split-lead { margin: -6px 0 30px; font-size: 1.25rem; font-weight: 600; }
.delivery-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border-top: 3px solid var(--amber); }
.delivery-grid > div { padding: 28px 40px 0 0; }
.delivery-grid > div + div { padding-left: 40px; border-left: 1px solid var(--rule); }
.delivery-grid h3 { font-size: 1.45rem; }
.delivery-grid p { min-height: 72px; }
.domain-guides-band { padding: 60px 0; border-block: 1px solid var(--rule); background: var(--reading); }
.reviews-band { padding: 60px 0; border-bottom: 1px solid var(--rule); }
.reviews-band .section-body p { font-size: 1.125rem; }
.closing-actions { padding: 76px 0; border-top: 5px solid var(--amber); background: var(--charcoal); color: var(--paper); }
.closing-actions h2 { max-width: 600px; margin-bottom: 30px; }
.closing-links { display: flex; flex-wrap: wrap; gap: 16px; }
.closing-actions .enrollment { border-color: var(--slate); color: var(--paper); }
.closing-actions .secondary-cta { color: var(--paper); }
.closing-actions .secondary-cta:hover, .closing-actions .secondary-cta:focus-visible { border-color: var(--paper); background: var(--paper); color: var(--charcoal); }
@media (max-width: 900px) {
 .hero-grid { grid-template-columns: minmax(0, 1fr) 220px; gap: 0 30px; }
 .hero-badge img { width: 180px; }
 .hero-cover img { width: 150px; }
 .split { gap: 36px; }
 .delivery-grid { grid-template-columns: 1fr; }
 .delivery-grid > div { padding: 24px 0; }
 .delivery-grid > div + div { padding-left: 0; border-top: 1px solid var(--rule); border-left: 0; }
 .delivery-grid p { min-height: 0; }
 .private-inquiry-grid { grid-template-columns: 1fr; gap: 36px; }
 .curriculum { grid-template-columns: repeat(2, minmax(0, 1fr)); }
 .progression { grid-template-columns: 1fr; }
 .progression li { margin: 0; padding: 18px 0; border-right: 0; border-bottom: 1px solid var(--rule); }
 .step-number { float: left; margin: 3px 20px 0 0; }
 .progression p { margin-bottom: 0; }
 .credential-grid { gap: 30px; }
}
@media (max-width: 600px) {
 .sm1-hero { padding: 18px 0 28px; }
 .breadcrumb { margin-bottom: 22px; }
 .breadcrumb ol { gap: 5px 8px; }
 .breadcrumb li + li::before { margin-right: 8px; }
 .hero-grid { grid-template-columns: minmax(0, 1fr) 112px; column-gap: 14px; }
 .hero-title { grid-column: 1 / -1; }
 h1 { font-size: 2.1rem; margin-bottom: 12px; }
 .hero-heading { font-size: 1.3rem; margin-bottom: 20px; }
 .hero-artifacts { grid-column: 2; grid-row: 2; gap: 16px; align-self: start; }
 .hero-badge img { width: 112px; }
 .hero-cover img { width: 100px; }
 .hero-badge p, .hero-cover p { font-size: .75rem; }
 .hero-offer { grid-row: 2; }
 .hero-offer .offer-line { margin-top: 0; font-size: 1rem; }
 .hero-offer .enrollment { padding: 10px 8px; }
 .hero-body { grid-column: 1 / -1; grid-row: 3; margin-top: 24px; }
 .enrollment { width: 100%; }
 .proof-strip ul { grid-template-columns: repeat(2, 1fr); gap: 14px 0; }
 .proof-strip li:nth-child(2) { border: 0; }
 .sm1-section { padding: 48px 0; }
 .split, .credential-grid, .curriculum { grid-template-columns: 1fr; gap: 16px; }
 .split h2 { margin-bottom: 8px; }
 .credential-band { padding: 48px 0; }
 .credential-grid img { margin-bottom: 14px; }
 .commercial-split, .domain-guides-band, .reviews-band, .closing-actions { padding: 44px 0; }
 .closing-links { display: grid; }
 .closing-links > * { width: 100%; }
 .form-fields { grid-template-columns: 1fr; }
 .field-full { grid-column: auto; }
}
