---
import SiteLayout from "../layouts/SiteLayout.astro";
import { pageSeo } from "../seo/registry.mjs";

const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? "";
const runSteps = [
	["Workshop", "A workshop in the domain. It extracts how work actually enters, who owns decisions, what Ready and Done mean here, where quality arrives late, and which problems are team problems versus intake or leadership problems. That extraction is the starting backlog. It is not the program."],
	["Office Hours", "Office Hours on the real cadence. People bring a ticket, a board, a dependency, a sprint problem. The object of the work is the classroom."],
	["Role Development", "Role development happens in the same work. Participants develop the judgment needed to work with teams, decisions, ownership, and improvement. Recognized Scrum Master and Recognized Product Owner material may support that development. The domain supplies the problems, the homework, and the evidence."],
	["Guides Stay", "Guides stay. Graduates host Office Hours and teach the next cohort. The practice is recursive."],
];
---

<SiteLayout metadata={pageSeo["/domain-guides"]}>
	<main id="main" class="domain-guides-page">
		<section class="domain-guides-opening section-rule">
			<div class="shell opening-copy">
				<p class="eyebrow">Program</p>
				<h1>Domain Guides</h1>
				<p class="lead">Domain Guides are your people, inside your company. They know the operating environment because they work in it. They learn to recognize where execution has lost grip, make bounded changes, and see whether the work responds. They can grow the next cohort from team members already in the work, so the skill is domain specific and can be renewed from within.</p>
				<p>Many companies rent help that works around the work rather than inside it. Vocabulary arrives. The operating environment does not change. When the outsider leaves, the skill was never there to keep.</p>
			</div>
		</section>

		<section class="section section-rule" aria-labelledby="looking-at-title">
			<div class="shell split-section">
				<h2 id="looking-at-title">What you are looking at</h2>
				<div class="section-body">
					<p>This is not the <a href="/courses">course catalog</a>. The catalog lists credentials and classes.</p>
					<p>This is the program that develops your people who live in the work.</p>
				</div>
			</div>
		</section>

		<section class="section section-rule" aria-labelledby="what-this-is-title">
			<div class="shell split-section">
				<h2 id="what-this-is-title">What this is</h2>
				<div class="section-body">
					<p>A multi-month program, not a class.</p>
					<p>You leave with your own Domain Guides and a repeatable way to develop the next cohort inside your domain. People who know how work actually moves here. People who can tell an execution problem from an intake problem and develop others inside the work.</p>
					<p>By design, 3Back’s role should diminish as that internal capability grows.</p>
					<p>The workshop starts it. It does not finish it.</p>
				</div>
			</div>
		</section>

		<section class="section section-rule" aria-labelledby="class-not-enough-title">
			<div class="shell split-section">
				<h2 id="class-not-enough-title">Why a class is not enough</h2>
				<div class="section-body">
					<p>Classroom Agile taught vocabulary. It did not teach this backlog, this intake, this decision owner, or this quality bar. The domain was decoration. When the coach left, the skill left, and the business was still the one that had to run.</p>
					<p>The work changes when someone owns getting it done. Observation and advice can help. They are not substitutes for ownership.</p>
				</div>
			</div>
		</section>

		<section class="section section-rule how-it-runs-section" aria-labelledby="how-it-runs-title">
			<div class="shell split-section">
				<h2 id="how-it-runs-title">How it runs</h2>
				<div class="run-program">
					<p class="run-introduction">The program begins in the actual work, develops people inside it, and returns capability to it.</p>
					<div class="run-sequence" aria-label="Live work, then Workshop, Office Hours, Role Development, Guides Stay, and live work again.">
						<div class="live-work live-work-start"><span>Live work</span></div>
						<ol class="run-list">
							{runSteps.map(([title, copy], index) => (
								<li tabindex="0">
									<span class="run-number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
									<h3>{title}</h3>
									<p>{copy}</p>
								</li>
							))}
						</ol>
						<div class="live-work live-work-end"><span>Live work</span><small>The next cohort starts here.</small></div>
					</div>
				</div>
			</div>
		</section>

		<section class="section section-rule" aria-labelledby="courses-here-title">
			<div class="shell split-section">
				<h2 id="courses-here-title">What the courses are doing here</h2>
				<div class="section-body">
					<p>RSM and RPO support the program. They are not the program.</p>
					<p>Foundation work uses live backlogs and live decisions, not fictional products. Later levels require the participant to bring work from this domain. If they cannot, they are not in the advanced path yet.</p>
				</div>
			</div>
		</section>

		<section class="section section-rule" aria-labelledby="who-may-teach-title">
			<div class="shell split-section">
				<h2 id="who-may-teach-title">Who may teach or coach in it</h2>
				<div class="section-body">
					<p>People who influence teams through this program must be able to open the board, read the work, and help the team move. Commentary is not a role. External credentials do not waive that.</p>
				</div>
			</div>
		</section>

		<section class="section section-rule" aria-labelledby="who-this-is-for-title">
			<div class="shell split-section">
				<h2 id="who-this-is-for-title">Who this is for</h2>
				<div class="section-body">
					<p>Leaders accountable for whether the business can actually execute.</p>
					<p>Not individuals collecting the next badge.</p>
				</div>
			</div>
		</section>

		<section class="section" aria-labelledby="how-you-know-title">
			<div class="shell split-section">
				<h2 id="how-you-know-title">How you know it is working</h2>
				<div class="section-body">
					<p>Attendance is not evidence. Grip is evidence.</p>
					<p>Signals live in the work: ready rate before planning, sprint interruption, hidden work, decision-ownership disputes, late Done, and whether people can run planning or refinement without an outsider in the room.</p>
					<p>Those are signs that execution is changing. They are not the finish line.</p>
					<p>The work still has to survive the marketplace. Improvement inside the organization is not the finish line unless it improves the organization’s ability to respond to demand and produce results the market values.</p>
				</div>
			</div>
		</section>

		<section class="section section-rule" aria-labelledby="why-3back-title">
			<div class="shell split-section">
				<h2 id="why-3back-title">Why 3Back</h2>
				<div class="section-body">
					<p>3Back has spent nearly three decades working directly with teams and leaders on how difficult work gets done.</p>
					<p>We get close to the actual work, preserve what is already functioning, identify where execution has lost grip, and make bounded changes with the people who have to live with the result.</p>
					<p>Domain Guides grows out of that experience. We bring the experience of developing people who can improve team execution and develop others. Your people bring the domain. Our role should diminish as theirs grows.</p>
				</div>
			</div>
		</section>

		<section class="next-step-section" aria-labelledby="next-step-title">
			<div class="shell next-step-inner">
				<h2 id="next-step-title">Next step</h2>
				<p>This work requires access to the live work and the people responsible for it.</p>
				<p data-form-introduction>Tell us what you are trying to improve and what you are seeing in the work. We’ll review it and follow up to set up a short conversation.</p>
				<form class="domain-guides-form" action="/api/domain-guides" method="post" data-domain-guides-form novalidate>
					<div class="form-fields">
						<div class="field">
							<label for="dg-first-name">First name <span aria-hidden="true">(required)</span></label>
							<input id="dg-first-name" name="first_name" autocomplete="given-name" required maxlength="80" />
						</div>
						<div class="field">
							<label for="dg-last-name">Last name <span aria-hidden="true">(required)</span></label>
							<input id="dg-last-name" name="last_name" autocomplete="family-name" required maxlength="80" />
						</div>
						<div class="field">
							<label for="dg-email">Email <span aria-hidden="true">(required)</span></label>
							<input id="dg-email" name="email" type="email" autocomplete="email" required maxlength="254" />
						</div>
						<div class="field">
							<label for="dg-confirm-email">Email again <span aria-hidden="true">(required, must match)</span></label>
							<input id="dg-confirm-email" name="confirm_email" type="email" autocomplete="email" required maxlength="254" />
						</div>
						<div class="field full-field">
							<label for="dg-organization">Organization <span aria-hidden="true">(required)</span></label>
							<input id="dg-organization" name="organization" autocomplete="organization" required maxlength="160" />
						</div>
						<div class="field full-field">
							<label for="dg-note">What should we know? <span class="optional">(optional)</span></label>
							<textarea id="dg-note" name="note" rows="5" maxlength="4000"></textarea>
						</div>
						<div class="field full-field">
							<label for="dg-phone">Phone <span class="optional">(optional)</span></label>
							<input id="dg-phone" name="phone" type="tel" autocomplete="tel" maxlength="60" />
						</div>
					</div>
					<div class="turnstile-wrap">{turnstileSiteKey ? <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-theme="light"></div> : <p class="form-error">This form is not configured yet.</p>}</div>
					<p class="form-error" role="alert" data-form-error hidden></p>
					<button class="button submit-button" type="submit" disabled={!turnstileSiteKey}>Start a conversation</button>
				</form>
				<div class="form-success" role="status" data-form-success hidden>
					<p>Thank you. Your submission has been received.</p>
					<p>We’ll get back to you shortly. Please look for a confirmation email in your inbox.</p>
				</div>
			</div>
		</section>

		<section class="closing-note">
			<div class="shell reading-column">
				<p>The primary work of 3Back is diagnosing and improving how teams actually execute. This program is one way that work stays in the company, where it belongs.</p>
			</div>
		</section>
	</main>
</SiteLayout>

<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<script>
	declare global { interface Window { turnstile?: { reset(): void } } }
	const form = document.querySelector("[data-domain-guides-form]");
	if (form instanceof HTMLFormElement) {
		const introduction = document.querySelector("[data-form-introduction]");
		const error = form.querySelector("[data-form-error]");
		const success = document.querySelector("[data-form-success]");
		const button = form.querySelector("button[type=submit]");
		const email = form.elements.namedItem("email");
		const confirmation = form.elements.namedItem("confirm_email");
		const validateEmails = () => {
			if (email instanceof HTMLInputElement && confirmation instanceof HTMLInputElement) {
				confirmation.setCustomValidity(email.value === confirmation.value ? "" : "Email addresses must match.");
			}
		};
		if (email instanceof HTMLInputElement) email.addEventListener("input", validateEmails);
		if (confirmation instanceof HTMLInputElement) confirmation.addEventListener("input", validateEmails);
		form.addEventListener("submit", async (event) => {
			event.preventDefault();
			validateEmails();
			if (!(error instanceof HTMLElement) || !(success instanceof HTMLElement) || !(button instanceof HTMLButtonElement)) return;
			error.hidden = true;
			success.hidden = true;
			if (!form.reportValidity()) return;
			button.disabled = true;
			button.textContent = "Sending...";
			try {
				const response = await fetch(form.action, { method: "POST", body: new FormData(form), headers: { Accept: "application/json" } });
				const result = await response.json().catch(() => ({}));
				if (!response.ok) throw new Error(typeof result.error === "string" ? result.error : "We could not send your request. Please try again.");
				form.reset();
				form.hidden = true;
				if (introduction instanceof HTMLElement) introduction.hidden = true;
				success.hidden = false;
				window.turnstile?.reset();
			} catch (submissionError) {
				error.textContent = submissionError instanceof Error ? submissionError.message : "We could not send your request. Please try again.";
				error.hidden = false;
				window.turnstile?.reset();
			} finally {
				button.disabled = false;
				button.textContent = "Start a conversation";
			}
		});
	}
</script>

<style>
	.domain-guides-page { overflow: clip; }
	.domain-guides-opening { padding: 96px 0 72px; }
	.opening-copy { max-width: 830px; }
	.eyebrow { margin-bottom: 16px; color: var(--amber-text); font-size: var(--type-caption); font-weight: var(--font-weight-heavy); letter-spacing: var(--tracking-caption); line-height: var(--leading-caption); text-transform: uppercase; }
	.opening-copy h1 { max-width: 760px; margin-bottom: 28px; }
	.opening-copy p:not(.eyebrow), .section-body p, .run-list p, .next-step-inner > p, .closing-note p { font-size: 1.125rem; line-height: 1.65; }
	.opening-copy .lead { max-width: 760px; margin-bottom: 26px; color: var(--charcoal); font-size: 1.4rem; font-weight: var(--font-weight-semibold); line-height: 1.5; }
	.split-section { display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); gap: clamp(42px, 8vw, 128px); align-items: start; }
	.split-section h2 { margin-bottom: 0; padding-bottom: 18px; border-bottom: 2px solid var(--rule); }
	.how-it-runs-section .split-section { grid-template-columns: 1fr; gap: 28px; }
	.how-it-runs-section .split-section h2 { max-width: 31rem; }
	.section-body a { color: var(--charcoal); font-weight: var(--font-weight-semibold); text-decoration-color: var(--amber); text-decoration-thickness: 2px; text-underline-offset: 4px; }
	.section-body a:hover { color: var(--amber-text); }
	.reading-column { max-width: 760px; }
	.run-program { min-width: 0; }
	.run-introduction { max-width: 66ch; margin-bottom: 28px; color: var(--text-secondary); font-weight: var(--font-weight-semibold); }
	.run-sequence { display: grid; grid-template-columns: minmax(7.25rem, .75fr) minmax(0, 4fr) minmax(7.25rem, .75fr); align-items: stretch; border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); }
	.live-work { display: grid; place-content: center; gap: 8px; padding: 20px 14px; background: var(--paper); color: var(--charcoal); font-size: var(--type-caption); font-weight: var(--font-weight-heavy); letter-spacing: var(--tracking-caption); line-height: var(--leading-caption); text-align: center; text-transform: uppercase; }
	.live-work span { display: block; }
	.live-work small { max-width: 14ch; color: var(--text-secondary); font-size: .78rem; font-weight: var(--font-weight-semibold); letter-spacing: normal; line-height: 1.25; text-transform: none; }
	.live-work-start { border-right: 1px solid var(--rule); }
	.live-work-end { border-left: 1px solid var(--rule); }
	.run-list { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); margin: 0; padding: 0; list-style: none; }
	.run-list li { position: relative; min-width: 0; padding: 20px 16px 22px; border-right: 1px solid var(--rule); background: var(--reading); outline: none; transition: border-color 140ms ease, background-color 140ms ease; }
	.run-list li:last-child { border-right: 0; }
	.run-list li::after, .live-work-start::after { position: absolute; z-index: 1; width: 8px; height: 8px; border-top: 1px solid var(--slate); border-right: 1px solid var(--slate); content: ""; transform: rotate(45deg); }
	.run-list li::after { top: 26px; right: -5px; }
	.live-work-start { position: relative; }
	.live-work-start::after { top: 50%; right: -5px; }
	.run-list li:hover, .run-list li:focus-visible { background: var(--amber-wash); border-color: var(--amber); }
	.run-number { display: block; margin-bottom: 20px; color: var(--amber-text); font-size: var(--type-caption); font-weight: var(--font-weight-heavy); letter-spacing: var(--tracking-caption); line-height: var(--leading-caption); }
	.run-list h3 { margin: 0 0 13px; color: var(--charcoal); font-size: 1.05rem; line-height: 1.2; }
	.run-list p { margin-bottom: 0; color: var(--text-secondary); font-size: 1rem !important; line-height: 1.48 !important; }
	.next-step-section { padding: 118px 0; background: #131917; color: var(--paper); border-top: 4px solid var(--amber); border-bottom: 5px solid var(--amber); }
	.next-step-inner { max-width: 790px; padding-left: clamp(22px, 4vw, 48px); border-left: 3px solid var(--amber); }
	.next-step-inner h2 { color: var(--paper); }
	.next-step-inner > p { max-width: 66ch; color: #e2e0d8; }
	.domain-guides-form { margin-top: 28px; }
	.form-fields { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
	.field { display: grid; gap: 7px; }
	.full-field { grid-column: 1 / -1; }
	.field label { color: var(--paper); font-size: var(--type-caption); font-weight: var(--font-weight-bold); }
	.optional { color: #c8ceca; font-weight: var(--font-weight-regular); }
	.field input, .field textarea { width: 100%; border: 1px solid #c8ceca; border-radius: 0; background: #fff; color: var(--charcoal); padding: 12px 13px; }
	.field textarea { resize: vertical; min-height: 136px; }
	.turnstile-wrap { min-height: 65px; margin-top: 24px; }
	.form-error { margin: 18px 0; color: #f0b8a8; font-weight: var(--font-weight-semibold); }
	.form-success { margin: 20px 0 0; color: #d5e4d8; font-weight: var(--font-weight-regular); }
	.form-success p { margin: 0; }
	.form-success p + p { margin-top: 1em; }
	.submit-button { margin-top: 8px; }
	.submit-button:disabled { cursor: not-allowed; opacity: .6; }
	.closing-note { padding: 34px 0 78px; }
	.closing-note p { margin-bottom: 0; color: var(--text-secondary); }

	@media (max-width: 820px) {
		.domain-guides-opening { padding: 88px 0 58px; }
		.split-section { grid-template-columns: 1fr; gap: 22px; }
		.next-step-section { padding: 82px 0; }
	}
	@media (max-width: 960px) and (min-width: 721px) {
		.run-sequence { grid-template-columns: minmax(5.75rem, .65fr) minmax(0, 4fr) minmax(5.75rem, .65fr); }
		.live-work { padding-right: 8px; padding-left: 8px; }
		.run-list li { padding-right: 12px; padding-left: 12px; }
	}
	@media (max-width: 600px) {
		.form-fields { grid-template-columns: 1fr; }
		.full-field { grid-column: auto; }
	}
	@media (max-width: 720px) {
		.opening-copy p:not(.eyebrow), .section-body p, .run-list p, .next-step-inner > p, .closing-note p { font-size: 1.125rem; }
		.closing-note { padding: 28px 0 58px; }
		.run-introduction { margin-bottom: 22px; }
		.run-sequence { grid-template-columns: 1fr; border: 0; }
		.live-work, .run-list li { text-align: left; }
		.live-work { position: relative; place-content: start; padding: 18px 0; border: 0; background: transparent; }
		.live-work-start { border-top: 1px solid var(--rule); }
		.live-work-end { border-bottom: 1px solid var(--rule); }
		.live-work::after, .run-list li::after { top: auto; right: auto; bottom: -5px; left: 18px; transform: rotate(135deg); }
		.run-list { grid-template-columns: 1fr; }
		.run-list li { padding: 20px 16px 22px; border: 0; border-top: 1px solid var(--rule); }
		.run-list li:last-child { border-bottom: 1px solid var(--rule); }
		.run-number { margin-bottom: 10px; }
		.run-list h3 { margin-bottom: 8px; }
	}
	@media (prefers-reduced-motion: reduce) {
		.run-list li { transition: none; }
		.run-list li:hover, .run-list li:focus-visible { transform: none; }
	}
</style>
