---
import SiteLayout from "../../layouts/SiteLayout.astro"; import { pageSeo } from "../../seo/registry.mjs"; import GripScoreCard from "../../components/GripScoreCard.astro";
---
<SiteLayout metadata={pageSeo["/grip-check/take"]}><main id="main"><section class="shell take"><GripScoreCard mode="progress" /><h1 class="question"></h1><div class="answers"></div><div class="nav"><button class="back" type="button">? Back</button><button class="next" type="button">Next ?</button></div><p class="invalid" hidden>Choose a Grip Check path first.</p></section></main></SiteLayout>
<script>// @ts-nocheck
import { questions } from "../../data/grip-check-questions.js";const view=new URLSearchParams(location.search).get("view"),q=document.querySelector(".question"),a=document.querySelector(".answers"),arc=document.querySelectorAll("[data-grip-card=progress] [data-segment]"),bad=document.querySelector(".invalid"),back=document.querySelector(".back"),next=document.querySelector(".next");let n=0,answers=[];const l=["A","B","C","D","E"];if(!questions[view])bad.hidden=false;else{function r(){const item=questions[view][n];q.textContent=item.question;document.querySelector("[data-center]").textContent=`Question ${n+1} of 20`;arc.forEach((x,i)=>x.style.opacity=i<Math.floor(n/4)?"1":i===Math.floor(n/4)?String(.25+(.75*(n%4)/4)):".15");a.innerHTML=item.options.map((o,i)=>`<button class="${answers[n]===i?"selected":""}" data-i="${i}"><b>${l[i]}.</b><span>${o}</span></button>`).join("");a.querySelectorAll("button").forEach(x=>x.onclick=()=>{answers[n]=+x.dataset.i;r()});back.disabled=n===0;next.textContent=n===19?"Finish ?":"Next ?"}back.onclick=()=>{if(n){n--;r()}};next.onclick=()=>{if(answers[n]===undefined)return;if(n===19){const p=answers.map(x=>Math.max(0,3-x)),d=Array.from({length:5},(_,i)=>Math.round(p.slice(i*4,i*4+4).reduce((u,v)=>u+v,0)/12*100));sessionStorage.setItem("gripCheck",JSON.stringify({view,composite:Math.round(p.reduce((u,v)=>u+v,0)/60*100),dimensionScores:d}));location.href="/grip-check/results"}else{n++;r()}};r()}
</script>
<style>.take{max-width:820px;padding-block:80px}.arc{display:flex;gap:8px;margin-bottom:28px}.arc i{height:18px;flex:1;border-radius:999px;background:var(--charcoal)}.question{user-select:none;font-size:clamp(1.7rem,4vw,2.5rem)}.answers{display:grid;gap:10px;margin-top:28px}.answers button{display:grid;grid-template-columns:32px minmax(0,1fr);justify-items:start;align-items:start;gap:1em;padding:16px;border:1px solid #c5c7c3;background:#eef0ed;color:var(--charcoal);text-align:left;font:inherit;cursor:pointer}.answers button:hover,.answers button:focus-visible{border-color:var(--charcoal);box-shadow:inset 4px 0 var(--amber)}.answers b{color:var(--charcoal)}.answers button{gap:.65em}.answers .selected{border-color:#4f5652;background:#707773;color:#fff;box-shadow:none}.answers .selected b{color:#fff}.nav button{border:1px solid var(--charcoal);background:var(--paper);color:var(--charcoal);font:inherit;font-weight:700}.nav button:hover,.nav button:focus-visible{background:var(--charcoal);color:var(--paper)}.nav button:disabled{opacity:.35;cursor:not-allowed}.nav{display:flex;justify-content:space-between;margin-top:18px}.nav button{padding:10px 22px}</style>
