---
import SiteLayout from "../../layouts/SiteLayout.astro"; import { pageSeo } from "../../seo/registry.mjs";
---
<SiteLayout metadata={pageSeo["/grip-check/take"]}><main id="main"><section class="shell take"><div class="arc" aria-label="Question progress"><i></i><i></i><i></i><i></i><i></i></div><p class="count"></p><h1 class="question"></h1><div class="answers"></div><p class="invalid" hidden>Choose a Grip Check path first.</p></section></main></SiteLayout>
<script>// @ts-nocheck
import { questions } from "../../data/grip-check-questions.js";const view=new URLSearchParams(location.search).get("view"),q=document.querySelector(".question"),a=document.querySelector(".answers"),c=document.querySelector(".count"),arc=document.querySelectorAll(".arc i"),bad=document.querySelector(".invalid");let n=0,p=[];const l=["A","B","C","D","E"];if(!questions[view]){bad.hidden=false}else{function r(){const item=questions[view][n];c.textContent=`Question ${n+1} of 20`;q.textContent=item.question;arc.forEach((x,i)=>x.style.opacity=i<=Math.floor(n/4)?"1":".2");a.innerHTML=item.options.map((o,i)=>`<button data-p="${Math.max(0,3-i)}"><b>${l[i]}</b><span>${o}</span></button>`).join("");a.querySelectorAll("button").forEach(x=>x.onclick=()=>{p.push(+x.dataset.p);if(++n===20){const d=Array.from({length:5},(_,i)=>Math.round(p.slice(i*4,i*4+4).reduce((u,v)=>u+v,0)/12*100));sessionStorage.setItem("gripCheck",JSON.stringify({view,composite:Math.round(p.reduce((u,v)=>u+v,0)/60*100),dimensionScores:d}));location.href="/grip-check/results"}else r()})}r()}</script>
<style>.take{max-width:820px;padding-block:80px}.arc{display:flex;gap:8px;margin-bottom:28px}.arc i{height:18px;flex:1;border-radius:999px;background:var(--charcoal)}.question{user-select:none;font-size:clamp(1.7rem,4vw,2.5rem)}.answers{display:grid;gap:10px;margin-top:28px}.answers button{display:grid;grid-template-columns:32px 1fr;gap:12px;padding:16px;border:1px solid var(--rule);background:transparent;color:var(--charcoal);text-align:left;font:inherit;cursor:pointer}.answers button:hover,.answers button:focus-visible{border-color:var(--charcoal);box-shadow:inset 4px 0 var(--amber)}.answers b{color:var(--amber-text)}</style>
