---
import SiteLayout from "../../layouts/SiteLayout.astro"; import { pageSeo } from "../../seo/registry.mjs"; import GripScoreCard from "../../components/GripScoreCard.astro";
---
<SiteLayout metadata={pageSeo["/grip-check/take"]}><main id="main"><section class="shell take"><GripScoreCard mode="progress" /><p class="framing">About 7 minutes. Complete it in one sitting. If you leave, you start over.</p><h1 class="question"></h1><div class="answers"></div><div class="nav"><button class="back" type="button">&larr; Back</button><button class="next" type="button">Next &rarr;</button></div><p class="invalid" hidden>Choose a Grip Check path first.</p></section></main></SiteLayout>
<script>// @ts-nocheck
import { questions } from "../../data/grip-check-questions.js";
const view=new URLSearchParams(location.search).get("view"),q=document.querySelector(".question"),a=document.querySelector(".answers"),arc=document.querySelectorAll("[data-grip-card=progress] [data-segment]"),bad=document.querySelector(".invalid"),back=document.querySelector(".back"),next=document.querySelector(".next"),attemptKey=`gripCheckAttempt:${view}`;
const shuffle=values=>{const copy=[...values];for(let i=copy.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[copy[i],copy[j]]=[copy[j],copy[i]]}return copy};
if(!questions[view])bad.hidden=false;else{let attempt;try{attempt=JSON.parse(sessionStorage.getItem(attemptKey)||"null")}catch{}if(!attempt||attempt.view!==view||attempt.order?.length!==questions[view].length){attempt={view,order:shuffle(questions[view].map((_,i)=>i)),optionOrders:{}};attempt.order.forEach(index=>attempt.optionOrders[index]=shuffle(questions[view][index].options.map((_,i)=>i)));sessionStorage.setItem(attemptKey,JSON.stringify(attempt))}let n=0,furthest=0,answers=[];const l=["A","B","C","D","E"],arrow=String.fromCharCode(0x2192),finish=()=>{const points=answers.map(optionIndex=>Math.max(0,3-optionIndex)),dimensionTotals=Array.from({length:5},()=>[]),responses=answers.map((optionIndex,displayIndex)=>{const originalIndex=attempt.order[displayIndex],item=questions[view][originalIndex];return{dimensionIndex:Math.floor(originalIndex/4),question:item.question,selectedOption:item.options[optionIndex],optionIndex}});answers.forEach((optionIndex,displayIndex)=>dimensionTotals[Math.floor(attempt.order[displayIndex]/4)].push(Math.max(0,3-optionIndex)));const dimensionScores=dimensionTotals.map(scores=>Math.round(scores.reduce((sum,score)=>sum+score,0)/(scores.length*3)*100));sessionStorage.setItem("gripCheck",JSON.stringify({view,composite:Math.round(points.reduce((sum,score)=>sum+score,0)/(points.length*3)*100),dimensionScores,responses}));sessionStorage.removeItem(attemptKey);location.href="/grip-check/results"};function r(){const questionIndex=attempt.order[n],item=questions[view][questionIndex],optionOrder=attempt.optionOrders[questionIndex];q.textContent=item.question;document.querySelector("[data-center]").textContent=`Question ${n+1} of ${attempt.order.length}`;arc.forEach((x,i)=>x.style.opacity=i<Math.floor(n/4)?"1":i===Math.floor(n/4)?String(.25+(.75*(n%4)/4)):".15");a.innerHTML=optionOrder.map((optionIndex,displayIndex)=>`<button class="${answers[n]===optionIndex?"selected":""}" data-option-index="${optionIndex}"><b>${l[displayIndex]}.</b> <span>${item.options[optionIndex]}</span></button>`).join("");a.querySelectorAll("button").forEach(button=>button.onclick=()=>{answers[n]=+button.dataset.optionIndex;if(n===attempt.order.length-1){finish();return}n++;furthest=Math.max(furthest,n);r()});back.disabled=n===0;next.hidden=!(answers[n]!==undefined&&n<furthest);next.textContent=n===attempt.order.length-1?`Finish ${arrow}`:`Next ${arrow}`}back.onclick=()=>{if(n){n--;r()}};next.onclick=()=>{if(n===attempt.order.length-1)finish();else{n++;r()}};r()}
</script>
<style>.take{max-width:820px;padding-block:56px}:global([data-grip-card="progress"]){padding:20px clamp(18px,2.4vw,30px)}:global([data-grip-card="progress"] .score-profile){width:70%;margin:0 auto -16%;transform:translateY(-20px)}.framing{margin:18px 0 0;font-weight:700}.question{margin-top:28px;user-select:none;font-size:clamp(1.7rem,4vw,2.5rem)}.answers{display:grid;gap:10px;margin-top:28px}:global(.answers button){display:grid;grid-template-columns:32px minmax(0,1fr);justify-items:start;align-items:start;gap:.75em;padding:16px;border:1px solid #c5c7c3;background:#eef0ed;color:var(--charcoal);text-align:left;font:inherit;cursor:pointer}:global(.answers button:hover),:global(.answers button:focus-visible){border-color:var(--charcoal);box-shadow:inset 4px 0 var(--amber)}:global(.answers button b){color:var(--charcoal)}:global(.answers button.selected){border-color:#4f5652;background:#707773;color:#fff;box-shadow:none}:global(.answers button.selected b){color:#fff}:global(.nav button){border:1px solid var(--charcoal);background:var(--paper);color:var(--charcoal);font:inherit;font-weight:700}:global(.nav button:hover),:global(.nav button:focus-visible){background:var(--charcoal);color:var(--paper)}:global(.nav button:disabled){opacity:.35;cursor:not-allowed}.nav{display:flex;justify-content:space-between;margin-top:18px}:global(.nav button){padding:10px 22px}</style>
