---
import SiteLayout from "../../layouts/SiteLayout.astro"; import GripScoreCard from "../../components/GripScoreCard.astro";
import { pageSeo } from "../../seo/registry.mjs";
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? "";
---
<SiteLayout metadata={pageSeo["/grip-check/results"]}><main id="main"><section class="shell results"><div data-result hidden><GripScoreCard mode="results" /><p>Your results provide a directional snapshot based on your responses. They highlight where grip may be present and where it may be under strain. They represent a screening, not a diagnostic determination. For help interpreting these results, fill out the form below to schedule a 30-minute review.</p><form action="/api/grip-check" method="post" novalidate><input type="hidden" name="score_payload" data-payload><div class="fields"><label>First name<input name="first_name" required></label><label>Last name<input name="last_name" required></label><label>Email<input name="email" type="email" required></label><label>Confirm email<input name="confirm_email" type="email" required></label><label>Position / role<input name="position" required></label><label>Organization name<input name="organization_name" required></label><label>Organization size<select name="organization_size" required><option value="">Select</option><option>1–50</option><option>50–250</option><option>250–600</option><option>600–3000</option><option>3000+</option></select></label><label class="full">Anything that would help us understand the situation<textarea name="context" placeholder="Anything that would help us understand the situation" required></textarea></label></div><div class="check" role="group" aria-label="Results follow-up preference"><label><input type="radio" name="review_requested" value="yes" required> Schedule a 30-minute interpretation and debrief</label><label><input type="radio" name="review_requested" value="no"> Just send my results</label></div>{turnstileSiteKey && <div class="cf-turnstile" data-sitekey={turnstileSiteKey}></div>}<p class="error" role="alert" hidden></p><button class="button" type="submit" disabled={!turnstileSiteKey}>Send My Results</button><p class="success" role="status" hidden>Thank you. Your score will be emailed from gripcheck@3back.com. If you requested an interpretation and debrief, we will note your request and contact you to schedule it.</p></form></div><p data-missing hidden>Your completed Grip Check result is not available. Please return to <a href="/grip-check">Grip Check</a>.</p></section></main></SiteLayout>
{turnstileSiteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
<script>// @ts-nocheck
import { dimensions } from "../../data/grip-check-questions.js";
const data=JSON.parse(sessionStorage.getItem("gripCheck")||"null"),result=document.querySelector("[data-result]"),missing=document.querySelector("[data-missing]");
if(!data) missing.hidden=false; else { result.hidden=false; const card=document.querySelector("[data-grip-card=results]");card.querySelector("[data-center]").textContent=data.composite;const state=score=>score>=80?["STRONG","#172627"]:score>=50?["MODERATE","#9a4328"]:["WEAK","#d96b18"];card.querySelectorAll("[data-percent]").forEach((el,i)=>{const [label,color]=state(data.dimensionScores[i]),bucket=el.closest("[data-section]");el.hidden=false;el.textContent=`${data.dimensionScores[i]}%`;bucket.style.color=color;const strength=card.querySelector(`[data-strength="${i}"]`);strength.hidden=false;strength.textContent=label});card.querySelectorAll("[data-segment]").forEach((el,i)=>el.style.stroke=state(data.dimensionScores[i])[1]);const buckets=[...card.querySelectorAll("[data-section]")],segments=[...card.querySelectorAll("[data-segment]")],setActive=index=>{buckets.forEach((bucket,i)=>bucket.classList.toggle("is-active",i===index));segments.forEach((segment,i)=>segment.classList.toggle("is-active",i===index))};buckets.forEach((bucket,i)=>{bucket.addEventListener("pointerenter",event=>{if(event.pointerType!=="touch")setActive(i)});bucket.addEventListener("pointerleave",event=>{if(event.pointerType!=="touch")setActive(null)});bucket.addEventListener("focus",()=>setActive(i));bucket.addEventListener("blur",()=>setActive(null))}); document.querySelector("[data-payload]").value=JSON.stringify(data);  const f=result.querySelector("form"),e=f.querySelector(".error"),s=f.querySelector(".success"); f.addEventListener("submit",async x=>{x.preventDefault();const a=f.email,b=f.confirm_email;b.setCustomValidity(a.value===b.value?"":"Email addresses must match.");if(!f.reportValidity())return;try{const r=await fetch(f.action,{method:"POST",body:new FormData(f),headers:{Accept:"application/json"}}),j=await r.json();if(!r.ok)throw Error(j.error);if (typeof zaraz !== "undefined" && typeof zaraz.track === "function") {
	zaraz.track("grip_check_results_submitted");
} f.hidden=true;s.hidden=false}catch(err){e.textContent=err.message;e.hidden=false}}); }
</script>
<style>.results{max-width:800px;padding-block:100px}.eyebrow{color:var(--amber-text);font-weight:700;text-transform:uppercase}.score{font-size:5rem;font-weight:800}.score small{display:block;font-size:1rem}.results [data-dimensions]{display:grid;grid-template-columns:1fr 1fr;gap:10px}.results [data-dimensions] p{display:flex;justify-content:space-between;border-bottom:1px solid var(--rule)}.results [data-result]>p{margin:16px 0 0}form{margin-top:32px;padding:28px;border-radius:16px;background:var(--reading)}.fields{display:grid;grid-template-columns:1fr 1fr;gap:16px}.fields label{display:grid;gap:6px}.full{grid-column:1/-1}input,select,textarea{padding:10px;border:1px solid var(--rule);font:inherit}.check{display:grid;gap:10px;margin:20px 0}.check label{display:flex;gap:8px;align-items:center}.check input{padding:0}.error{color:#9e2a18}.success{color:#315d42}@media(max-width:600px){.results{padding-block:70px}.fields,.results [data-dimensions]{grid-template-columns:1fr}.score{font-size:4rem}}</style>
