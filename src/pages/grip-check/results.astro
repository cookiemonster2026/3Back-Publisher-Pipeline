---
import SiteLayout from "../../layouts/SiteLayout.astro";
import { pageSeo } from "../../seo/registry.mjs";
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? "";
---
<SiteLayout metadata={pageSeo["/grip-check/results"]}><main id="main"><section class="shell results"><div data-result hidden><p class="eyebrow">Directional result</p><h1>Here’s your Grip Score.</h1><p class="score"><span data-composite></span><small>Composite Grip Score</small></p><div data-dimensions></div><p><strong data-strongest></strong></p><p><strong data-strain></strong></p><p data-observation></p><p>Your results provide a directional snapshot based on your responses. They highlight where grip may be present and where it may be under strain. They are not a diagnostic determination.</p><form action="/api/grip-check" method="post" novalidate><input type="hidden" name="score_payload" data-payload><div class="fields"><label>First name<input name="first_name" required></label><label>Last name<input name="last_name" required></label><label>Email<input name="email" type="email" required></label><label>Enter email again<input name="confirm_email" type="email" required></label><label>Role<select name="role" required><option value="">Select</option><option>Developer on a team</option><option>Manager</option><option>Leader</option><option>Senior leader</option><option>Executive leader</option></select></label><label>Organization size<select name="organization_size" required><option value="">Select</option><option>1–50</option><option>50–250</option><option>250–600</option><option>600–3000</option><option>3000+</option></select></label><label class="full">Description / context<textarea name="context" placeholder="Background about your problem or space"></textarea></label></div><label class="check"><input type="checkbox" name="review_requested"> Reach out to me. I want to schedule a 30-minute review.</label>{turnstileSiteKey && <div class="cf-turnstile" data-sitekey={turnstileSiteKey}></div>}<p class="error" role="alert" hidden></p><button class="button" type="submit" disabled={!turnstileSiteKey}>Send My Results</button><p class="success" role="status" hidden>Thank you. You will receive an email with your score from gripcheck@3back.com. If you requested the review, you will be contacted to schedule.</p></form></div><p data-missing hidden>Your completed Grip Check result is not available. Please return to <a href="/grip-check">Grip Check</a>.</p></section></main></SiteLayout>
{turnstileSiteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
<script>// @ts-nocheck
import { dimensions } from "../../data/grip-check-questions.js";
const data=JSON.parse(sessionStorage.getItem("gripCheck")||"null"),result=document.querySelector("[data-result]"),missing=document.querySelector("[data-missing]");
if(!data) missing.hidden=false; else { result.hidden=false; document.querySelector("[data-composite]").textContent=data.composite; document.querySelector("[data-payload]").value=JSON.stringify(data); const high=Math.max(...data.dimensionScores),low=Math.min(...data.dimensionScores); document.querySelector("[data-dimensions]").innerHTML=dimensions.map((d,i)=>`<p>${d}<strong>${data.dimensionScores[i]}</strong></p>`).join(""); document.querySelector("[data-strongest]").textContent=`Strongest apparent condition: ${dimensions[data.dimensionScores.indexOf(high)]}.`; document.querySelector("[data-strain]").textContent=`Condition under the greatest apparent strain: ${dimensions[data.dimensionScores.indexOf(low)]}.`; document.querySelector("[data-observation]").textContent="The pattern is directional: use the dimension scores to identify conditions worth examining with context and evidence."; const f=result.querySelector("form"),e=f.querySelector(".error"),s=f.querySelector(".success"); f.addEventListener("submit",async x=>{x.preventDefault();const a=f.email,b=f.confirm_email;b.setCustomValidity(a.value===b.value?"":"Email addresses must match.");if(!f.reportValidity())return;try{const r=await fetch(f.action,{method:"POST",body:new FormData(f),headers:{Accept:"application/json"}}),j=await r.json();if(!r.ok)throw Error(j.error);f.hidden=true;s.hidden=false}catch(err){e.textContent=err.message;e.hidden=false}}); }
</script>
<style>.results{max-width:800px;padding-block:100px}.eyebrow{color:var(--amber-text);font-weight:700;text-transform:uppercase}.score{font-size:5rem;font-weight:800}.score small{display:block;font-size:1rem}.results [data-dimensions]{display:grid;grid-template-columns:1fr 1fr;gap:10px}.results [data-dimensions] p{display:flex;justify-content:space-between;border-bottom:1px solid var(--rule)}form{margin-top:48px;padding:28px;background:var(--reading)}.fields{display:grid;grid-template-columns:1fr 1fr;gap:16px}.fields label{display:grid;gap:6px}.full{grid-column:1/-1}input,select,textarea{padding:10px;border:1px solid var(--rule);font:inherit}.check{display:block;margin:20px 0}.error{color:#9e2a18}.success{color:#315d42}@media(max-width:600px){.results{padding-block:70px}.fields,.results [data-dimensions]{grid-template-columns:1fr}.score{font-size:4rem}}</style>
