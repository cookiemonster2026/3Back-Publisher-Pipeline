---
import SiteLayout from "../layouts/SiteLayout.astro"; import { pageSeo } from "../seo/registry.mjs";
---
<SiteLayout metadata={pageSeo["/grip-check"]}><main id="main"><section class="shell landing"><p>Directional Screening</p><h1>Grip Check</h1><p>7-Minute Directional Screening · 20 questions · Immediate score</p><article class="score-card"><div class="score-profile"><svg class="score-ring" viewBox="0 0 520 300" aria-hidden="true"><g transform="translate(260 250)"><path class="score-segment score-segment-moderate" d="M -210 0 A 210 210 0 0 1 -170 -123"/><path class="score-segment score-segment-moderate" d="M -158 -139 A 210 210 0 0 1 -65 -200"/><path class="score-segment score-segment-moderate" d="M -48 -204 A 210 210 0 0 1 48 -204"/><path class="score-segment score-segment-moderate" d="M 65 -200 A 210 210 0 0 1 158 -139"/><path class="score-segment score-segment-moderate" d="M 170 -123 A 210 210 0 0 1 210 0"/></g></svg><p class="overall-score">Start<br />Grip Check</p><img class="hands-bar" src="/assets/operational-grip/hands-bar.png" alt="One hand holds a bar securely while another begins to lose its grip." /></div><div class="score-results"><span class="score-result"><img src="/assets/operational-grip/icons/demand.svg" alt=""/><span>Response to Changing Demand</span></span><span class="score-result"><img src="/assets/operational-grip/icons/ownership.svg" alt=""/><span>Ownership and Bounded Execution</span></span><span class="score-result"><img src="/assets/operational-grip/icons/results.svg" alt=""/><span>Observable and Traceable Results</span></span><span class="score-result"><img src="/assets/operational-grip/icons/adaptation.svg" alt=""/><span>Adaptation Without Loss of Control</span></span><span class="score-result"><img src="/assets/operational-grip/icons/ai.svg" alt=""/><span>AI Use and Control</span></span></div></article><p class="pick">Pick one</p><div class="choices"><a href="/grip-check/take?view=organization"><strong>My Organization</strong><span>Answer from where you sit, using the most recent comparable organizational situation you can observe.</span></a><a href="/grip-check/take?view=work"><strong>My Work</strong><span>Answer from your experience of the work, authority, decisions, coordination, effects, and AI use directly around you.</span></a></div></section></main></SiteLayout>
<style>.landing{max-width:900px;padding-block:90px;text-align:center}.score-card{padding:32px;background:var(--reading)}.score-profile{position:relative;max-width:620px;margin:auto;overflow:hidden}.score-ring{position:absolute;inset:0;width:100%}.score-segment{fill:none;stroke-width:18}.score-segment-moderate{stroke:#9a4328}.overall-score{position:absolute;top:37%;left:50%;z-index:1;margin:0;font-size:2rem;font-weight:800;line-height:1.05;transform:translateX(-50%)}.hands-bar{display:block;width:100%;margin-top:-12%}.score-results{display:grid;grid-template-columns:repeat(5,1fr);border-top:4px solid var(--charcoal)}.score-result{display:grid;gap:8px;padding:14px 8px;border-right:1px solid var(--rule);font-size:.8rem;font-weight:700;text-align:center}.score-result img{width:28px;margin:auto}.pick{margin:30px 0 10px;font-weight:800}.choices{display:grid;grid-template-columns:1fr 1fr;gap:16px;text-align:left}.choices a{display:block;padding:16px 20px;border:2px solid var(--charcoal);background:var(--charcoal);color:var(--paper);text-decoration:none;transition:.15s}.choices a:hover,.choices a:focus-visible{background:var(--amber);border-color:var(--amber);color:var(--charcoal)}.choices strong,.choices span{display:block}.choices span{margin-top:6px;line-height:1.4}@media(max-width:640px){.landing{padding-block:64px}.choices,.score-results{grid-template-columns:1fr}}</style>
