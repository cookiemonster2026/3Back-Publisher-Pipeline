---
import SiteLayout from "../layouts/SiteLayout.astro"; import { pageSeo } from "../seo/registry.mjs"; import GripScoreCard from "../components/GripScoreCard.astro";
const faqs=[
	["What is Grip Check?","Grip Check is a short directional screening of how execution holds under changing demand. It takes about 7 minutes and covers five dimensions of operational grip."],
	["What do I get when I finish?","You get a composite score and scores for each dimension, with a simple strong / moderate / weak reading. That is a starting snapshot, not a diagnosis. You can also request a 30-minute interpretation and debrief."],
	["Is this a diagnosis?","No. Grip Check is a screening. It points to where grip may be present and where it may be under strain. It does not prescribe a program or guarantee an outcome."],
	["Should I take it for my organization or for my work?","Choose My Organization if you will answer from a comparable organizational situation you can observe. Choose My Work if you will answer from your own experience of the work, authority, decisions, coordination, effects, and AI use around you. The questions differ for each path. You can take both."],
	["What happens if I ask for the 30-minute review?","After you submit your results, 3Back receives your scores and context. We use that to prepare a short conversation focused on interpretation, not a pitch. If you only want the scores emailed, choose that option instead."],
];
---
<SiteLayout metadata={pageSeo["/grip-check"]}><main id="main"><section class="shell landing"><p class="eyebrow">Directional Screening</p><h1>Grip Check</h1><p class="pick">Pick one</p><div class="choices"><a href="/grip-check/take?view=organization"><strong>A. My Organization</strong><span>Answer from where you sit, using the most recent comparable organizational situation you can observe.</span></a><a href="/grip-check/take?view=work"><strong>B. My Work</strong><span>Answer from your experience of the work, authority, decisions, coordination, effects, and AI use directly around you.</span></a></div><GripScoreCard mode="landing" /><section class="faq" aria-labelledby="faq-heading"><h2 id="faq-heading">FAQ</h2>{faqs.map(([question,answer])=><details><summary>{question}</summary><p>{answer}</p></details>)}</section></section></main></SiteLayout>
<style>.landing{max-width:900px;padding-block:90px;text-align:center}.eyebrow{margin:0;color:var(--amber-text);font-weight:700;letter-spacing:var(--tracking-caption);text-transform:uppercase}.score-card{margin-top:32px;padding:32px;background:var(--reading)}.score-profile{position:relative;max-width:620px;margin:auto;overflow:hidden}.score-ring{position:absolute;inset:0;width:100%}.score-segment{fill:none;stroke-width:18}.score-segment-moderate{stroke:#9a4328}.overall-score{position:absolute;top:37%;left:50%;z-index:1;margin:0;font-size:2rem;font-weight:800;line-height:1.05;transform:translateX(-50%)}.hands-bar{display:block;width:100%;margin-top:-12%}.score-results{display:grid;grid-template-columns:repeat(5,1fr);border-top:4px solid var(--charcoal)}.score-result{display:grid;gap:8px;padding:14px 8px;border-right:1px solid var(--rule);font-size:.8rem;font-weight:700;text-align:center}.score-result img{width:28px;margin:auto}.pick{margin:22px 0 10px;font-size:clamp(1.35rem,3vw,2rem);font-weight:800}.choices{display:grid;grid-template-columns:1fr 1fr;gap:16px;text-align:left}.choices a{display:block;padding:16px 20px;border:2px solid var(--charcoal);background:var(--charcoal);color:var(--paper);text-decoration:none;box-shadow:0 0 0 transparent;transition:background-color .15s,border-color .15s,color .15s,box-shadow .15s,transform .15s}.choices a:hover,.choices a:focus-visible{background:var(--amber);border-color:var(--amber);color:var(--charcoal);box-shadow:0 8px 18px rgba(29,36,33,.15);transform:translateY(-2px)}.choices strong,.choices span{display:block}.choices span{margin-top:6px;line-height:1.4}.faq{margin-top:56px;padding-top:48px;border-top:1px solid var(--rule);text-align:left}.faq h2{margin-bottom:24px}.faq details{border-bottom:1px solid var(--rule)}.faq summary{padding:18px 30px 18px 0;color:var(--charcoal);font-size:var(--type-lead);font-weight:var(--font-weight-bold);line-height:var(--leading-lead);cursor:pointer}.faq p{max-width:720px;margin:0 0 20px;color:var(--text-secondary);line-height:var(--leading-body)}@media(max-width:640px){.landing{padding-block:64px}.choices,.score-results{grid-template-columns:1fr}.faq{margin-top:42px;padding-top:38px}}</style>
<script>document.querySelectorAll<HTMLAnchorElement>('.choices a[href*="/grip-check/take"]').forEach(link=>link.addEventListener("click",()=>{const view=new URL(link.href).searchParams.get("view");sessionStorage.removeItem(`gripCheckAttempt:${view}`)}))</script>
