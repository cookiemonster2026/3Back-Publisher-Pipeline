---
import SiteLayout from "../layouts/SiteLayout.astro"; import { pageSeo } from "../seo/registry.mjs"; import GripScoreCard from "../components/GripScoreCard.astro";
---
<SiteLayout metadata={pageSeo["/grip-check"]}><main id="main"><section class="shell landing"><p class="eyebrow">Directional Screening</p><h1>Grip Check</h1><p class="pick">Pick one</p><div class="choices"><a href="/grip-check/take?view=organization"><strong>My Organization</strong><span>Answer from where you sit, using the most recent comparable organizational situation you can observe.</span></a><a href="/grip-check/take?view=work"><strong>My Work</strong><span>Answer from your experience of the work, authority, decisions, coordination, effects, and AI use directly around you.</span></a></div><GripScoreCard mode="landing" /></section></main></SiteLayout>
<style>.landing{max-width:900px;padding-block:90px;text-align:center}.eyebrow{margin:0;color:var(--amber-text);font-weight:700;letter-spacing:var(--tracking-caption);text-transform:uppercase}.score-card{margin-top:32px;padding:32px;background:var(--reading)}.score-profile{position:relative;max-width:620px;margin:auto;overflow:hidden}.score-ring{position:absolute;inset:0;width:100%}.score-segment{fill:none;stroke-width:18}.score-segment-moderate{stroke:#9a4328}.overall-score{position:absolute;top:37%;left:50%;z-index:1;margin:0;font-size:2rem;font-weight:800;line-height:1.05;transform:translateX(-50%)}.hands-bar{display:block;width:100%;margin-top:-12%}.score-results{display:grid;grid-template-columns:repeat(5,1fr);border-top:4px solid var(--charcoal)}.score-result{display:grid;gap:8px;padding:14px 8px;border-right:1px solid var(--rule);font-size:.8rem;font-weight:700;text-align:center}.score-result img{width:28px;margin:auto}.pick{margin:22px 0 10px;font-size:clamp(1.35rem,3vw,2rem);font-weight:800}.choices{display:grid;grid-template-columns:1fr 1fr;gap:16px;text-align:left}.choices a{display:block;padding:16px 20px;border:2px solid var(--charcoal);background:var(--charcoal);color:var(--paper);text-decoration:none;transition:.15s}.choices a:hover,.choices a:focus-visible{background:var(--amber);border-color:var(--amber);color:var(--charcoal)}.choices strong,.choices span{display:block}.choices span{margin-top:6px;line-height:1.4}@media(max-width:640px){.landing{padding-block:64px}.choices,.score-results{grid-template-columns:1fr}}</style>
<script>document.querySelectorAll<HTMLAnchorElement>('.choices a[href*="/grip-check/take"]').forEach(link=>link.addEventListener("click",()=>{const view=new URL(link.href).searchParams.get("view");sessionStorage.removeItem(`gripCheckAttempt:${view}`)}))</script>
