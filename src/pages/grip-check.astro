---
import SiteLayout from "../layouts/SiteLayout.astro"; import { pageSeo } from "../seo/registry.mjs"; import GripScoreCard from "../components/GripScoreCard.astro";
const faqs=[
	["What is Grip Check?","Grip Check is a short directional screening of how execution holds under changing demand. It takes about 7 minutes and covers five dimensions of operational grip."],
	["What do I get when I finish?","You get a composite score and scores for each dimension, with a simple strong / moderate / weak reading. That is a starting snapshot, not a diagnosis. You can also request a 30-minute interpretation and debrief."],
	["Is this a diagnosis?","No. Grip Check is a screening. It points to where grip may be present and where it may be under strain. It does not prescribe a program or guarantee an outcome."],
	["How should I answer?","Answer from the organization you can observe. Not the official story. Not a team you do not work in."],
	["What happens if I ask for the 30-minute review?","After you submit your results, 3Back receives your scores and context. We use that to prepare a short conversation focused on interpretation, not a pitch. If you only want the scores emailed, choose that option instead."],
];
---
<SiteLayout metadata={pageSeo["/grip-check"]}><main id="main"><section class="shell landing"><p class="eyebrow">Directional Screening</p><h1>Grip Check</h1><p class="lead">Twenty questions. About 7 minutes. A snapshot of how execution holds under changing demand.</p><a class="button start" href="/grip-check/take">Take the Grip Check</a><p class="support">Answer from the organization you can observe.</p><GripScoreCard mode="landing" /><section class="faq" aria-labelledby="faq-heading"><h2 id="faq-heading">FAQ</h2>{faqs.map(([question,answer])=><details><summary>{question}</summary><p>{answer}</p></details>)}</section></section></main></SiteLayout>
<style>
.landing{max-width:900px;padding-block:72px;text-align:center}
.eyebrow{margin:0;color:var(--amber-text);font-weight:700;letter-spacing:var(--tracking-caption);text-transform:uppercase}
.lead{max-width:620px;margin:20px auto 24px;font-size:var(--type-lead);line-height:var(--leading-lead)}
.support{margin:12px 0 0;color:var(--text-secondary)}
.landing :global([data-grip-card="landing"]){max-width:680px;margin:32px auto 0;padding:20px}
.landing :global([data-grip-card="landing"] .score-profile){max-width:380px;margin:auto}
.landing :global([data-grip-card="landing"] .score-result){min-height:0;padding-inline:8px}
.faq{margin-top:56px;padding-top:48px;border-top:1px solid var(--rule);text-align:left}.faq h2{margin-bottom:24px}.faq details{border-bottom:1px solid var(--rule)}.faq summary{padding:18px 30px 18px 0;color:var(--charcoal);font-size:var(--type-lead);font-weight:var(--font-weight-bold);line-height:var(--leading-lead);cursor:pointer}.faq p{max-width:720px;margin:0 0 20px;color:var(--text-secondary);line-height:var(--leading-body)}
@media(max-width:640px){.landing{padding-block:48px}.landing :global([data-grip-card="landing"]){padding:16px}.landing :global([data-grip-card="landing"] .score-result){display:grid;grid-template-columns:32px 1fr;gap:12px;padding:10px 0;text-align:left;border-right:0}.landing :global([data-grip-card="landing"] .score-icon){width:28px;height:28px;margin:0}.landing :global([data-grip-card="landing"] .result-label){min-height:0}.faq{margin-top:42px;padding-top:38px}}
</style>
<script>document.querySelector(".start")?.addEventListener("click",()=>{sessionStorage.removeItem("gripCheckAttempt:organization:v1")})</script>
