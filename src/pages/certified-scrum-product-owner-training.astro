---
import SiteLayout from "../layouts/SiteLayout.astro";
import StarsMark from "../assets/certified-scrummaster/csm-five-stars.svg";
import LaurelMark from "../assets/certified-scrummaster/csm-award-laurel.svg";
import { pageSeo } from "../seo/registry.mjs";
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? "";
const roles = ["Product managers", "Leaders", "Analysts", "Designers", "Engineers", "Stakeholders"];
---
<SiteLayout metadata={pageSeo["/certified-scrum-product-owner-training"]}>
<main id="main" class="cspo-page">
<section class="cspo-hero"><div class="shell hero-grid"><div class="hero-copy"><p class="eyebrow">Scrum Alliance® credential</p><h1>Certified Scrum Product Owner® Training</h1><p class="framing-line">The official Certified Scrum Product Owner® course, delivered by trainers who have been part of the Scrum Alliance story since the founding era.</p><p class="hero-action"><button class="primary-cta" type="button" data-private-request-trigger aria-expanded="false" aria-controls="private-course-request">Request an on-site (or private virtual) course</button><a class="secondary-cta" href="/events">Find an upcoming public course</a></p></div><div class="hero-visual" aria-label="Product Owner focus: value, backlog, and priority"><div class="priority-board" aria-hidden="true"><span class="board-label">Value and priority</span><span class="priority-line priority-line-one"></span><span class="priority-line priority-line-two"></span><span class="priority-line priority-line-three"></span><span class="priority-marker marker-one">01</span><span class="priority-marker marker-two">02</span><span class="priority-marker marker-three">03</span></div><aside class="credential-panel" aria-label="Certified Scrum Product Owner credential"><img src="/assets/courses/sa-cspo.png" alt="Scrum Alliance Certified Scrum Product Owner certification badge" width="150" height="150" /><p>Official CSPO® credential</p></aside></div></div></section>
<section id="private-course-request" class="private-request" aria-labelledby="private-request-title" hidden><div class="shell private-request-grid"><div><p class="eyebrow">Private course request</p><h2 id="private-request-title">Tell us about your team.</h2><p>We will follow up by email to discuss a private onsite or virtual CSPO course.</p></div><form class="private-request-form" action="/api/cspo-private-request" method="post" data-private-request-form novalidate><div class="form-fields"><div class="field"><label for="cspo-first-name">First name</label><input id="cspo-first-name" name="first_name" autocomplete="given-name" required /></div><div class="field"><label for="cspo-last-name">Last name</label><input id="cspo-last-name" name="last_name" autocomplete="family-name" required /></div><div class="field"><label for="cspo-email">Email</label><input id="cspo-email" name="email" type="email" autocomplete="email" required /></div><div class="field"><label for="cspo-confirm-email">Email again</label><input id="cspo-confirm-email" name="confirm_email" type="email" autocomplete="email" required /></div><div class="field field-full"><label for="cspo-company">Company name</label><input id="cspo-company" name="company_name" autocomplete="organization" required /></div><div class="field field-full"><label for="cspo-note">Note</label><textarea id="cspo-note" name="note" rows="5" required></textarea></div></div><div class="turnstile-wrap">{turnstileSiteKey ? <div class="cf-turnstile" data-sitekey={turnstileSiteKey}></div> : <p class="form-error">This form is not configured yet.</p>}</div><p class="form-error" role="alert" data-form-error hidden></p><button class="primary-cta submit-button" type="submit" disabled={!turnstileSiteKey}>Send request</button><p class="form-success" role="status" data-form-success hidden>Thank you. We received your request and will reply by email.</p></form></div></section>
<section class="section what-is-section section-rule"><div class="shell content-grid"><div><p class="eyebrow">The foundation</p><h2>What the CSPO is</h2></div><div class="body-copy"><p class="definition-copy">The Certified Scrum Product Owner® (CSPO®) is the foundational Product Owner credential from Scrum Alliance®. It covers the Product Owner accountability in Scrum: clarifying value, ordering the backlog, and working with the team so the next increment is the right one.</p><ul class="definition-facts" aria-label="CSPO course facts"><li><strong>16 hours</strong><span>Live instruction</span></li><li><strong>None</strong><span>Formal prerequisites</span></li><li><strong>No exam</strong><span>Certification on successful course completion</span></li></ul><p class="definition-support">The course is taught by a Certified Scrum Trainer®. Upon successful completion you receive the CSPO® certification and a two-year Scrum Alliance® membership.</p></div></div></section>
<section class="why-section"><div class="shell"><div class="social-proof" aria-label="4.8 rating based on thousands of student reviews. Award-winning training. 25,000 plus students trained."><div class="rating-proof"><StarsMark aria-hidden="true" /><strong>4.8</strong><span>Based on thousands of student reviews</span></div><div class="award-proof"><LaurelMark aria-hidden="true" /><span>Award-winning training</span><span aria-hidden="true">·</span><span>25,000+ students trained</span></div></div><div class="why-grid"><div><p class="eyebrow eyebrow-light">Why take it with 3Back</p><h2>We have delivered this work continuously from the founding era of the Scrum Alliance® to the present.</h2></div><div class="why-copy"><p>More than 25,000 students have trained with us. We know what it takes for the credential to stick in real organizations, not just on a résumé.</p><p>Our classes emphasize judgment and applied practice. You leave able to own product outcomes with a team, not only recite the framework.</p></div></div></div></section>
<section class="section inclusions-section section-rule"><div class="shell content-grid inclusions-grid"><div class="inclusions-intro"><p class="eyebrow">Built for the full journey</p><h2>What you get with 3Back</h2><ol class="outcomes-list"><li><span>01</span><strong>Live CSPO instruction</strong></li><li><span>02</span><strong>Study and practice support</strong></li><li><span>03</span><strong>Certification and membership included</strong></li></ol></div><div class="inclusions-card"><p class="card-label">Included with your course</p><p class="inclusions-lead">Everything you need for the credential to stick, not just a seat in class.</p><ul class="inclusions-list"><li>Official 16-hour CSPO® course taught by a Certified Scrum Trainer®</li><li>Course materials written for this class</li><li>Access to our LMS for course materials</li><li>Two-year Scrum Alliance® membership upon successful completion</li><li>14 SEUs / 14 PDUs</li></ul><div class="resource-links"><p class="resource-line"><a href="/downloads/3Back-CSPO-Data-Sheet-v1.0.pdf">Download the CSPO data sheet</a> for the full agenda and logistics details.</p><p class="resource-line">Questions about the credential or course logistics? See the <a href="/scrum-alliance-courses-faq/#certified-scrum-product-owner">Scrum Alliance Courses FAQ</a>.</p></div></div></div></section>
<section class="section teams-section section-rule"><div class="shell content-grid"><h2>How teams take the course</h2><div class="body-copy"><p>Most organizations that work with us bring the course in as private training: onsite or virtual, so the whole group learns the same language and practices together.</p><p>For private courses we take additional steps to tailor the delivery to your environment. Contact us so we can begin that process.</p><p>Open enrollment seats are also available through our scheduled events when that fits better.</p><p>Either path leads to the same credential and the same preparation support.</p><p class="team-actions"><button class="primary-cta" type="button" data-private-request-trigger aria-expanded="false" aria-controls="private-course-request">Request an on-site (or private virtual) course</button><a class="secondary-cta" href="/events">Find an upcoming public course</a></p></div></div></section>
<section class="section audience-section"><div class="shell content-grid"><h2>Who this is for</h2><div class="body-copy"><p>Primarily for leaders and managers who are sending people or whole teams. It is also right for individuals who need to become effective Product Owners on a Scrum team.</p><p>The CSPO® teaches the judgment that lets one person clarify value and order work so the team can deliver what matters.</p><ul class="role-swatches" aria-label="Roles this course supports">{roles.map((role, index) => <li><span class="role-mark" aria-hidden="true">0{index + 1}</span><strong>{role}</strong></li>)}<li class="po-accent"><span class="role-mark" aria-hidden="true">PO</span><strong>Product Owner</strong></li></ul></div></div></section>
<section class="closing-actions"><div class="shell"><h2>Choose the right course path.</h2><div class="closing-links"><button class="primary-cta" type="button" data-private-request-trigger aria-expanded="false" aria-controls="private-course-request">Request an on-site (or private virtual) course</button><a class="secondary-cta" href="/events">Find an upcoming public course</a><a class="secondary-cta" href="/downloads/3Back-CSPO-Data-Sheet-v1.0.pdf">Download the CSPO data sheet</a><a class="secondary-cta" href="/scrum-alliance-courses-faq/#certified-scrum-product-owner">Scrum Alliance Courses FAQ</a></div><p class="attribution">Certified Scrum Product Owner® is a certification mark of Scrum Alliance, Inc.</p></div></section>
</main></SiteLayout>
<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<script>declare global { interface Window { turnstile?: { reset(): void } } } const requestSection = document.querySelector("#private-course-request"); const requestForm = document.querySelector("[data-private-request-form]"); const requestTriggers = document.querySelectorAll("[data-private-request-trigger]"); if (requestSection instanceof HTMLElement && requestForm instanceof HTMLFormElement) { const error = requestForm.querySelector("[data-form-error]"); const success = requestForm.querySelector("[data-form-success]"); const button = requestForm.querySelector("button[type='submit']"); const firstName = requestForm.querySelector<HTMLInputElement>("[name='first_name']"); const email = requestForm.querySelector<HTMLInputElement>("[name='email']"); const confirmEmail = requestForm.querySelector<HTMLInputElement>("[name='confirm_email']"); const openRequest = () => { requestSection.hidden = false; requestTriggers.forEach((trigger) => trigger.setAttribute("aria-expanded", "true")); requestSection.scrollIntoView({ behavior: "smooth", block: "start" }); window.setTimeout(() => firstName?.focus(), 250); }; requestTriggers.forEach((trigger) => trigger.addEventListener("click", openRequest)); const validateEmails = () => { if (email && confirmEmail) confirmEmail.setCustomValidity(email.value && confirmEmail.value && email.value !== confirmEmail.value ? "Email addresses must match." : ""); }; email?.addEventListener("input", validateEmails); confirmEmail?.addEventListener("input", validateEmails); requestForm.addEventListener("submit", async (event) => { event.preventDefault(); validateEmails(); if (!(error instanceof HTMLElement) || !(success instanceof HTMLElement) || !(button instanceof HTMLButtonElement)) return; error.hidden = true; success.hidden = true; if (!requestForm.reportValidity()) return; button.disabled = true; button.textContent = "Sending..."; try { const response = await fetch(requestForm.action, { method: "POST", body: new FormData(requestForm), headers: { Accept: "application/json" } }); const result = await response.json().catch(() => ({})); if (!response.ok) throw new Error(typeof result.error === "string" ? result.error : "We could not send your request. Please try again."); requestForm.reset(); success.hidden = false; window.turnstile?.reset(); } catch (submissionError) { error.textContent = submissionError instanceof Error ? submissionError.message : "We could not send your request. Please try again."; error.hidden = false; window.turnstile?.reset(); } finally { button.disabled = false; button.textContent = "Send request"; } }); }</script>
<style>
.cspo-hero{padding:108px 0 84px;border-bottom:1px solid var(--rule);background:var(--paper)}.hero-grid,.content-grid,.why-grid,.private-request-grid{display:grid}.hero-grid{grid-template-columns:minmax(0,1fr) minmax(360px,.85fr);gap:clamp(42px,7vw,112px);align-items:center}.hero-copy{max-width:700px}.eyebrow{margin:0 0 16px;color:var(--amber-text);font-size:var(--type-caption);font-weight:var(--font-weight-heavy);letter-spacing:var(--tracking-caption);text-transform:uppercase}.hero-copy h1{margin-bottom:24px}.framing-line{max-width:720px;margin-bottom:32px;font-size:var(--type-lead);font-weight:var(--font-weight-semibold);line-height:var(--leading-lead)}.hero-action,.team-actions,.closing-links{display:flex;flex-wrap:wrap;gap:16px;margin:0}.primary-cta,.secondary-cta{display:inline-flex;align-items:center;justify-content:center;min-height:50px;padding:12px 19px;font:inherit;font-weight:var(--font-weight-bold);line-height:1.25;text-align:center;text-decoration:none;cursor:pointer}.primary-cta{border:2px solid var(--amber);background:var(--amber);color:var(--charcoal);box-shadow:5px 5px 0 var(--charcoal)}.primary-cta:hover{background:var(--charcoal);border-color:var(--charcoal);color:var(--paper);box-shadow:5px 5px 0 var(--amber)}.secondary-cta{border:1px solid currentColor;color:inherit}.secondary-cta:hover{background:var(--charcoal);border-color:var(--charcoal);color:var(--paper)}.hero-visual{display:grid;gap:18px}.priority-board{position:relative;min-height:310px;overflow:hidden;border:1px solid var(--charcoal);border-bottom:5px solid var(--amber);background:#e8dfd3}.board-label{position:absolute;top:28px;left:30px;font-size:.75rem;font-weight:var(--font-weight-heavy);letter-spacing:.1em;text-transform:uppercase}.priority-line{position:absolute;left:30px;height:45px;border-left:3px solid var(--charcoal);border-bottom:3px solid var(--charcoal)}.priority-line-one{top:85px;width:78%;background:var(--amber)}.priority-line-two{top:150px;width:59%;background:#f7f3eb}.priority-line-three{top:215px;width:39%;background:#d4c9bb}.priority-marker{position:absolute;right:30px;color:var(--amber-text);font-weight:var(--font-weight-heavy)}.marker-one{top:103px}.marker-two{top:168px}.marker-three{top:233px}.credential-panel{display:flex;align-items:center;gap:18px;padding:12px 22px;background:var(--charcoal);border-bottom:4px solid var(--amber);color:var(--paper)}.credential-panel img{flex:0 0 auto;width:92px;height:92px;object-fit:contain}.credential-panel p{margin:0;color:var(--paper);font-size:var(--type-caption);font-weight:var(--font-weight-heavy);letter-spacing:.06em;line-height:1.35;text-transform:uppercase}.credential-panel p::after{content:"16 hours of live instruction";display:block;margin-top:5px;color:#d7ddd9;font-size:.8125rem;font-weight:var(--font-weight-semibold);letter-spacing:.02em;text-transform:none}
.private-request{padding:74px 0;border-bottom:1px solid var(--rule);background:#ece8e0}.private-request-grid{grid-template-columns:minmax(0,.75fr) minmax(360px,.85fr);gap:clamp(46px,8vw,120px);align-items:start}.private-request h2,.content-grid h2{margin:0 0 16px;font-size:clamp(2rem,3.6vw,3.4rem)}.private-request-grid>div>p:last-child{max-width:420px;font-size:var(--type-lead);line-height:var(--leading-lead)}.private-request-form,.inclusions-card{padding:clamp(26px,4vw,42px);border-top:4px solid var(--amber);background:var(--paper);box-shadow:0 12px 30px rgba(29,36,33,.08)}.form-fields{display:grid;grid-template-columns:1fr 1fr;gap:20px}.field{display:grid;gap:7px}.field-full{grid-column:1/-1}.field label{font-size:var(--type-caption);font-weight:var(--font-weight-bold)}.field input,.field textarea{width:100%;border:1px solid #a9ada6;padding:12px 13px;font:inherit}.turnstile-wrap{min-height:65px;margin-top:24px}.form-error{color:#9e2a18;font-weight:var(--font-weight-semibold)}.submit-button{width:100%}.form-success{color:#315d42;font-weight:var(--font-weight-semibold)}
.section{padding:88px 0}.content-grid{grid-template-columns:minmax(220px,.8fr) minmax(0,1.45fr);gap:clamp(32px,8vw,130px)}.body-copy{max-width:720px}.body-copy p{font-size:1.125rem}.what-is-section{background:var(--reading)}.definition-copy{margin-top:0;font-size:1.22rem!important;font-weight:var(--font-weight-semibold);line-height:1.55}.definition-facts{display:grid;grid-template-columns:repeat(3,1fr);margin:30px 0;padding:0;list-style:none;border-top:3px solid var(--charcoal);border-bottom:1px solid var(--rule)}.definition-facts li{min-height:118px;padding:20px 22px 18px;border-right:1px solid var(--rule);transition:background-color 180ms ease,color 180ms ease}.definition-facts li:first-child{background:var(--charcoal);color:var(--paper)}.definition-facts li:last-child{border:0}.definition-facts strong,.definition-facts span{display:block}.definition-facts strong{margin-bottom:8px;color:var(--amber-text);font-size:clamp(1.55rem,2.6vw,2.2rem);line-height:1}.definition-facts li:first-child strong{color:#f2b948}.definition-facts span{font-size:var(--type-caption);font-weight:var(--font-weight-bold);line-height:1.35}.definition-support{color:var(--text-secondary);line-height:1.6}.why-section{padding:54px 0 90px;background:var(--charcoal);color:var(--paper);border-top:5px solid var(--amber)}.social-proof{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:22px 42px;margin-bottom:52px;padding-bottom:28px;border-bottom:1px solid #4d5651}.rating-proof,.award-proof{display:flex;align-items:center;flex-wrap:wrap;gap:12px}.rating-proof :global(svg){width:min(230px,100%)}.rating-proof strong{color:#f2b948;font-size:clamp(2.4rem,4vw,3.8rem)}.rating-proof span,.award-proof span{color:#e4e8e5;font-weight:var(--font-weight-semibold)}.award-proof :global(svg){width:58px}.award-proof span:last-child{color:#f2b948}.why-grid{grid-template-columns:minmax(0,1.1fr) minmax(0,.9fr);gap:clamp(34px,8vw,130px)}.eyebrow-light{color:#f2a56f}.why-section h2{margin:0;font-size:clamp(2.15rem,4vw,3.7rem)}.why-copy{max-width:570px;font-size:1.25rem;line-height:1.55}
.inclusions-section{background:#f1ede5}.outcomes-list,.inclusions-list,.role-swatches{padding:0;list-style:none}.outcomes-list{border-top:2px solid var(--charcoal)}.outcomes-list li{display:grid;grid-template-columns:42px 1fr;gap:12px;padding:16px 0;border-bottom:1px solid #cfc8bb}.outcomes-list span{color:var(--amber-text);font-size:var(--type-caption);font-weight:var(--font-weight-heavy)}.inclusions-card{max-width:720px;border-top-width:5px}.card-label{display:inline-block;padding:7px 10px;background:var(--charcoal);color:var(--paper);font-size:var(--type-caption);font-weight:var(--font-weight-heavy);letter-spacing:.07em;text-transform:uppercase}.inclusions-lead{font-size:1.4rem!important;font-weight:var(--font-weight-bold)}.inclusions-list{border-top:1px solid var(--rule)}.inclusions-list li{position:relative;padding:14px 0 14px 27px;border-bottom:1px solid var(--rule)}.inclusions-list li::before{position:absolute;left:3px;content:"↗";color:var(--amber-text);font-weight:var(--font-weight-heavy)}.resource-links{margin-top:28px}.resource-line a{color:var(--charcoal);font-weight:var(--font-weight-bold);text-decoration-color:var(--amber);text-decoration-thickness:2px;text-underline-offset:4px}.audience-section{background:var(--paper)}.role-swatches{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin:32px 0 0}.role-swatches li{display:flex;flex-direction:column;justify-content:space-between;min-height:108px;padding:14px;border:1px solid var(--charcoal);font-size:.9rem;font-weight:var(--font-weight-bold);line-height:1.25;transition:color 170ms ease-out,border-color 170ms ease-out}.role-swatches span{color:var(--amber-text);font-size:.75rem;font-weight:var(--font-weight-heavy);letter-spacing:.08em}.role-swatches .po-accent{min-height:122px;border-width:2px;background:var(--charcoal);color:var(--paper);font-size:1rem}.role-swatches .po-accent span{color:#f2b948;font-size:.9rem}.closing-actions{padding:78px 0;background:#e8dfd3;border-top:1px solid var(--rule)}.closing-actions h2{margin-top:0;font-size:clamp(2rem,4vw,3.4rem)}.attribution{margin:34px 0 0;color:var(--text-secondary);font-size:var(--type-caption)}
@media (hover:hover){.definition-facts:hover li:first-child{background:var(--paper);color:var(--charcoal)}.definition-facts:hover li:first-child strong{color:var(--amber-text)}.definition-facts li:hover{background:var(--charcoal);color:var(--paper)}.definition-facts li:hover strong{color:#f2b948}.role-swatches li:hover{border-color:var(--amber-text);color:var(--amber-text)}.role-swatches li:hover span{color:var(--amber-text)}}@media (prefers-reduced-motion:reduce){.definition-facts li,.role-swatches li{transition:none}}@media (max-width:760px){.cspo-hero{padding:78px 0 62px}.hero-grid,.private-request-grid,.content-grid,.why-grid{grid-template-columns:1fr}.priority-board{min-height:250px}.credential-panel{justify-content:center;flex-direction:column;text-align:center}.credential-panel img{width:96px;height:96px}.form-fields{grid-template-columns:1fr}.field-full{grid-column:auto}.definition-facts{grid-template-columns:1fr}.definition-facts li{min-height:0;padding:15px 18px;border-right:0;border-bottom:1px solid var(--rule)}.definition-facts strong,.definition-facts span{display:inline}.definition-facts strong{margin-right:12px;font-size:1.35rem}.social-proof{display:grid;gap:22px}.role-swatches{grid-template-columns:repeat(2,1fr)}.role-swatches li{min-height:94px}.role-swatches .po-accent{min-height:106px}.hero-action .primary-cta,.hero-action .secondary-cta,.team-actions .secondary-cta,.closing-links .secondary-cta{width:100%}.closing-links{display:grid}}
</style>
<style>
	/* CSPO interaction parity with the established CSM course pattern. */
	.inclusions-list li { transition: background-color 180ms ease, box-shadow 180ms ease, transform 180ms ease; }
	.inclusions-list li::before { transition: transform 180ms ease; }
	.resource-line a { color: var(--amber-text); transition: background-color 180ms ease, color 180ms ease, text-decoration-color 180ms ease; }
	.resource-line a:focus-visible { background: var(--amber); color: var(--charcoal); outline: 2px solid var(--charcoal); outline-offset: 3px; text-decoration-color: transparent; }
	.role-swatches strong { font-weight: var(--font-weight-bold); transition: font-weight 180ms ease-out; }
	.role-swatches .po-accent { transition: border-color 180ms ease-out, background-color 180ms ease-out, color 180ms ease-out, outline-color 180ms ease-out, transform 180ms ease-out; }
	.role-mark { display: grid; place-items: center; width: 30px; height: 30px; border: 1px solid var(--charcoal); color: var(--charcoal); font-size: .72rem; font-weight: var(--font-weight-heavy); letter-spacing: .08em; transition: background-color 180ms ease-out, border-color 180ms ease-out, color 180ms ease-out; }
	.role-swatches .po-accent .role-mark { width: 34px; height: 34px; border-color: var(--amber); color: var(--amber); font-size: .82rem; }
	@media (hover: hover) {
		.inclusions-list li:hover { background: #fff; box-shadow: inset 4px 0 0 var(--amber); transform: translateX(6px); }
		.inclusions-list li:hover::before { transform: translateX(3px); }
		.resource-line a:hover { background: var(--amber); color: var(--charcoal); text-decoration-color: transparent; }
		.role-swatches li:hover { border-color: var(--amber); color: var(--charcoal); }
		.role-swatches li:hover .role-mark { border-color: var(--amber); background: var(--amber); color: var(--charcoal); }
		.role-swatches li:hover strong { font-weight: var(--font-weight-heavy); }
		.role-swatches:has(li:not(.po-accent):hover) .po-accent, .role-swatches .po-accent:hover { border-color: var(--amber); background: var(--charcoal); color: var(--paper); outline: 2px solid var(--amber); outline-offset: 3px; transform: translateX(5px); }
		.role-swatches:has(li:not(.po-accent):hover) .po-accent .role-mark, .role-swatches .po-accent:hover .role-mark { border-color: var(--amber); background: var(--amber); color: var(--charcoal); }
	}
	@media (prefers-reduced-motion: reduce) { .inclusions-list li, .inclusions-list li::before, .resource-line a, .role-swatches strong, .role-mark { transition: none; } }
</style>
