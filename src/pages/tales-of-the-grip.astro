---
import SiteLayout from "../layouts/SiteLayout.astro";
import TalesShare from "../components/TalesShare.astro";
import TalesStripFigure from "../components/TalesStripFigure.astro";
import { nextScheduledTalesStrip, publishedTalesStrips } from "../data/tales-of-the-grip.mjs";
import { talesStripImages } from "../data/tales-of-the-grip-assets";
import { canonicalUrl, pageSeo } from "../seo/registry.mjs";
---

<SiteLayout metadata={pageSeo["/tales-of-the-grip"]}>
	<main id="main" class="tales-page">
		<section class="tales-intro">
			<div class="shell tales-copy">
				<h1>Tales of the Grip</h1>
				<div class="reading-block">
					<p>Tales of the Grip is an editorial cartoon series about organizational execution. Each strip uses humor to expose a familiar failure in how work actually runs. The aim is recognition: you laugh, then think, that is us.</p>
				</div>
				<p class="collection-link"><a href="/tales-of-the-grip/collection/">Collection</a></p>
				<TalesShare
					copyLabel="Copy collection link"
					description={pageSeo["/tales-of-the-grip"].description}
					shareLabel="Share collection"
					title="Tales of the Grip"
					url={canonicalUrl("/tales-of-the-grip")}
				/>
			</div>
		</section>

		<section class="tales-feed" aria-label="Tales of the Grip strips">
			<div class="shell">
				{publishedTalesStrips.map((strip, index) => {
					const titleId = `strip-${strip.slug}-title`;
					const image = talesStripImages[strip.slug];
					if (!image) throw new Error(`Missing Tales of the Grip image for ${strip.slug}`);
					return (
						<article class="strip-entry">
							<header class="strip-header">
								<h2 id={titleId}><a href={`${strip.path}/`}>{strip.title}</a></h2>
								<p><time datetime={strip.datePublished}>{strip.dateLabel}</time></p>
							</header>
							<TalesStripFigure
								alt={strip.imageAlt}
								href={`${strip.path}/`}
								image={image}
								labelledBy={titleId}
								linkLabel={`Read ${strip.title}`}
								loading={index === 0 ? "eager" : "lazy"}
							/>
						</article>
					);
				})}
			</div>
		</section>

		<section class="tales-closing">
			<div class="shell">
				{nextScheduledTalesStrip ? (
					<p>Next strip: <strong>{nextScheduledTalesStrip.title}</strong> · <time datetime={nextScheduledTalesStrip.datePublished}>{nextScheduledTalesStrip.dateLabel}</time>.</p>
				) : (
					<p>More episodes coming soon.</p>
				)}
			</div>
		</section>
	</main>
</SiteLayout>

<style>
	.tales-intro { padding: 122px 0 70px; }
	.tales-copy { max-width: 880px; }
	.tales-copy h1 { max-width: none; margin-bottom: 24px; font-size: clamp(4rem, 7.2vw, 6.4rem); font-weight: var(--font-weight-heavy); }
	.reading-block { max-width: 740px; color: var(--charcoal); font-size: 1.1rem; font-weight: var(--font-weight-regular); line-height: 1.65; }
	.reading-block p { margin-bottom: 16px; }
	.reading-block p:last-child { margin-bottom: 0; }
	.collection-link { margin: 18px 0 0; font-weight: var(--font-weight-semibold); }
	.tales-feed { padding: 0 0 88px; }
	.strip-entry + .strip-entry { margin-top: 88px; padding-top: 72px; border-top: 1px solid var(--rule); }
	.strip-header { max-width: 980px; margin-bottom: 20px; }
	.strip-header h2 { margin-bottom: 8px; font-size: clamp(1.75rem, 3vw, 2.5rem); line-height: 1.15; }
	.strip-header h2 a { color: var(--charcoal); text-decoration-color: var(--amber-text); text-decoration-thickness: 2px; text-underline-offset: .16em; }
	.strip-header p { margin: 0; color: var(--text-secondary); font-size: 1rem; }
	.tales-closing { padding: 54px 0 68px; border-block: 1px solid var(--rule); background: #eee8dd; }
	.tales-closing p { max-width: 680px; margin-bottom: 0; color: var(--charcoal); font-size: clamp(1.35rem, 2.4vw, 1.85rem); font-weight: var(--font-weight-semibold); line-height: 1.35; }

	@media (max-width: 720px) {
		.tales-intro { padding: 84px 0 48px; }
		.tales-feed { padding-bottom: 64px; }
		.strip-entry + .strip-entry { margin-top: 64px; padding-top: 52px; }
		.tales-closing { padding: 42px 0 52px; }
	}
</style>
