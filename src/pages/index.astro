---
import SiteLayout from "../layouts/SiteLayout.astro";
import { Image } from "astro:assets";
import { HOMEPAGE_OPERATIONAL_GRIP_EXPLANATION, pageSeo } from "../seo/registry.mjs";
import heroBoundaryVisual from "../assets/homepage/team-boundaries-diffuse.svg";

const diagnostics = [
	{
		number: "01",
		title: "One person holds the tapestry",
		body: "Too much authority, context, and sequencing dependency has collapsed into one decision-maker.",
	},
	{
		number: "02",
		title: "Local work stops staying local",
		body: "A small change creates unpredictable dependencies, rework, or downstream damage.",
	},
	{
		number: "03",
		title: "Coordination becomes reporting",
		body: "Meetings describe activity but do not route the cross-boundary work teams cannot safely resolve alone.",
	},
	{
		number: "04",
		title: "Demand is silenced",
		body: "Bloated backlogs, status theater, delayed feedback, and excessive process weaken the signal from the work.",
	},
];

const loop = ["Demand", "Organizational response", "Delivered value", "Market acceptance", "Revenue"];

const approach = [
	{
		title: "Observe the condition",
		body: "Follow real demand, decisions, work, dependencies, feedback, and downstream effects.",
	},
	{
		title: "Bound the intervention",
		body: "Choose one problem connected to real demand, safe enough to change, and visible enough to learn from.",
	},
	{
		title: "Place decision ownership",
		body: "Give one accountable role the judgment needed to act within a clear authority boundary.",
	},
	{
		title: "Inspect the result",
		body: "Observe what changed, what propagated, and what the organization can now see well enough to do next.",
	},
];

const assessmentResults = [
	{
		key: "demand",
		label: "Response to Changing Demand",
		score: 95,
		strength: "Strong",
	},
	{
		key: "ownership",
		label: "Ownership and Bounded Execution",
		score: 35,
		strength: "Weak",
	},
	{
		key: "results",
		label: "Observable and Traceable Results",
		score: 90,
		strength: "Strong",
	},
	{
		key: "adaptation",
		label: "Adaptation Without Loss of Control",
		score: 90,
		strength: "Strong",
	},
	{
		key: "ai",
		label: "AI Use and Control",
		score: 60,
		strength: "Moderate",
	},
];

const overallGripScore = Math.round(
	assessmentResults.reduce((total, result) => total + result.score, 0) / assessmentResults.length,
);
---

<SiteLayout
	metadata={pageSeo["/"]}
>
	<main id="main">
			<section class="hero section-rule">
				<div class="shell hero-grid">
					<div class="hero-copy">
						<p class="eyebrow">3Back <span aria-hidden="true">|</span> The Team Execution Company</p>
						<h1>Organizations do not outgrow teams.<br /><em>They lose the boundaries that made teams effective.</em></h1>
						<p class="hero-intro">
							When decisions, dependencies, and coordination spread without control, work slows,
							accountability diffuses, and demand gets lost. 3Back helps leaders find where execution has
							lost grip and make bounded changes that reveal what to do next.
						</p>
						<div class="button-row">
							<a class="button" href="/contact/">Start a Conversation</a>
							<a class="text-link" href="/operational-grip/">Explore Operational Grip <span aria-hidden="true">&#8594;</span></a>
						</div>
					</div>

					<div class="hero-aside" aria-hidden="true">
						<Image class="hero-boundary-visual" src={heroBoundaryVisual} alt="" />
					</div>
				</div>
			</section>

			<section class="section section-rule" aria-labelledby="loss-heading">
				<div class="shell">
					<div class="section-heading split-heading">
						<div>
							<p class="eyebrow">Observable problem</p>
							<h2 id="loss-heading">An organization can look busy while losing control of the work.</h2>
						</div>
						<p class="lead-copy">The problem is rarely a lack of activity. It is the growing distance between demand, decisions, work, and observable results.</p>
					</div>

					<ol class="diagnostic-grid">
						{diagnostics.map((item) => (
							<li tabindex="0">
								<span class="item-number">{item.number}</span>
								<h3>{item.title}</h3>
								<p>{item.body}</p>
							</li>
						))}
					</ol>

					<p class="closing-line">These are not isolated process problems. They are evidence that the organization may be losing <strong>Operational Grip.</strong></p>
				</div>
			</section>

			<section class="grip-section" id="operational-grip" aria-labelledby="grip-heading">
				<div class="shell grip-grid">
					<div class="grip-copy">
						<p class="eyebrow eyebrow-light">Operational Grip</p>
						<h2 id="grip-heading">Can the people closest to the work make a local change whose effects stay observable and correctable?</h2>
						<div class="grip-body">
							<p class="operational-grip-explanation">{HOMEPAGE_OPERATIONAL_GRIP_EXPLANATION}</p>
							<p>It is not total system understanding. It is enough actionable control to adapt intelligently while keeping work connected to purpose, quality, and value.</p>
						</div>
						<p class="operating-line">Bound what you can. Act locally. Observe the effects. Learn.</p>
					</div>

					<div class="grip-diagram" tabindex="0" aria-label="A local action inside an observable boundary creates downstream effects">
						<p class="diagram-question diagram-question-top">What am I missing?</p>
						<div class="diagram-stage">
							<div class="local-boundary">
								<span class="diagram-label">Observable boundary</span>
								<div class="local-action">Local<br />action</div>
							</div>
							<div class="effect-line" aria-hidden="true"><span></span><span></span><span></span></div>
							<div class="downstream">Downstream<br />effects</div>
						</div>
						<p class="diagram-question diagram-question-bottom">How would you know?</p>
					</div>
				</div>
			</section>

			<section class="section loop-section" aria-labelledby="loop-heading">
				<div class="shell">
					<div class="section-heading split-heading">
						<div>
							<p class="eyebrow">The commercial execution loop</p>
							<h2 id="loop-heading">Work matters only when it remains connected to demand and delivered value.</h2>
						</div>
						<p class="lead-copy">3Back examines the complete commercial execution loop. The question is where signal weakens, ownership diffuses, or feedback arrives too late to guide action.</p>
					</div>

					<ol class="loop-flow">
						{loop.map((item, index) => (
							<li class:list={[index === 0 && "signal-step", index === 2 && "organization-end"]} tabindex="0">
								<span>{String(index + 1).padStart(2, "0")}</span>
								<strong>{item}</strong>
							</li>
						))}
					</ol>

					<p class="loop-note">Revenue is evidence that the market accepted the organization's response to demand. It is not a result 3Back guarantees. The work is to restore enough grip for the organization to see, act, and learn before demand disappears into activity.</p>
				</div>
			</section>

			<section class="assessment-section section-rule" id="grip-assessment" aria-labelledby="assessment-heading">
				<div class="shell assessment-grid">
					<div class="assessment-copy">
						<p class="eyebrow eyebrow-light">Operational Grip assessment</p>
						<h2 id="assessment-heading">How strong is your organization's grip?</h2>
						<p class="assessment-intro">See where execution is holding firm and where it is losing grip.</p>
						<ul class="assessment-commitments" aria-label="Assessment details">
							<li>15 questions</li>
							<li>About 4 minutes</li>
							<li>Immediate results</li>
						</ul>
						<a class="button assessment-button" href="/grip-check/">Check Your Grip</a>
					</div>

					<article class="score-card" id="grip-score-card" aria-labelledby="score-card-heading">
						<p class="score-eyebrow" id="score-card-heading">Sample Grip Score</p>
						<div class="score-profile">
							<svg class="score-ring" viewBox="0 0 520 300" role="group" aria-label="Five-section Operational Grip score profile">
								<g transform="translate(260 250)">
									<path id="ring-demand" data-section="demand" class="score-segment score-segment-strong" d="M -210 0 A 210 210 0 0 1 -170 -123" role="button" tabindex="0" aria-controls="result-demand" aria-label="Response to Changing Demand, 95 percent, Strong" aria-pressed="false"></path>
									<path id="ring-ownership" data-section="ownership" class="score-segment score-segment-weak" d="M -158 -139 A 210 210 0 0 1 -65 -200" role="button" tabindex="0" aria-controls="result-ownership" aria-label="Ownership and Bounded Execution, 35 percent, Weak" aria-pressed="false"></path>
									<path id="ring-results" data-section="results" class="score-segment score-segment-strong" d="M -48 -204 A 210 210 0 0 1 48 -204" role="button" tabindex="0" aria-controls="result-results" aria-label="Observable and Traceable Results, 90 percent, Strong" aria-pressed="false"></path>
									<path id="ring-adaptation" data-section="adaptation" class="score-segment score-segment-strong" d="M 65 -200 A 210 210 0 0 1 158 -139" role="button" tabindex="0" aria-controls="result-adaptation" aria-label="Adaptation Without Loss of Control, 90 percent, Strong" aria-pressed="false"></path>
									<path id="ring-ai" data-section="ai" class="score-segment score-segment-moderate" d="M 170 -123 A 210 210 0 0 1 210 0" role="button" tabindex="0" aria-controls="result-ai" aria-label="AI Use and Control, 60 percent, Moderate" aria-pressed="false"></path>
								</g>
							</svg>
							<p class="overall-score" aria-label={`Overall score ${overallGripScore} out of 100`}>
								<strong>{overallGripScore}</strong><span>/100</span>
							</p>
							<img class="hands-bar" src="/assets/operational-grip/hands-bar.png" alt="One hand holds a bar securely while the other begins to lose its grip." />
						</div>

						<div class="score-results" aria-label="Sample results by assessment section">
							{assessmentResults.map((result) => (
								<button
									class:list={["score-result", `score-result-${result.key}`]}
									id={`result-${result.key}`}
									type="button"
									data-section={result.key}
									aria-controls={`ring-${result.key}`}
									aria-pressed="false"
								>
									<span class="score-icon" aria-hidden="true"></span>
									<span class="result-label">{result.label}</span>
									<strong>{result.score}%</strong>
									<span class="result-strength">{result.strength}</span>
								</button>
							))}
						</div>

						<div class="overall-reading">
							<h3>Overall Reading</h3>
							<p>Generally strong grip with a concentrated weakness in Ownership and Bounded Execution.</p>
						</div>
					</article>
				</div>
			</section>

			<section class="section approach-section section-rule" aria-labelledby="approach-heading">
				<div class="shell">
					<div class="section-heading narrow-heading">
						<p class="eyebrow">How 3Back works</p>
						<h2 id="approach-heading">Evidence first. One bounded problem at a time.</h2>
						<p class="lead-copy">3Back examines the actual work system before recommending a change. We preserve what works, identify the real constraint, and recommend a change that can be owned, observed, and corrected.</p>
					</div>

					<ol class="approach-list">
						{approach.map((item, index) => (
							<li tabindex="0">
								<span class="approach-number">{String(index + 1).padStart(2, "0")}</span>
								<div>
									<h3>{item.title}</h3>
									<p>{item.body}</p>
								</div>
							</li>
						))}
					</ol>

					<blockquote class="standard-quote"><span class="approach-one approach-one-1">One</span> bounded problem, <span class="approach-one approach-one-2">one</span> decision, <span class="approach-one approach-one-3">one</span> accountable owner, and <span class="approach-one approach-one-4">one</span> observable result at a time.</blockquote>
				</div>
			</section>

			<section class="section body-work-section" aria-labelledby="body-work-heading">
				<div class="shell body-work-grid">
					<div class="body-work-lead">
						<p class="eyebrow">A body of work built around execution</p>
						<h2 id="body-work-heading">Operational Grip is the current operating lens guiding 3Back&rsquo;s work.</h2>
						<p>3Back has spent years examining how teams form, make decisions, adapt, coordinate, and deliver value. Operational Grip is the culmination of that work and the primary lens guiding 3Back now.</p>
					</div>

					<div class="body-work-links">
						<a href="/ideas/">
							<span>01</span>
							<h3>Well-Formed Teams</h3>
							<p>The team and authority structure beneath accountable execution.</p>
						</a>
						<a href="/ideas/">
							<span>02</span>
							<h3>Decision ownership and adaptation</h3>
							<p>How authority, local control, and feedback shape the ability to respond to changing demand.</p>
						</a>
						<a href="/ideas/">
							<span>03</span>
							<h3>Agility, Scrum, publications, and learning</h3>
							<p>A continuing body of work that informs how 3Back thinks about teams, execution, and adaptation.</p>
						</a>
					</div>
				</div>
				<div class="shell boundary-statement">3Back is the enduring brand. Operational Grip leads the current argument. No single concept independently defines the company.</div>
			</section>

			<section class="section thinking-section section-rule" aria-labelledby="thinking-heading">
				<div class="shell">
					<div class="section-heading split-heading">
						<div>
							<p class="eyebrow">Current thinking</p>
							<h2 id="thinking-heading">Ideas for seeing the system before changing it</h2>
						</div>
						<p class="lead-copy">Examine the mechanism. Find the evidence. Then decide where action can reveal more of the system.</p>
					</div>

					<div class="thinking-grid">
						<article>
							<p class="content-type">Publication / Excerpt</p>
							<h3><a href="/ideas/">No Head Works Alone</a></h3>
						</article>
						<article class="tales-card">
							<p class="content-type"><a href="/doomscroll/">Tales of the Grip</a></p>
							<div class="tales-mark" aria-hidden="true">
								<div class="local-box"></div>
								<div class="permission-lines"><i></i><i></i><i></i></div>
							</div>
							<h3><a href="/operational-grip/">The decision is local. The permission structure is not.</a></h3>
						</article>
					</div>

					<p class="section-action"><a class="text-link muted-link" href="/ideas/">Explore the Ideas <span aria-hidden="true">&#8594;</span></a></p>
				</div>
			</section>

			<section class="contact-section" id="contact" aria-labelledby="contact-heading">
				<div class="shell contact-grid">
					<div>
						<p class="eyebrow eyebrow-light">Start with the work in front of you</p>
						<h2 id="contact-heading">Find one place where action will reveal the system.</h2>
					</div>
					<div class="contact-copy">
						<p>You do not need the perfect place to start. Bring one execution problem where demand is real, ownership is unclear, or local action keeps creating downstream effects. We will examine whether it is bounded enough to act on and observable enough to learn from.</p>
						<a class="button" href="/contact/" aria-describedby="contact-note">Start a Conversation</a>
						<p class="contact-note" id="contact-note">No transformation pitch. No promise of a universal answer. Start with the work in front of you.</p>
					</div>
				</div>
			</section>
	</main>

		<script>
			const assessment = document.querySelector<HTMLElement>("#grip-assessment");

			if (assessment) {
				const pairedControls = Array.from(assessment.querySelectorAll<HTMLElement>("[data-section]"));
				let selectedSection: string | null = null;

				const setActiveSection = (section: string | null) => {
					assessment.dataset.activeSection = section ?? "";
					pairedControls.forEach((control) => {
						const isActive = control.dataset.section === section;
						control.classList.toggle("is-active", isActive);
						if (control.matches("button, [role='button']")) {
							control.setAttribute("aria-pressed", String(isActive));
						}
					});
				};

				pairedControls.forEach((control) => {
					const section = control.dataset.section;
					if (!section) return;

					control.addEventListener("pointerenter", (event) => {
						if ((event as PointerEvent).pointerType !== "touch") setActiveSection(section);
					});
					control.addEventListener("pointerleave", (event) => {
						if ((event as PointerEvent).pointerType !== "touch") setActiveSection(selectedSection);
					});
					control.addEventListener("focus", () => setActiveSection(section));
					control.addEventListener("blur", () => setActiveSection(selectedSection));
					control.addEventListener("click", (event) => {
						event.stopPropagation();
						selectedSection = event.detail === 0 ? section : selectedSection === section ? null : section;
						setActiveSection(selectedSection);
					});
					control.addEventListener("keydown", (event) => {
						if (control.matches("button")) return;
						if (event.key === " " || event.key === "Enter") {
							event.preventDefault();
							selectedSection = section;
							setActiveSection(section);
						}
					});
				});

				document.addEventListener("click", () => {
					selectedSection = null;
					setActiveSection(null);
				});
			}
	</script>
</SiteLayout>

<style>
	.button-row { display: flex; gap: 26px; align-items: center; flex-wrap: wrap; }
	.text-link { font-weight: var(--font-weight-bold); text-decoration: underline; text-decoration-color: var(--amber); text-decoration-thickness: 2px; text-underline-offset: 6px; }
	.text-link:hover { color: var(--amber-text); }

	.eyebrow { margin-bottom: 24px; color: var(--amber-text); font-size: var(--type-card); font-weight: var(--font-weight-heavy); letter-spacing: var(--tracking-caption); line-height: var(--leading-card); text-transform: uppercase; }
	.eyebrow span { margin-inline: 8px; color: var(--slate); }
	.eyebrow-light { color: #f5aa70; }
	.hero { padding: 96px 0 105px; }
	.hero-grid { display: grid; grid-template-columns: minmax(0, 1fr) 308px; gap: clamp(45px, 7vw, 110px); align-items: end; }
	.hero-intro { max-width: 760px; margin-bottom: 36px; color: var(--text-primary); font-size: var(--type-lead); line-height: var(--leading-lead); }
	.hero-aside { box-sizing: border-box; align-self: center; width: 308px; padding-left: 24px; border-left: 4px solid var(--amber); }
	.hero-boundary-visual { display: block; width: 100%; height: auto; }

	.section-heading { margin-bottom: 58px; }
	.split-heading { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(280px, 0.65fr); gap: clamp(45px, 8vw, 120px); align-items: end; }
	.split-heading h2 { max-width: 760px; }
	.lead-copy { color: var(--text-secondary); font-size: var(--type-lead); line-height: var(--leading-lead); }
	.narrow-heading { max-width: 820px; }

	.diagnostic-grid { display: grid; grid-template-columns: repeat(4, 1fr); margin: 0; padding: 0; border-top: 4px solid var(--charcoal); border-bottom: 1px solid var(--rule); list-style: none; }
	.diagnostic-grid li { min-height: 285px; padding: 28px 26px 30px 0; border-right: 1px solid var(--rule); transition: background-color 160ms ease-out, box-shadow 160ms ease-out; }
	.diagnostic-grid li:not(:first-child) { padding-left: 26px; }
	.diagnostic-grid li:last-child { border-right: 0; }
	.diagnostic-grid li:hover, .diagnostic-grid li:focus-visible { background: var(--amber-wash); box-shadow: inset 0 3px 0 var(--amber); outline: none; }
	.diagnostic-grid:has(li:hover) + .closing-line, .diagnostic-grid:has(li:focus-visible) + .closing-line { border-left-width: 6px; }
	.item-number, .approach-number { display: block; margin-bottom: 48px; color: var(--amber-text); font-size: var(--type-card); font-weight: var(--font-weight-heavy); letter-spacing: var(--tracking-caption); line-height: var(--leading-card); }
	.diagnostic-grid p { color: var(--text-primary); font-size: var(--type-card); line-height: var(--leading-card); }
	.closing-line { max-width: 810px; margin: 40px 0 0 auto; padding-left: 25px; border-left: 3px solid var(--amber); font-size: var(--type-lead); line-height: var(--leading-lead); }

	.grip-section { padding: 110px 0; background: var(--charcoal); color: var(--paper); }
	.grip-grid { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(370px, 0.9fr); gap: clamp(60px, 9vw, 140px); align-items: center; }
	.grip-copy h2 { max-width: 760px; }
	.grip-body { max-width: 730px; color: #c5cbc7; font-size: var(--type-body); line-height: var(--leading-body); column-count: 2; column-gap: 38px; }
	.grip-body p { break-inside: avoid; }
	.operating-line { margin-top: 40px; padding-top: 18px; border-top: 2px solid var(--amber); font-size: var(--type-lead); font-weight: var(--font-weight-bold); line-height: var(--leading-lead); }
	.grip-diagram { padding: 28px; border: 1px solid #53605a; background: #222b27; outline: none; }
	.grip-diagram:focus-visible { outline: 3px solid var(--amber); outline-offset: 4px; }
	.diagram-question { color: #f5aa70; font-size: var(--type-card); font-weight: var(--font-weight-heavy); letter-spacing: var(--tracking-caption); line-height: var(--leading-card); text-transform: uppercase; }
	.diagram-question-top { margin-bottom: 28px; }
	.diagram-question-bottom { margin: 28px 0 0; text-align: right; }
	.diagram-stage { min-height: 300px; display: grid; grid-template-columns: 1fr 70px 0.62fr; align-items: center; }
	.local-boundary { position: relative; aspect-ratio: 1; display: grid; place-items: center; border: 2px solid var(--paper); }
	.diagram-label { position: absolute; top: 10px; left: 12px; color: #b9c0bc; font-size: var(--type-card); line-height: var(--leading-card); }
	.local-action { width: 42%; aspect-ratio: 1; display: grid; place-items: center; background: var(--amber); color: var(--charcoal); text-align: center; font-size: var(--type-card); font-weight: var(--font-weight-heavy); line-height: var(--leading-display); transition: transform 160ms ease-out; }
	.effect-line { display: flex; align-items: center; }
	.effect-line span { width: 20px; height: 2px; margin-right: 4px; background: #8a948f; }
	.effect-line span:last-child { background: var(--amber); }
	.effect-line::after { content: ""; width: 8px; height: 8px; margin-left: -5px; border-top: 2px solid #8a948f; border-right: 2px solid #8a948f; transform: rotate(45deg); }
	.downstream { display: grid; place-items: center; min-height: 92px; border: 1px dashed #89928e; color: #c5cbc7; text-align: center; font-size: var(--type-card); line-height: var(--leading-card); letter-spacing: var(--tracking-heading); transition: border-color 160ms ease-out, color 160ms ease-out; }
	.grip-diagram:hover .local-action, .grip-diagram:focus-visible .local-action { transform: translateX(8px); }
	.grip-diagram:hover .downstream, .grip-diagram:focus-visible .downstream { border-color: var(--amber); color: var(--amber); }
	.grip-diagram:hover .effect-line span, .grip-diagram:focus-visible .effect-line span, .grip-diagram:hover .effect-line::after, .grip-diagram:focus-visible .effect-line::after { border-color: var(--amber); background-color: var(--amber); }

	.loop-section { background: var(--reading); }
	.loop-flow { position: relative; display: grid; grid-template-columns: repeat(5, 1fr); margin: 0; padding: 0; border-top: 4px solid var(--charcoal); border-bottom: 1px solid var(--rule); list-style: none; }
	.loop-flow li { position: relative; min-height: 145px; padding: 24px 22px; border-right: 1px solid var(--rule); background: var(--reading); outline: none; transition: background-color 160ms ease-out; }
	.loop-flow li::after { content: ""; position: absolute; top: 50%; right: -6px; z-index: 2; width: 10px; height: 10px; border-top: 2px solid var(--charcoal); border-right: 2px solid var(--charcoal); background: transparent; transform: translateY(-50%) rotate(45deg); }
