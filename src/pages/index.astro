---
const diagnostics = [
	{
		number: "01",
		title: "One person holds the tapestry",
		body: "Too much authority, context, and sequencing dependency has collapsed into one decision-maker.",
	},
	{
		number: "02",
		title: "Local work stops staying local",
		body: "A small change creates unpredictable dependencies, rework, or downstream damage.",
	},
	{
		number: "03",
		title: "Coordination becomes reporting",
		body: "Meetings describe activity but do not route the cross-boundary work teams cannot safely resolve alone.",
	},
	{
		number: "04",
		title: "Demand is silenced",
		body: "Bloated backlogs, status theater, delayed feedback, and excessive process weaken the signal from the work.",
	},
];

const loop = ["Demand", "Organizational response", "Delivered value", "Market acceptance", "Revenue"];

const approach = [
	{
		title: "Observe the condition",
		body: "Follow real demand, decisions, work, dependencies, feedback, and downstream effects.",
	},
	{
		title: "Bound the intervention",
		body: "Choose one problem connected to real demand, safe enough to change, and visible enough to learn from.",
	},
	{
		title: "Place decision ownership",
		body: "Give one accountable role the judgment needed to act within a clear authority boundary.",
	},
	{
		title: "Inspect the result",
		body: "Observe what changed, what propagated, and what the organization can now see well enough to do next.",
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta
			name="description"
			content="3Back helps leaders find where organizational execution has lost grip and make bounded changes that reveal what to do next."
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>3Back | The Team Execution Company</title>
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>

		<header class="site-header">
			<div class="shell header-inner">
				<div class="brand-lockup" aria-label="3Back, The Team Execution Company">
					<div class="wordmark"><span>3</span>Back</div>
					<div class="descriptor">The Team Execution Company</div>
				</div>

				<nav class="desktop-nav" aria-label="Primary navigation">
					<span>Operational Grip</span>
					<span>Work With 3Back</span>
					<span>Ideas</span>
					<span>Learning</span>
					<span>About</span>
				</nav>

				<a class="button button-small" href="#contact">Start a Conversation</a>
			</div>
		</header>

		<main id="main">
			<section class="hero section-rule">
				<div class="shell hero-grid">
					<div class="hero-copy">
						<p class="eyebrow">3Back <span aria-hidden="true">|</span> The Team Execution Company</p>
						<h1>Organizations do not outgrow teams.<br /><em>They lose the boundaries that made teams effective.</em></h1>
						<p class="hero-intro">
							When decisions, dependencies, and coordination spread without control, work slows,
							accountability diffuses, and demand gets lost. 3Back helps leaders find where execution has
							lost grip and make bounded changes that reveal what to do next.
						</p>
						<div class="button-row">
							<a class="button" href="#contact">Start a Conversation</a>
							<a class="text-link" href="#operational-grip">Explore Operational Grip <span aria-hidden="true">&#8594;</span></a>
						</div>
					</div>

					<aside class="hero-aside" aria-label="3Back visual direction">
						<div class="boundary-window" aria-hidden="true">
							<div class="boundary-inner">
								<span class="signal-dot"></span>
								<div class="boundary-path"></div>
								<span class="result-dot"></span>
							</div>
						</div>
						<p class="aside-label">Visual target</p>
						<p>Quiet authority.<br />Operational depth.<br />A bias toward action.</p>
					</aside>
				</div>
			</section>

			<section class="section section-rule" aria-labelledby="loss-heading">
				<div class="shell">
					<div class="section-heading split-heading">
						<div>
							<p class="eyebrow">Observable problem</p>
							<h2 id="loss-heading">Execution can look busy while the organization is losing control of the work.</h2>
						</div>
						<p class="lead-copy">The problem is rarely a lack of activity. It is the growing distance between demand, decisions, work, and observable results.</p>
					</div>

					<ol class="diagnostic-grid">
						{diagnostics.map((item) => (
							<li>
								<span class="item-number">{item.number}</span>
								<h3>{item.title}</h3>
								<p>{item.body}</p>
							</li>
						))}
					</ol>

					<p class="closing-line">These are not isolated process problems. They are evidence that the organization may be losing <strong>Operational Grip.</strong></p>
				</div>
			</section>

			<section class="grip-section" id="operational-grip" aria-labelledby="grip-heading">
				<div class="shell grip-grid">
					<div class="grip-copy">
						<p class="eyebrow eyebrow-light">Operational Grip</p>
						<h2 id="grip-heading">Can the people closest to the work make a bounded change and predict its likely effect?</h2>
						<div class="grip-body">
							<p>Operational Grip is the ability of a team or scaled system to make bounded local changes, observe the effects, and adjust without creating uncontrolled downstream damage.</p>
							<p>It is not total system understanding. It is enough actionable control to adapt intelligently while keeping work connected to purpose, quality, and value.</p>
						</div>
						<p class="operating-line">Bound what you can. Act locally. Observe the effects. Learn.</p>
					</div>

					<div class="grip-diagram" aria-label="A local action inside an observable boundary creates downstream effects">
						<p class="diagram-question">How would you know?</p>
						<div class="diagram-stage">
							<div class="local-boundary">
								<span class="diagram-label">Observable boundary</span>
								<div class="local-action">Local<br />action</div>
							</div>
							<div class="effect-line" aria-hidden="true"><span></span><span></span><span></span></div>
							<div class="downstream">Downstream<br />effects</div>
						</div>
					</div>
				</div>
			</section>

			<section class="section loop-section" aria-labelledby="loop-heading">
				<div class="shell">
					<div class="section-heading split-heading">
						<div>
							<p class="eyebrow">The commercial execution loop</p>
							<h2 id="loop-heading">Work matters only when it remains connected to demand and delivered value.</h2>
						</div>
						<p class="lead-copy">3Back examines the complete commercial execution loop. The question is where signal weakens, ownership diffuses, or feedback arrives too late to guide action.</p>
					</div>

					<ol class="loop-flow">
						{loop.map((item, index) => (
							<li class:list={[index === 0 && "signal-step"]}>
								<span>{String(index + 1).padStart(2, "0")}</span>
								<strong>{item}</strong>
							</li>
						))}
					</ol>

					<p class="loop-note">Revenue is evidence that the market accepted the organization's response to demand. It is not a result 3Back guarantees. The work is to restore enough grip for the organization to see, act, and learn before demand disappears into activity.</p>
				</div>
			</section>

			<section class="section approach-section section-rule" aria-labelledby="approach-heading">
				<div class="shell">
					<div class="section-heading narrow-heading">
						<p class="eyebrow">How 3Back works</p>
						<h2 id="approach-heading">Evidence first. One bounded problem at a time.</h2>
						<p class="lead-copy">3Back examines the actual work system before prescribing a solution. We preserve what works, identify the real constraint, and recommend a change that can be owned, observed, and corrected.</p>
					</div>

					<ol class="approach-list">
						{approach.map((item, index) => (
							<li>
								<span class="approach-number">{String(index + 1).padStart(2, "0")}</span>
								<div>
									<h3>{item.title}</h3>
									<p>{item.body}</p>
								</div>
							</li>
						))}
					</ol>

					<blockquote class="standard-quote">One bounded problem, one decision, one accountable owner, and one observable result at a time.</blockquote>
				</div>
			</section>

			<section class="section evidence-section" aria-labelledby="evidence-heading">
				<div class="shell evidence-grid">
					<div class="evidence-intro">
						<p class="eyebrow eyebrow-light">Evidence from actual work</p>
						<h2 id="evidence-heading">Where execution regained grip</h2>
						<p>Proof should show the work, not decorate the claim.</p>
					</div>

					<article class="case-placeholder">
						<div class="placeholder-flag">Publishable case required</div>
						<div class="case-domain">
							<span>Client or domain</span>
							<strong>Real example to be confirmed</strong>
						</div>
						<dl>
							<div><dt>The condition observed</dt><dd>Describe the concrete execution condition.</dd></div>
							<div><dt>The bounded change made</dt><dd>Describe the smallest material intervention.</dd></div>
							<div><dt>The observable result</dt><dd>Describe what became visible, predictable, faster, safer, or more locally controllable.</dd></div>
						</dl>
						<p class="placeholder-note">No invented metrics, composite claims, or unsupported praise will be used here.</p>
					</article>
				</div>
			</section>

			<section class="section body-work-section" aria-labelledby="body-work-heading">
				<div class="shell body-work-grid">
					<div class="body-work-lead">
						<p class="eyebrow">A body of work built around execution</p>
						<h2 id="body-work-heading">Operational Grip is the current lead lens in a larger body of work.</h2>
						<p>3Back has spent years examining how teams form, make decisions, adapt, coordinate, and deliver value. Operational Grip is the culmination of that work and the primary lens guiding 3Back now.</p>
					</div>

					<div class="body-work-links">
						<article>
							<span>01</span>
							<h3>Well-Formed Teams</h3>
							<p>The bounded team and authority structure beneath accountable execution.</p>
						</article>
						<article>
							<span>02</span>
							<h3>Agility and Scrum</h3>
							<p>An important part of 3Back's intellectual history, education, and continuing practice.</p>
						</article>
						<article>
							<span>03</span>
							<h3>Publications and learning</h3>
							<p>Books, articles, courses, and deeper material for leaders and practitioners.</p>
						</article>
					</div>
				</div>
				<div class="shell boundary-statement">3Back is the enduring brand. Operational Grip leads the current argument. No single concept independently defines the company.</div>
			</section>

			<section class="section thinking-section section-rule" aria-labelledby="thinking-heading">
				<div class="shell">
					<div class="section-heading split-heading">
						<div>
							<p class="eyebrow">Current thinking</p>
							<h2 id="thinking-heading">Ideas for seeing the system before changing it</h2>
						</div>
						<p class="lead-copy">Examine the mechanism. Find the evidence. Then decide where action can reveal more of the system.</p>
					</div>

					<div class="thinking-grid">
						<article class="feature-article">
							<p class="content-type">Operational Grip / Feature</p>
							<h3>Current lead article to be confirmed</h3>
							<p>A substantive entry point into boundaries, local control, and accountable execution.</p>
							<span class="content-status">Editorial slot reserved</span>
						</article>
						<article>
							<p class="content-type">Publication / Excerpt</p>
							<h3>No Head Works Alone</h3>
							<p>Confirm whether this appears as an article, publication, or featured excerpt.</p>
							<span class="content-status">Format to be confirmed</span>
						</article>
						<article class="tales-card">
							<p class="content-type">Tales of the Grip</p>
							<div class="tales-mark" aria-hidden="true">
								<div class="local-box"></div>
								<div class="permission-lines"><i></i><i></i><i></i></div>
							</div>
							<h3>The decision is local. The permission structure is not.</h3>
							<span class="content-status">Current cartoon required</span>
						</article>
					</div>

					<p class="section-action"><span class="text-link muted-link">Explore the Ideas <span aria-hidden="true">&#8594;</span></span></p>
				</div>
			</section>

			<section class="contact-section" id="contact" aria-labelledby="contact-heading">
				<div class="shell contact-grid">
					<div>
						<p class="eyebrow eyebrow-light">Start with the work in front of you</p>
						<h2 id="contact-heading">Find one place where action will reveal the system.</h2>
					</div>
					<div class="contact-copy">
						<p>You do not need the perfect place to start. Bring one execution problem where demand is real, ownership is unclear, or local action keeps creating downstream effects. We will examine whether it is bounded enough to act on and observable enough to learn from.</p>
						<button class="button" type="button" aria-describedby="contact-note">Start a Conversation</button>
						<p class="contact-note" id="contact-note">No transformation pitch. No promise of a universal answer. Start with the work in front of you.</p>
					</div>
				</div>
			</section>
		</main>

		<footer class="site-footer">
			<div class="shell footer-grid">
				<div class="footer-brand">
					<div class="wordmark wordmark-light"><span>3</span>Back</div>
					<p>The Team Execution Company</p>
				</div>
				<div>
					<p class="footer-heading">Navigate</p>
					<ul><li>Operational Grip</li><li>Work With 3Back</li><li>Ideas</li><li>Learning</li><li>About</li></ul>
				</div>
				<div>
					<p class="footer-heading">Body of work</p>
					<ul><li>Well-Formed Teams</li><li>Agility</li><li>Scrum</li><li>Publications</li><li>Tales of the Grip</li></ul>
				</div>
				<div>
					<p class="footer-heading">Company</p>
					<ul><li>Contact</li><li>Privacy</li><li>Terms</li></ul>
				</div>
			</div>
			<div class="shell footer-bottom"><span>Bound what you can. Act locally. Observe the effects. Learn.</span><span>Copyright &copy; 3Back 2026</span></div>
		</footer>
	</body>
</html>

<style is:global>
	:root {
		--paper: #f5f0e7;
		--reading: #fcfaf6;
		--charcoal: #1d2421;
		--slate: #68726d;
		--amber: #d96b18;
		--amber-wash: #f4dfce;
		--rule: #d8d1c6;
		--font: "Source Sans 3", "Segoe UI", Arial, sans-serif;
		--shell: min(1180px, calc(100vw - 48px));
	}

	* { box-sizing: border-box; }
	html { scroll-behavior: smooth; }
	body {
		margin: 0;
		background: var(--paper);
		color: var(--charcoal);
		font-family: var(--font);
		font-size: 17px;
		line-height: 1.55;
		-webkit-font-smoothing: antialiased;
	}

	a { color: inherit; }
	button, a { font: inherit; }
	button { cursor: pointer; }
	p, h1, h2, h3, blockquote { margin-top: 0; }
	h1, h2, h3 { letter-spacing: -0.035em; line-height: 1.04; }
	h1 { font-size: clamp(3.2rem, 5.5vw, 5.5rem); font-weight: 700; margin-bottom: 34px; max-width: 980px; }
	h1 em { color: var(--slate); font-style: normal; }
	h2 { font-size: clamp(2.35rem, 4vw, 4.5rem); margin-bottom: 24px; }
	h3 { font-size: 1.42rem; margin-bottom: 12px; }

	.shell { width: var(--shell); margin-inline: auto; }
	.section { padding: 110px 0; }
	.section-rule { border-bottom: 1px solid var(--rule); }
	.skip-link { position: fixed; top: 12px; left: 12px; z-index: 100; padding: 10px 15px; background: var(--amber); color: var(--charcoal); font-weight: 700; transform: translateY(-150%); }
	.skip-link:focus { transform: translateY(0); }

	.site-header { position: sticky; top: 0; z-index: 50; background: color-mix(in srgb, var(--paper) 94%, transparent); border-bottom: 1px solid var(--rule); backdrop-filter: blur(12px); }
	.header-inner { min-height: 86px; display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 36px; }
	.wordmark { font-size: 1.75rem; font-weight: 800; letter-spacing: -0.055em; line-height: 1; }
	.wordmark span { color: var(--amber); }
	.descriptor { margin-top: 7px; color: var(--slate); font-size: 0.62rem; font-weight: 700; letter-spacing: 0.13em; text-transform: uppercase; }
	.desktop-nav { display: flex; justify-content: center; gap: clamp(14px, 2.2vw, 34px); color: #3f4844; font-size: 0.83rem; font-weight: 600; }
	.desktop-nav span { white-space: nowrap; }

	.button { display: inline-flex; align-items: center; justify-content: center; min-height: 50px; padding: 12px 19px; border: 2px solid var(--amber); background: var(--amber); color: var(--charcoal); font-weight: 750; text-decoration: none; transition: background-color 140ms ease, color 140ms ease, transform 140ms ease; }
	.button:hover { background: var(--charcoal); border-color: var(--charcoal); color: var(--paper); transform: translateY(-2px); }
	.button:focus-visible, .text-link:focus-visible { outline: 3px solid var(--amber); outline-offset: 4px; }
	.button-small { min-height: 42px; padding: 8px 14px; font-size: 0.82rem; }
	.button-row { display: flex; gap: 26px; align-items: center; flex-wrap: wrap; }
	.text-link { font-weight: 700; text-decoration: underline; text-decoration-color: var(--amber); text-decoration-thickness: 2px; text-underline-offset: 6px; }
	.text-link:hover { color: var(--amber); }

	.eyebrow { margin-bottom: 24px; color: var(--amber); font-size: 0.76rem; font-weight: 800; letter-spacing: 0.16em; text-transform: uppercase; }
	.eyebrow span { margin-inline: 8px; color: var(--slate); }
	.eyebrow-light { color: #f5aa70; }
	.hero { padding: 96px 0 105px; }
	.hero-grid { display: grid; grid-template-columns: minmax(0, 1fr) 260px; gap: clamp(45px, 7vw, 110px); align-items: end; }
	.hero-intro { max-width: 760px; margin-bottom: 36px; color: #4b5550; font-size: clamp(1.1rem, 1.5vw, 1.28rem); }
	.hero-aside { padding-left: 24px; border-left: 4px solid var(--amber); color: var(--slate); font-size: 0.88rem; }
	.hero-aside p:last-child { margin-bottom: 0; }
	.aside-label { margin: 26px 0 10px; color: var(--charcoal); font-weight: 800; }
	.boundary-window { position: relative; aspect-ratio: 1; border: 1px solid var(--rule); background: var(--reading); overflow: hidden; }
	.boundary-inner { position: absolute; inset: 19%; border: 2px solid var(--charcoal); }
	.signal-dot, .result-dot { position: absolute; width: 14px; height: 14px; border-radius: 50%; top: 50%; transform: translateY(-50%); }
	.signal-dot { left: -29%; background: var(--amber); }
	.result-dot { right: -29%; border: 2px solid var(--charcoal); background: var(--paper); }
	.boundary-path { position: absolute; left: -18%; right: -18%; top: 50%; border-top: 2px solid var(--charcoal); }
	.boundary-path::after { content: ""; position: absolute; right: -2px; top: -5px; width: 8px; height: 8px; border-top: 2px solid var(--charcoal); border-right: 2px solid var(--charcoal); transform: rotate(45deg); }

	.section-heading { margin-bottom: 58px; }
	.split-heading { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(280px, 0.65fr); gap: clamp(45px, 8vw, 120px); align-items: end; }
	.split-heading h2 { max-width: 760px; }
	.lead-copy { color: var(--slate); font-size: 1.08rem; }
	.narrow-heading { max-width: 820px; }

	.diagnostic-grid { display: grid; grid-template-columns: repeat(4, 1fr); margin: 0; padding: 0; border-top: 4px solid var(--charcoal); border-bottom: 1px solid var(--rule); list-style: none; }
	.diagnostic-grid li { min-height: 285px; padding: 28px 26px 30px 0; border-right: 1px solid var(--rule); }
	.diagnostic-grid li:not(:first-child) { padding-left: 26px; }
	.diagnostic-grid li:last-child { border-right: 0; }
	.item-number, .approach-number { display: block; margin-bottom: 48px; color: var(--amber); font-size: 0.72rem; font-weight: 800; letter-spacing: 0.13em; }
	.diagnostic-grid p { color: var(--slate); font-size: 0.92rem; }
	.closing-line { max-width: 810px; margin: 40px 0 0 auto; padding-left: 25px; border-left: 3px solid var(--amber); font-size: 1.18rem; }

	.grip-section { padding: 110px 0; background: var(--charcoal); color: var(--paper); }
	.grip-grid { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(370px, 0.9fr); gap: clamp(60px, 9vw, 140px); align-items: center; }
	.grip-copy h2 { max-width: 760px; }
	.grip-body { max-width: 730px; color: #c5cbc7; column-count: 2; column-gap: 38px; }
	.grip-body p { break-inside: avoid; }
	.operating-line { margin-top: 40px; padding-top: 18px; border-top: 2px solid var(--amber); font-size: 1.13rem; font-weight: 750; }
	.grip-diagram { padding: 28px; border: 1px solid #53605a; background: #222b27; }
	.diagram-question { margin-bottom: 35px; color: #f5aa70; font-size: 0.76rem; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; }
	.diagram-stage { min-height: 300px; display: grid; grid-template-columns: 1fr 70px 0.62fr; align-items: center; }
	.local-boundary { position: relative; aspect-ratio: 1; display: grid; place-items: center; border: 2px solid var(--paper); }
	.diagram-label { position: absolute; top: 10px; left: 12px; color: #9ba49f; font-size: 0.68rem; }
	.local-action { width: 42%; aspect-ratio: 1; display: grid; place-items: center; background: var(--amber); color: var(--charcoal); text-align: center; font-size: 0.8rem; font-weight: 800; line-height: 1.1; }
	.effect-line { display: flex; align-items: center; }
	.effect-line span { width: 20px; height: 2px; margin-right: 4px; background: #8a948f; }
	.effect-line span:last-child { background: var(--amber); }
	.downstream { display: grid; place-items: center; min-height: 92px; border: 1px dashed #89928e; color: #c5cbc7; text-align: center; font-size: 0.8rem; line-height: 1.2; }

	.loop-section { background: var(--reading); }
	.loop-flow { display: grid; grid-template-columns: repeat(5, 1fr); margin: 0; padding: 0; border-top: 4px solid var(--charcoal); border-bottom: 1px solid var(--rule); list-style: none; }
	.loop-flow li { position: relative; min-height: 145px; padding: 24px 22px; border-right: 1px solid var(--rule); background: var(--reading); }
	.loop-flow li::after { content: ""; position: absolute; top: 50%; right: -6px; z-index: 2; width: 10px; height: 10px; border-top: 2px solid var(--charcoal); border-right: 2px solid var(--charcoal); background: var(--reading); transform: translateY(-50%) rotate(45deg); }
	.loop-flow li:last-child { border-right: 0; }
	.loop-flow li:last-child::after { display: none; }
	.loop-flow span { display: block; margin-bottom: 42px; color: var(--amber); font-size: 0.7rem; font-weight: 800; letter-spacing: 0.1em; }
	.loop-flow strong { display: block; line-height: 1.15; }
	.loop-flow .signal-step { background: var(--amber-wash); }
	.loop-flow .signal-step::after { background: var(--amber-wash); }
	.loop-note { max-width: 890px; margin: 45px 0 0 auto; color: var(--slate); }

