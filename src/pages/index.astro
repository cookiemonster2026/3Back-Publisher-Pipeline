---
import SiteLayout from "../layouts/SiteLayout.astro";
import { Image } from "astro:assets";
import bowtiePreview from "../assets/papers/bowtie-figure-1-muted.jpg";
import learningPreview from "../assets/homepage/learning-paper-tile.png";
import booksPreview from "../assets/homepage/bookshelf-illustration.png";
import { publishedTalesStrips } from "../data/tales-of-the-grip.mjs";
import { talesStripHomepagePreviews } from "../data/tales-of-the-grip-assets";
import { HOMEPAGE_OPERATIONAL_GRIP_EXPLANATION, pageSeo } from "../seo/registry.mjs";
const latestStrip = publishedTalesStrips[0];
const latestPreview = talesStripHomepagePreviews[latestStrip.slug];
---

<SiteLayout metadata={pageSeo["/"]}>
  <main id="main" class="homepage">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow">Team execution under pressure</p>
        <h1 id="hero-title">Organizations do not outgrow teams.</h1>
        <p class="hero-thesis">They lose the boundaries that focus human expertise and AI capability on outcomes the organization needs.</p>

        <div class="hero-actions">
          <div class="grip-action">
            <a class="button primary" href="/grip-check/" aria-describedby="grip-duration">Check your grip <span class="link-arrow" aria-hidden="true">↗</span></a>
            <p id="grip-duration">About 7 minutes · Get your scores</p>
          </div>
          <a class="text-link" href="#engage"><span class="link-label">See ways to engage</span><span class="link-arrow" aria-hidden="true">↓</span></a>
        </div>
      </div>

      <aside class="selection-card" aria-label="How AI changes the execution constraint">
        <p class="card-index">The pressure has moved</p>
        <h2>Teamwork with AI expands what is possible and how quickly it can be explored.</h2>
        <p>As possibilities become less costly to produce, the constraint shifts toward <strong>selection.</strong></p>

        <div class="selection-diagram" tabindex="0" role="img" aria-label="Possibilities pass through teamwork with AI and domain-guided selection toward outcomes.">
          <svg class="diagram-lines" viewBox="0 0 560 250" preserveAspectRatio="none" aria-hidden="true" focusable="false">
            <g class="possibility-lines" fill="none">
              <path d="M8 35 C100 35 140 80 230 90"/><path d="M8 70 C100 70 145 95 230 107"/>
              <path d="M8 105 C100 105 150 112 230 123"/><path d="M8 140 C100 140 150 138 230 138"/>
              <path d="M8 175 C100 175 145 155 230 154"/><path d="M8 210 C100 210 140 180 230 170"/>
            </g>
          </svg>
          <span class="selected-line" aria-hidden="true"></span>
          <span class="result-dot" aria-hidden="true"></span>
          <span class="outer-label possibilities-label" aria-hidden="true">Possibilities</span>
          <span class="outer-label outcomes-label" aria-hidden="true">Outcomes</span>
          <div class="team-boundary" aria-hidden="true">
            <span class="box-label">Teamwork with AI</span>
            <span class="box-plus">+</span>
            <span class="box-label">Domain-guided<br/>selection</span>
          </div>
        </div>

        <div class="team-line">
          <p class="service-statement">3Back helps leaders work through a bounded execution problem and build the capability to handle the next one.</p>
        </div>
        <a class="card-link" href="#why-3back"><span class="link-label">Why 3Back</span><span class="link-arrow" aria-hidden="true">↓</span></a>
      </aside>
    </section>

    <section class="grip" id="grip" aria-labelledby="grip-title">
      <div class="section-intro">
        <p class="eyebrow">Operational Grip</p>
        <h2 id="grip-title">Can the people closest to the work make a local change whose effects stay observable and correctable?</h2>
        <div class="section-intro-copy">
          <p class="operational-grip-explanation">{HOMEPAGE_OPERATIONAL_GRIP_EXPLANATION}</p>
          <a class="section-cta" href="/operational-grip/"><span class="link-label">Explore Operational Grip</span><span class="link-arrow" aria-hidden="true">→</span></a>
        </div>
      </div>

      <p class="signals-label" id="signals-title">Four signals of Operational Grip</p>
      <div class="grip-signals" aria-labelledby="signals-title">
        <article tabindex="0">
          <span>01</span>
          <h3>Legible demand</h3>
          <p>The team can separate what matters now from surrounding noise.</p>
        </article>
        <article tabindex="0">
          <span>02</span>
          <h3>Guided selection</h3>
          <p>People with domain expertise can select and act without permission theater.</p>
        </article>
        <article tabindex="0">
          <span>03</span>
          <h3>Bounded failure</h3>
          <p>Experiments can teach without exposing the whole system.</p>
        </article>
        <article tabindex="0">
          <span>04</span>
          <h3>Visible results</h3>
          <p>Evidence from the work shows whether activity became progress.</p>
        </article>
      </div>
    </section>

    <section class="engage" id="engage" aria-labelledby="engage-title">
      <div class="engage-heading">
        <p class="eyebrow">How to engage</p>
        <h2 id="engage-title">One problem.<br>Three ways to engage.</h2>
      </div>

      <div class="engage-list">
        <a href="/grip-check/" class="engage-row featured">
          <div>
            <p class="verb">Assess it</p>
            <h3>Check your operational grip</h3>
            <p>See where coordination is holding and where it is losing control.</p>
          </div>
          <span class="arrow" aria-hidden="true">↗</span>
        </a>
        <a href="/workshops/" class="engage-row">
          <div>
            <p class="verb">Work it</p>
            <h3>Workshop a bounded problem</h3>
            <p>Bring one difficult, live problem. Work with 3Back to expose the constraint, test bounded changes, and identify what improves execution.</p>
          </div>
          <span class="arrow" aria-hidden="true">↗</span>
        </a>
        <a href="/domain-guides/" class="engage-row">
          <div>
            <p class="verb">Keep the capability</p>
            <h3>Build your Domain Guides program</h3>
            <p>Your people learn inside the work, exercise judgment, and develop the next cohort.</p>
          </div>
          <span class="arrow" aria-hidden="true">↗</span>
        </a>
      </div>
    </section>

    <section class="credibility" id="why-3back" aria-labelledby="credibility-title">
      <div class="credibility-lead">
        <p class="eyebrow">Why 3Back</p>
        <h2 id="credibility-title">Experience accumulates through difficult, real work.</h2>
        <p>For nearly three decades, 3Back has worked alongside teams in complex operating environments, helping them examine execution, make bounded changes, and develop capability without pretending to own their domain.</p>
        <div class="credibility-links">
          <a href="/about-us/"><span class="link-label">About 3Back</span><span class="link-arrow" aria-hidden="true">→</span></a>
          <a href="/reviews/"><span class="link-label">Reviews</span><span class="link-arrow" aria-hidden="true">→</span></a>
        </div>
      </div>
      <div class="credibility-evidence">
        <article>
          <span>Range</span>
          <h3>Complex operating environments</h3>
          <p>Aerospace, medical systems, defense and intelligence, manufacturing, technology, and other environments where abstract answers do not survive for long.</p>
        </article>
        <article>
          <span>Body of work</span>
          <h3>Teams and execution</h3>
          <p>Team formation, decision ownership, adaptation, coordination, and the conditions required to deliver value.</p>
        </article>
        <article>
          <span>Posture</span>
          <h3>Capability stays inside</h3>
          <p>Begin with live work. Preserve what works. Make bounded changes. Develop judgment and leave the capability in the organization.</p>
        </article>
      </div>
    </section>

    <section class="current-ideas" id="current-ideas" aria-labelledby="ideas-title">
      <h2 id="ideas-title">Current ideas</h2>
      <div class="ideas-cards">
        <a class="idea-card tales-card" href={`${latestStrip.path}/`}>
          <p class="eyebrow">Latest Tales of the Grip</p>
          <Image src={latestPreview} alt={`Preview of ${latestStrip.title}`} widths={[320, 480, 640]} sizes="(max-width: 680px) calc(100vw - 96px), 280px" loading="lazy" />
          <h3>{latestStrip.title}</h3>
          <p>Humor to start tough conversations.</p>
          <span class="idea-action"><span class="link-label">Read the strip</span><span class="link-arrow" aria-hidden="true">→</span></span>
        </a>
        <a class="idea-card" href="/papers/no-head-works-alone/">
          <p class="eyebrow">Paper</p>
          <Image src={bowtiePreview} alt="Judgments converge on one overloaded decision maker; direction spreads outward." widths={[320, 480, 640]} sizes="(max-width: 680px) calc(100vw - 96px), 280px" loading="lazy" />
          <h3>No Head Works Alone</h3>
          <p>Understanding overloaded decision-making.</p>
          <span class="idea-action"><span class="link-label">Read the paper</span><span class="link-arrow" aria-hidden="true">→</span></span>
        </a>
        <a class="idea-card" href="/papers/how-3back-approaches-learning/">
          <p class="eyebrow">Paper</p>
          <Image src={learningPreview} alt="How 3Back Approaches Learning: Judgment, Action, Evidence." widths={[320, 480, 640]} sizes="(max-width: 680px) calc(100vw - 96px), 280px" loading="lazy" />
          <h3>How 3Back Approaches Learning</h3>
          <p>How understanding develops into capability through judgment, action, and evidence.</p>
          <span class="idea-action"><span class="link-label">Read the paper</span><span class="link-arrow" aria-hidden="true">→</span></span>
        </a>
        <a class="idea-card" href="/ideas/#books-title">
          <p class="eyebrow">Books</p>
          <Image src={booksPreview} alt="Illustrated bookshelf of 3Back titles, with Operational Grip marked Coming Soon." widths={[320, 480, 640]} sizes="(max-width: 680px) calc(100vw - 96px), 280px" loading="lazy" />
          <h3>The published collection</h3>
          <p>Operational Grip · Coming soon.</p>
          <span class="idea-action"><span class="link-label">Explore books</span><span class="link-arrow" aria-hidden="true">→</span></span>
        </a>
      </div>
    </section>
  </main>
</SiteLayout>

<style>
/* Homepage composition; typography and palette inherit the production system. */
.homepage { overflow-wrap: break-word; }
.homepage section[id] { scroll-margin-top: 110px; }
.hero { min-height: calc(100vh - 86px); padding: clamp(62px, 8vw, 130px) max(24px, calc((100vw - 1180px) / 2)) clamp(72px, 9vw, 144px); display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(360px, .85fr); gap: clamp(40px, 5vw, 80px); align-items: center; border-bottom: 1px solid var(--rule); }
.eyebrow, .card-index, .verb { margin: 0 0 24px; font-size: var(--type-body); font-weight: var(--font-weight-heavy); line-height: var(--leading-lead); text-transform: uppercase; letter-spacing: var(--tracking-caption); color: var(--amber-text); }
h1 { margin-bottom: 22px; }
.hero-thesis { margin-bottom: 42px; color: var(--text-secondary); font-size: clamp(1.45rem, 2.4vw, 2.6rem); line-height: var(--leading-heading); letter-spacing: var(--tracking-heading); font-weight: var(--font-weight-semibold); }
.hero-actions { display: flex; align-items: flex-start; gap: 28px; flex-wrap: wrap; }
.hero-actions > .text-link { margin-top: 18px; }
.grip-action p { margin: 10px 0 0; font-size: var(--type-body); line-height: var(--leading-card); color: var(--text-secondary); }
.button { gap: 28px; }
.button .link-arrow { flex: 0 0 auto; }
.text-link, .section-cta, .credibility-links a { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; font-weight: var(--font-weight-bold); }
.text-link { color: var(--charcoal); }
.text-link:hover, .text-link:focus-visible { color: var(--amber-text); }
.link-label { text-decoration: underline; text-underline-offset: 5px; text-decoration-thickness: 1px; }
.link-arrow, .arrow { display: inline-block; text-decoration: none; transition: transform 160ms ease-out; }
.section-cta:hover .link-arrow, .section-cta:focus-visible .link-arrow, .credibility-links a:hover .link-arrow, .credibility-links a:focus-visible .link-arrow { transform: translateX(3px); }
.text-link:hover .link-arrow, .text-link:focus-visible .link-arrow, .card-link:hover .link-arrow, .card-link:focus-visible .link-arrow { transform: translateY(3px); }
.button:hover .link-arrow, .button:focus-visible .link-arrow, .engage-row:hover .arrow, .engage-row:focus-visible .arrow { transform: translate(3px, -3px); }
.selection-card { min-width: 0; padding: clamp(24px, 3vw, 44px); color: var(--reading); background: var(--charcoal); box-shadow: 18px 18px 0 var(--amber); position: relative; }
.selection-card::before { content: ""; width: 10px; height: 10px; background: var(--amber); position: absolute; top: 0; left: 0; }
.selection-card .card-index { color: var(--amber); margin-bottom: 20px; }
.selection-card h2 { margin-bottom: 22px; font-size: clamp(1.65rem, 2.7vw, 3rem); line-height: var(--leading-heading); letter-spacing: var(--tracking-heading); }
.selection-card > p:not(.card-index) { max-width: 620px; margin-bottom: 24px; color: var(--paper); font-size: var(--type-lead); line-height: var(--leading-lead); }
.selection-diagram { position: relative; width: 100%; height: 250px; margin: 8px 0 28px; }
.diagram-lines { position: absolute; inset: 0; width: 100%; height: 100%; }
.possibility-lines { stroke: var(--slate); stroke-width: 2; stroke-dasharray: 4 6; }
.selected-line { position: absolute; top: 50%; left: 45%; right: 20px; height: 2px; background: var(--reading); }
.result-dot { position: absolute; top: calc(50% - 4px); right: 15px; width: 10px; height: 10px; border-radius: 50%; background: var(--amber); }
.team-boundary { position: absolute; top: 50%; left: 45%; width: max-content; transform: translate(-50%, -50%); padding: 12px; border: 2px solid var(--amber); background: var(--charcoal); display: grid; align-content: center; justify-items: center; gap: 10px; text-align: center; }
.box-label { color: var(--reading); font-size: var(--type-body); font-weight: var(--font-weight-heavy); line-height: var(--leading-caption); }
.box-plus { color: var(--amber); font-size: 1.35rem; font-weight: var(--font-weight-heavy); line-height: 1; }
.outer-label { position: absolute; color: var(--paper); font-size: var(--type-caption); font-weight: var(--font-weight-bold); line-height: var(--leading-caption); }
.possibilities-label { bottom: 0; left: 0; }
.outcomes-label { right: -12px; top: calc(50% - 40px); width: 64px; text-align: center; }
@media (min-width: 681px) {
  .team-boundary, .selected-line { left: calc(45% + 20px); }
}
@media (min-width: 681px) and (hover: hover) and (pointer: fine) {
  .team-boundary { transition: transform 200ms ease, background-color 200ms ease; }
  .team-boundary:hover, .selection-diagram:focus-visible .team-boundary { transform: translate(-50%, -50%) scale(1.16); background: var(--amber); }
  .team-boundary:hover .box-label, .team-boundary:hover .box-plus, .selection-diagram:focus-visible .box-label, .selection-diagram:focus-visible .box-plus { color: var(--charcoal); }
  .selection-diagram:has(.team-boundary:hover) .outer-label, .selection-diagram:focus-visible .outer-label { visibility: hidden; }
}
.team-line { padding-top: 26px; border-top: 1px solid var(--slate); }
.service-statement { margin: 0; color: var(--reading); font-size: var(--type-body); font-weight: var(--font-weight-semibold); line-height: var(--leading-card); }
.card-link { display: inline-flex; justify-content: space-between; width: 100%; margin-top: 25px; padding-top: 19px; border-top: 1px solid var(--slate); color: var(--amber); font-size: var(--type-body); font-weight: var(--font-weight-heavy); letter-spacing: var(--tracking-caption); text-transform: uppercase; text-decoration: none; }
.card-link:hover, .card-link:focus-visible { color: var(--paper); }
.grip, .engage, .credibility { padding: clamp(72px, 9vw, 144px) max(24px, calc((100vw - 1180px) / 2)); }
.grip { background: var(--reading); }
.section-intro { display: grid; grid-template-columns: minmax(100px, .35fr) minmax(0, 1.2fr) minmax(240px, .65fr); gap: clamp(28px, 4vw, 64px); align-items: start; }
.section-intro h2, .engage-heading h2 { margin-bottom: 0; }
.section-intro-copy p { margin: 4px 0 0; color: var(--text-secondary); font-size: var(--type-lead); line-height: var(--leading-lead); }
.section-cta { margin-top: 28px; gap: 18px; color: var(--amber-text); }
.section-cta:hover, .section-cta:focus-visible { color: var(--charcoal); }
.signals-label { margin: clamp(64px, 8vw, 120px) 0 18px; color: var(--amber-text); font-size: var(--type-body); font-weight: var(--font-weight-heavy); letter-spacing: var(--tracking-caption); line-height: var(--leading-lead); text-align: center; text-transform: uppercase; }
.grip-signals { border-top: 1px solid var(--charcoal); display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); }
.grip-signals article { min-height: 245px; padding: 22px 24px 28px; border-right: 1px solid var(--rule); transition: background-color 160ms ease, box-shadow 160ms ease, transform 160ms ease; }
.grip-signals article:last-child { border-right: 0; }
.grip-signals article:hover, .grip-signals article:focus-visible { background: var(--amber-wash); box-shadow: inset 0 3px 0 var(--amber); transform: translateY(-4px); }
.grip-signals span { color: var(--amber-text); font-size: var(--type-body); font-weight: var(--font-weight-heavy); letter-spacing: var(--tracking-caption); }
.grip-signals h3 { margin: 46px 0 14px; }
.grip-signals p { margin: 0; color: var(--text-secondary); font-size: var(--type-card); line-height: var(--leading-card); }
.engage { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: clamp(40px, 7vw, 100px); border-top: 1px solid var(--rule); }
.engage-heading { align-self: start; position: sticky; top: 120px; }
.engage-list { border-top: 1px solid var(--charcoal); }
.engage-row { padding: 28px; border-bottom: 1px solid var(--rule); display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 24px; color: inherit; text-decoration: none; transition: background-color 160ms ease; }
.engage-row .verb { margin-bottom: 12px; }
.engage-row h3 { margin-bottom: 14px; }
.engage-row p:last-child { margin: 0; color: var(--text-secondary); font-size: var(--type-card); line-height: var(--leading-card); }
.engage-row .arrow { font-size: 1.5rem; color: var(--amber-text); }
.engage-row:hover, .engage-row:focus-visible { background: var(--amber-wash); }
.credibility { display: grid; gap: clamp(48px, 7vw, 90px); background: var(--reading); border-top: 1px solid var(--rule); }
.credibility-lead h2 { max-width: 760px; margin-bottom: 28px; }
.credibility-lead > p:not(.eyebrow) { max-width: 650px; color: var(--text-secondary); font-size: var(--type-lead); line-height: var(--leading-lead); }
.credibility-links { margin-top: 34px; display: flex; gap: 28px; flex-wrap: wrap; }
.credibility-links a { color: var(--amber-text); }
.credibility-links a:hover, .credibility-links a:focus-visible { color: var(--charcoal); }
.credibility-evidence { border-top: 1px solid var(--charcoal); }
.credibility-evidence article { padding: 30px 0 34px; border-bottom: 1px solid var(--rule); display: grid; grid-template-columns: 120px minmax(180px, .75fr) minmax(240px, 1fr); gap: 28px; align-items: start; }
.credibility-evidence span { color: var(--amber-text); font-size: var(--type-body); font-weight: var(--font-weight-heavy); letter-spacing: var(--tracking-caption); text-transform: uppercase; }
.credibility-evidence h3, .credibility-evidence p { margin: 0; }
.credibility-evidence p { color: var(--text-secondary); }
.current-ideas { padding: clamp(64px, 7vw, 100px) max(24px, calc((100vw - 1180px) / 2)); border-top: 1px solid var(--rule); border-bottom: 5px solid var(--amber); }
.current-ideas h2 { margin-bottom: 32px; }
.ideas-cards { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 20px; }
.idea-card { display: flex; flex-direction: column; min-width: 0; padding: 24px; border: 1px solid var(--rule); border-top: 3px solid var(--amber); color: var(--charcoal); background: var(--reading); text-decoration: none; }
.idea-card:hover, .idea-card:focus-visible { background: var(--amber-wash); }
.idea-card .eyebrow { margin-bottom: 20px; min-height: 3em; }
.idea-card h3 { margin: 0 0 20px; }
.idea-card > p:not(.eyebrow) { font-size: var(--type-body); line-height: var(--leading-card); }
.idea-card img { display: block; width: 100%; height: auto; aspect-ratio: 3 / 2; object-fit: contain; margin-bottom: 20px; }
.idea-action { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: auto; padding-top: 20px; color: var(--amber-text); font-weight: var(--font-weight-bold); }
.idea-card:hover .link-arrow, .idea-card:focus-visible .link-arrow { transform: translateX(3px); }
@media (max-width: 1050px) {
  .ideas-cards { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .hero { grid-template-columns: 1fr; }
  .hero-copy { max-width: 900px; }
  .selection-card { width: 100%; max-width: 760px; justify-self: center; }
  .section-intro { grid-template-columns: 1fr; gap: 20px; }
  .section-intro .eyebrow { margin-bottom: 6px; }
  .section-intro-copy { max-width: 700px; }
  .grip-signals { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .grip-signals article:nth-child(2) { border-right: 0; }
  .grip-signals article:nth-child(n+3) { border-top: 1px solid var(--rule); }
  .engage { grid-template-columns: 1fr; }
  .engage-heading { position: static; }
}
@media (max-width: 680px) {
  .ideas-cards { grid-template-columns: 1fr; }
  .hero-actions > .text-link { margin-top: 0; }
  .hero { min-height: auto; padding-top: 62px; }
  .hero-thesis { font-size: 1.45rem; }
  .hero-actions { align-items: flex-start; flex-direction: column; }
  .selection-card { width: calc(100% - 7px); box-shadow: 7px 7px 0 var(--amber); padding: 24px 16px; }
  .team-line { grid-template-columns: 1fr; }
  .grip-signals { grid-template-columns: 1fr; }
  .grip-signals article { min-height: auto; padding: 24px 20px 32px; border-right: 0; border-top: 1px solid var(--rule); }
  .grip-signals article:first-child { border-top: 0; }
  .grip-signals h3 { margin-top: 22px; }
  .engage-row { padding: 24px 20px; gap: 12px; }
  .credibility-evidence article { grid-template-columns: 1fr; gap: 10px; }
}
@media (prefers-reduced-motion: reduce) {
  .homepage *, .homepage *::before, .homepage *::after { transition: none !important; animation: none !important; }
  .team-boundary:hover, .selection-diagram:focus-visible .team-boundary { transform: translate(-50%, -50%); }
  .grip-signals article:hover, .grip-signals article:focus-visible, .button:hover, .link-arrow, .arrow { transform: none !important; }
}

</style>
