---
import { Image } from "astro:assets";
import SiteLayout from "../layouts/SiteLayout.astro";
import { pageSeo } from "../seo/registry.mjs";
import cover from "../assets/scrum-101/scrum-101-cover.png";
---

<SiteLayout metadata={pageSeo["/scrum-101"]}>
	<main id="main" class="scrum-101-page">
		<section class="scrum-101-opening">
			<div class="shell column">
				<figure class="cover"><Image src={cover} alt="Cover of Scrum 101: A Pocket Guide" layout="constrained" widths={[180, 360]} sizes="180px" /></figure>
				<h1>Scrum 101: A Pocket Guide</h1>
				<p class="label">How 3Back taught Scrum prior to 2024.</p>
				<p>This pocket guide is an older way of thinking. It is not 3Back’s current operating doctrine.</p>
				<p>3Back is the Team Execution Company. The current lens is Operational Grip: bound what you can, act locally, observe the effects, and learn.</p>
				<p>Use this guide to learn Scrum as it was taught then. Use Operational Grip when the question is where execution has lost its hold.</p>
				<p>Authors: Doug Shimp, Dan Rawsthorne, Marcelo Lopez, and Jan Beaver.</p>
				<p class="actions"><a class="download" href="/scrum-101/Scrum-101-A-Pocket-Guide.pdf">Download the PDF</a></p>
				<p class="links"><a href="/operational-grip">Operational Grip</a><span aria-hidden="true"> · </span><a href="/about-us">About</a></p>
			</div>
		</section>
	</main>
</SiteLayout>

<style>
	.scrum-101-opening { padding: 112px 0 96px; }
	.column { max-width: 640px; }
	.cover { width: 180px; margin: 0 0 32px; padding: 0; }
	.cover :global(img) { display: block; width: 180px; height: auto; border: 1px solid var(--rule); }
	.scrum-101-opening h1 { margin-bottom: 12px; font-size: clamp(2.4rem, 5vw, 3.4rem); }
	.label { margin-bottom: 28px; color: var(--text-secondary); font-size: var(--type-caption); font-weight: var(--font-weight-semibold); letter-spacing: 0.02em; }
	.column p { max-width: 38em; color: var(--charcoal); font-size: 1.0625rem; line-height: 1.6; }
	.column p + p { margin-top: 14px; }
	.actions { margin: 32px 0 22px; }
	.download { display: inline-flex; align-items: center; min-height: 46px; padding: 10px 16px; border: 1px solid var(--charcoal); background: var(--paper); color: var(--charcoal); font-weight: var(--font-weight-semibold); text-decoration: none; }
	.download:hover { background: var(--charcoal); color: var(--paper); }
	.links { color: var(--text-secondary); font-size: 1rem; }
	.links a { color: var(--charcoal); font-weight: var(--font-weight-semibold); text-decoration-color: var(--amber); text-decoration-thickness: 2px; text-underline-offset: 4px; }
	@media (max-width: 720px) {
		.scrum-101-opening { padding: 82px 0 72px; }
		.cover, .cover :global(img) { width: 140px; }
	}
</style>
