---
import SiteLayout from "../layouts/SiteLayout.astro";

interface Props {
	name: string;
	description: string;
}

const { name, description } = Astro.props;
---

<SiteLayout title={`${name} | 3Back`} description={description}>
	<main id="main" class="stub-page">
		<div class="shell stub-content">
			<h1><span>STUB:</span> {name}</h1>
			<p>{description}</p>
		</div>
	</main>
</SiteLayout>

<style>
	.stub-page { min-height: 62vh; background: var(--paper); }
	.stub-content { padding-block: clamp(88px, 12vw, 150px); }
	h1 { margin-bottom: 28px; color: var(--amber); font-weight: 700; }
	h1 span { color: var(--charcoal); }
	p { max-width: 820px; margin-bottom: 0; color: var(--slate); font-weight: 400; font-size: clamp(1.5rem, 2vw, 1.65rem); }
</style>
