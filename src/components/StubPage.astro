---
import SiteLayout from "../layouts/SiteLayout.astro";
import type { SeoMetadata } from "../seo/types";

interface Props {
	name: string;
	description: string;
	metadata: SeoMetadata;
}

const { name, description, metadata } = Astro.props;
if (metadata.status !== "stub") throw new Error(`StubPage requires stub SEO metadata for ${metadata.path}.`);
---

<SiteLayout metadata={metadata}>
	<main id="main" class="stub-page">
		<div class="shell stub-content">
			<h1><span>STUB:</span> {name}</h1>
			<p>{description}</p>
		</div>
	</main>
</SiteLayout>

<style>
	.stub-page { min-height: 62vh; background: var(--paper); }
	.stub-content { padding-block: clamp(88px, 12vw, 150px); }
	h1 { margin-bottom: 28px; color: var(--amber); font-weight: var(--font-weight-bold); }
	h1 span { color: var(--charcoal); }
	p { max-width: 820px; margin-bottom: 0; color: var(--text-secondary); font-size: var(--type-lead); font-weight: var(--font-weight-regular); line-height: var(--leading-lead); }
</style>
