---
const currentPath = Astro.url.pathname;
---

<header class="site-header">
	<div class="shell header-inner">
		<a class="brand-lockup" href="/" aria-label="3Back homepage">
			<div class="wordmark"><span>3</span>Back</div>
			<div class="descriptor">The Team Execution Company</div>
		</a>

		<nav class="desktop-nav" aria-label="Primary navigation">
			<a href="/operational-grip/" aria-current={currentPath === "/operational-grip/" ? "page" : undefined}>Operational Grip</a>
			<a href="/ideas/" aria-current={currentPath === "/ideas/" ? "page" : undefined}>Ideas</a>
			<a href="/about/" aria-current={currentPath === "/about/" ? "page" : undefined}>About</a>
		</nav>

		<a class="button button-small" href="/contact/" aria-current={currentPath === "/contact/" ? "page" : undefined}>Start a Conversation</a>

		<button
			class="menu-toggle"
			type="button"
			aria-expanded="false"
			aria-controls="mobile-navigation"
		>
			<span class="menu-icon" aria-hidden="true"><span></span><span></span><span></span></span>
			<span>Menu</span>
		</button>

		<nav id="mobile-navigation" class="mobile-nav" aria-label="Mobile navigation" hidden>
			<a href="/operational-grip/" aria-current={currentPath === "/operational-grip/" ? "page" : undefined}>Operational Grip</a>
			<a href="/ideas/" aria-current={currentPath === "/ideas/" ? "page" : undefined}>Ideas</a>
			<a href="/about/" aria-current={currentPath === "/about/" ? "page" : undefined}>About</a>
			<a class="button button-small" href="/contact/" aria-current={currentPath === "/contact/" ? "page" : undefined}>Start a Conversation</a>
		</nav>
	</div>
</header>

<script>
	const header = document.querySelector<HTMLElement>(".site-header");
	const menuButton = header?.querySelector<HTMLButtonElement>(".menu-toggle");
	const mobileNavigation = header?.querySelector<HTMLElement>("#mobile-navigation");
	const desktopViewport = window.matchMedia("(min-width: 1001px)");

	if (menuButton && mobileNavigation) {
		const closeMenu = (returnFocus = false) => {
			menuButton.setAttribute("aria-expanded", "false");
			mobileNavigation.hidden = true;
			if (returnFocus) menuButton.focus();
		};

		const openMenu = () => {
			menuButton.setAttribute("aria-expanded", "true");
			mobileNavigation.hidden = false;
		};

		menuButton.addEventListener("click", () => {
			if (menuButton.getAttribute("aria-expanded") === "true") closeMenu();
			else openMenu();
		});

		mobileNavigation.addEventListener("click", (event) => {
			if ((event.target as HTMLElement).closest("a")) closeMenu();
		});

		document.addEventListener("keydown", (event) => {
			if (event.key === "Escape" && menuButton.getAttribute("aria-expanded") === "true") {
				event.preventDefault();
				closeMenu(true);
			}
		});

		desktopViewport.addEventListener("change", (event) => {
			if (event.matches) closeMenu();
		});
	}
</script>

<style>
	.site-header { position: sticky; top: 0; z-index: 50; background: color-mix(in srgb, var(--paper) 94%, transparent); border-bottom: 1px solid var(--rule); backdrop-filter: blur(12px); }
	.header-inner { position: relative; min-height: 86px; display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 36px; }
	.wordmark { font-size: 1.75rem; font-weight: 800; letter-spacing: -0.055em; line-height: 1; }
	.wordmark span { color: var(--amber); }
	.brand-lockup { color: inherit; text-decoration: none; }
	.descriptor { margin-top: 7px; color: var(--slate); font-size: 0.62rem; font-weight: 700; letter-spacing: 0.13em; text-transform: uppercase; }
	.desktop-nav { display: flex; justify-content: center; gap: clamp(14px, 2.2vw, 34px); color: #3f4844; font-size: 0.83rem; font-weight: 600; }
	.desktop-nav a, .desktop-nav span { white-space: nowrap; }
	.desktop-nav a { text-decoration: none; }
	.desktop-nav a:hover { color: var(--charcoal); text-decoration: underline; text-decoration-color: var(--amber); text-decoration-thickness: 2px; text-underline-offset: 6px; }
	.desktop-nav a[aria-current="page"] { text-decoration: underline; text-decoration-color: var(--amber); text-decoration-thickness: 2px; text-underline-offset: 6px; }
	.button-small { min-height: 42px; padding: 8px 14px; font-size: 0.82rem; }
	.menu-toggle, .mobile-nav { display: none; }

	@media (max-width: 1000px) {
		.desktop-nav { display: none; }
		.header-inner { grid-template-columns: 1fr auto; }
		.header-inner > .button { display: none; }
		.menu-toggle { min-height: 44px; display: inline-flex; align-items: center; gap: 9px; padding: 8px 11px; border: 2px solid var(--charcoal); background: transparent; color: var(--charcoal); font-size: 0.82rem; font-weight: 750; }
		.menu-icon { width: 19px; display: grid; gap: 4px; }
		.menu-icon span { display: block; height: 2px; background: currentColor; }
		.menu-toggle[aria-expanded="true"] { background: var(--charcoal); color: var(--paper); }
		.mobile-nav { position: absolute; top: 100%; right: 0; width: min(360px, calc(100vw - 32px)); display: grid; padding: 12px; border: 1px solid var(--rule); border-top: 4px solid var(--amber); background: var(--reading); box-shadow: 0 14px 28px rgb(29 36 33 / 16%); }
		.mobile-nav[hidden] { display: none; }
		.mobile-nav > a:not(.button), .mobile-nav > span { min-height: 45px; display: flex; align-items: center; padding: 9px 10px; border-bottom: 1px solid var(--rule); color: #3f4844; font-size: 0.93rem; font-weight: 650; text-decoration: none; }
		.mobile-nav > span { color: var(--slate); }
		.mobile-nav > a[aria-current="page"]:not(.button) { border-left: 3px solid var(--amber); }
		.mobile-nav .button { margin-top: 12px; }
		.menu-toggle:focus-visible, .mobile-nav a:focus-visible, .brand-lockup:focus-visible { outline: 3px solid var(--amber); outline-offset: 3px; }
	}

	@media (max-width: 720px) {
		.header-inner { min-height: 74px; gap: 12px; }
		.wordmark { font-size: 1.55rem; }
		.descriptor { font-size: 0.55rem; }
	}
</style>
