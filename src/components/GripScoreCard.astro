---
const { mode = "landing" } = Astro.props;
const labels=["Response to Changing Demand","Ownership and Bounded Execution","Observable and Traceable Results","Adaptation Without Loss of Control","AI Use and Control"];
const keys=["demand","ownership","results","adaptation","ai"];
---
<article class="score-card" data-grip-card={mode}><div class="score-profile"><svg class="score-ring" viewBox="0 0 520 300" aria-hidden="true"><g transform="translate(260 250)">{["M -210 0 A 210 210 0 0 1 -170 -123","M -158 -139 A 210 210 0 0 1 -65 -200","M -48 -204 A 210 210 0 0 1 48 -204","M 65 -200 A 210 210 0 0 1 158 -139","M 170 -123 A 210 210 0 0 1 210 0"].map((d,i)=><path class:list={["score-segment",mode === "landing" && "score-segment-moderate"]} data-segment={i} d={d}/>)}</g></svg><p class="score-caption" data-caption>{mode === "results" ? "Composite Grip Score" : ""}</p><p class="overall-score" data-center>{mode === "landing" ? <>Start<br />Grip Check</> : mode === "results" ? "" : "Question 1 of 20"}</p><img class="hands-bar" src="/assets/operational-grip/hands-bar.png" alt="One hand holds a bar securely while the other begins to lose its grip." /></div><div class="score-results">{labels.map((label,i)=><span class="score-result"><span class={`score-icon ${keys[i]}`}></span><span>{label}</span><strong data-percent={i} hidden></strong></span>)}</div></article>
<style>.score-card{padding:clamp(28px,4vw,48px);border-radius:16px;background:var(--reading);color:var(--charcoal)}[data-grip-card="progress"] .score-results{display:none}.score-profile{position:relative;min-width:0}.score-ring{display:block;width:100%;height:auto}.score-segment{fill:none;stroke:#d8d1c6;stroke-width:52}.score-segment-moderate{stroke:#9a4328}.hands-bar{display:block;width:100%;height:auto;margin-top:-28%}.score-caption{position:absolute;top:27%;left:50%;z-index:1;margin:0;font-weight:700;transform:translateX(-50%)}[data-grip-card="landing"] .overall-score,[data-grip-card="progress"] .overall-score{font-size:clamp(1.15rem,2.4vw,1.65rem);top:28%;white-space:nowrap}.overall-score{position:absolute;top:43%;left:50%;z-index:1;margin:0;text-align:center;font-size:clamp(4.2rem,8vw,7rem);font-weight:800;line-height:1.05;transform:translate(-50%,-50%)}.score-results{display:grid;grid-template-columns:repeat(5,1fr);border-top:4px solid var(--charcoal)}.score-result{display:grid;gap:8px;padding:14px 8px;border-right:1px solid var(--rule);font-size:.8rem;font-weight:700;text-align:center}.score-icon{width:28px;height:28px;margin:auto;background:var(--charcoal);mask:center/contain no-repeat}.demand{mask-image:url('/assets/operational-grip/icons/demand.svg')}.ownership{mask-image:url('/assets/operational-grip/icons/ownership.svg')}.results{mask-image:url('/assets/operational-grip/icons/results.svg')}.adaptation{mask-image:url('/assets/operational-grip/icons/adaptation.svg')}.ai{mask-image:url('/assets/operational-grip/icons/ai.svg')}@media(max-width:640px){.score-results{grid-template-columns:1fr}.score-result{grid-template-columns:28px 1fr;align-items:center;text-align:left}}</style>
