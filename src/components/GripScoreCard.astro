---
const { mode = "landing" } = Astro.props;
const labels=["Response to Changing Demand","Ownership and Bounded Execution","Observable and Traceable Results","Adaptation Without Loss of Control","AI Use and Control"];
const keys=["demand","ownership","results","adaptation","ai"];
---
<article class="score-card" data-grip-card={mode}><div class="score-profile"><svg class="score-ring" viewBox="0 0 520 300" aria-hidden="true"><g transform="translate(260 250)">{["M -210 0 A 210 210 0 0 1 -170 -123","M -158 -139 A 210 210 0 0 1 -65 -200","M -48 -204 A 210 210 0 0 1 48 -204","M 65 -200 A 210 210 0 0 1 158 -139","M 170 -123 A 210 210 0 0 1 210 0"].map((d,i)=><path class:list={["score-segment",mode === "landing" && "score-segment-moderate"]} data-segment={i} d={d}/>)}</g></svg><p class="score-caption" data-caption>{mode === "results" ? "Your Composite Grip Score" : ""}</p><p class="overall-score">{mode === "landing" ? <>Start<br />Grip Check</> : mode === "results" ? <><strong data-center></strong><span class="score-out-of">/100</span></> : <span data-center>Question 1 of 20</span>}</p><img class="hands-bar" src="/assets/operational-grip/hands-bar.png" alt="One hand holds a bar securely while the other begins to lose its grip." /></div><div class="score-results">{labels.map((label,i)=><span class="score-result" data-section={i} tabindex={mode === "results" ? 0 : undefined}><span class={`score-icon ${keys[i]}`}></span><span class="result-label">{label}</span><strong data-percent={i} hidden></strong><small data-strength={i} hidden></small></span>)}</div></article>
<style>.score-card{padding:clamp(28px,4vw,48px);border-radius:16px;background:var(--reading);color:var(--charcoal)}[data-grip-card="progress"] .score-results{display:none}.score-profile{position:relative;min-width:0}.score-ring{display:block;width:100%;height:auto;overflow:visible}.score-segment{fill:none;stroke:#d8d1c6;stroke-width:52;transform-box:fill-box;transform-origin:center;transition:transform 250ms ease-out,opacity 250ms ease-out,filter 250ms ease-out}.score-segment.is-active{transform:scale(1.2)}.score-card:has(.score-result[data-section="0"]:is(:hover,:focus)) .score-segment[data-segment="0"]{transform:translate(-8px,6px) scale(1.15)}.score-card:has(.score-result[data-section="1"]:is(:hover,:focus)) .score-segment[data-segment="1"]{transform:translate(-5px,-8px) scale(1.15)}.score-card:has(.score-result[data-section="2"]:is(:hover,:focus)) .score-segment[data-segment="2"]{transform:translateY(-10px) scale(1.15)}.score-card:has(.score-result[data-section="3"]:is(:hover,:focus)) .score-segment[data-segment="3"]{transform:translate(5px,-8px) scale(1.15)}.score-card:has(.score-result[data-section="4"]:is(:hover,:focus)) .score-segment[data-segment="4"]{transform:translate(8px,6px) scale(1.15)}.score-segment-moderate{stroke:#9a4328}.hands-bar{display:block;width:100%;height:auto;margin-top:-28%}.score-caption{position:absolute;top:-7%;left:50%;z-index:1;margin:0;font-size:clamp(1.2rem,2.4vw,1.7rem);font-weight:800;white-space:nowrap;transform:translateX(-50%)}[data-grip-card="landing"] .overall-score,[data-grip-card="progress"] .overall-score{font-size:clamp(1.15rem,2.4vw,1.65rem);top:28%;left:50%;white-space:nowrap}.overall-score{position:absolute;top:38%;left:54%;z-index:1;margin:0;text-align:center;font-size:clamp(4.2rem,8vw,7rem);font-weight:800;line-height:1.05;white-space:nowrap;transform:translate(-50%,-50%)}.score-out-of{display:inline-block;margin-left:.08em;font-size:.22em;font-weight:700;vertical-align:baseline}.score-results{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));margin-top:8px;padding:20px 0;border-top:1px solid var(--rule);border-bottom:1px solid var(--rule)}.score-result{position:relative;min-width:0;min-height:172px;display:flex;align-items:center;flex-direction:column;padding:3px clamp(8px,1.2vw,16px);border-right:1px solid var(--rule);font-size:var(--type-card);font-weight:var(--font-weight-semibold);line-height:var(--leading-card);text-align:center;cursor:pointer;transform-origin:center;transition:transform 250ms ease-out,opacity 250ms ease-out,background-color 250ms ease-out}.score-result:last-child{border-right:0}.score-result.is-active{z-index:2;background:var(--reading);transform:scale(1.08)}.score-result:focus-visible{z-index:3;outline:3px solid var(--amber);outline-offset:3px}.score-result strong{margin-top:auto;font-size:clamp(1.5rem,2.5vw,2rem);line-height:1}.score-result small{margin-top:7px;font-size:var(--type-card);font-weight:var(--font-weight-heavy);letter-spacing:var(--tracking-caption);line-height:var(--leading-card)}.result-label{min-height:3.45em;color:inherit}.score-icon{width:42px;height:42px;flex:0 0 auto;margin-bottom:10px;background:currentColor;mask:center/contain no-repeat}.demand{mask-image:url('/assets/operational-grip/icons/demand.svg')}.ownership{mask-image:url('/assets/operational-grip/icons/ownership.svg')}.results{mask-image:url('/assets/operational-grip/icons/results.svg')}.adaptation{mask-image:url('/assets/operational-grip/icons/adaptation.svg')}.ai{mask-image:url('/assets/operational-grip/icons/ai.svg')}@media(max-width:640px){.score-results{grid-template-columns:1fr}.score-result{min-height:136px;grid-template-columns:42px 1fr auto auto;grid-template-rows:auto;align-items:center;text-align:left}}</style>
