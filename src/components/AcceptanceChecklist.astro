---
import { isAccepted, lifecycleState, lastPublished, sortAcceptanceSnapshots } from "../lib/acceptance-lifecycle.mjs";
import { acceptanceStatus } from "../lib/acceptance-status.mjs";

import { acceptanceSnapshots } from "../data/acceptance-snapshots.js";
import acceptanceStatusHistory from "../data/acceptance-status.json";
import { canonicalUrl, pageSeo } from "../seo/registry.mjs";
const { html, standingHtml = "", results = false, archive = false, snapshotId, brief = false } = Astro.props;
const milestoneDate = (value: string | null | undefined) => value ? new Date(value).toLocaleString("en-US", { timeZone: "America/Chicago", timeZoneName: "short" }) : "Not Recorded";
const snapshot = acceptanceSnapshots.find(entry => entry.id === snapshotId);
const briefPagePath = snapshot?.brief?.pageRoute?.replace(/\/+$/, "");
const briefPageMetadata = briefPagePath ? pageSeo[briefPagePath] : null;
const evidence = import.meta.glob<{ records: any[] }>("../data/acceptance-snapshots/*.json", { eager: true });
const records = snapshot ? evidence[`../data/acceptance-snapshots/${snapshot.id}.json`].records : [];
const snapshotItems = [...html.matchAll(/<tr>\s*<td>(\d{3})<\/td>/g)].map(([, item]) => item);
const briefConditions = [...html.matchAll(/<tr>\s*<td>(0\d{2})<\/td>([\s\S]*?)<\/tr>/g)].map(([, item, rest]) => ({
  item,
  conditionHtml: [...rest.matchAll(/<td>([\s\S]*?)<\/td>/g)][1]?.[1] ?? "",
}));
const incrementSuite = Boolean(snapshot && snapshotItems.length && snapshotItems.every(item => /^0\d{2}$/.test(item)));
const lifecycles = import.meta.glob<{ default: any }>("../data/acceptance-lifecycle/*.json", { eager: true });
const lifecycle = lifecycles[`../data/acceptance-lifecycle/${snapshotId}.json`]?.default;
const standingPlus = new Set((lifecycle?.events ?? []).find((event: { type?: string }) => event.type === "accepted")?.standingPlus ?? []);
const incrementAcceptanceStatus = (source: string, resultRecords: any[]) => {
  const latest = new Map<string, any>();
  for (const record of resultRecords) {
    if (!/^\d{3}$/.test(record.item)) continue;
    const previous = latest.get(record.item);
    if (!previous || Date.parse(record.checkedAt) >= Date.parse(previous.checkedAt)) latest.set(record.item, record);
  }
  const counts = { passed: 0, failed: 0, unverified: 0, judgment: 0, total: 0 };
  const labels = { passed: "Passed", failed: "Failed", unverified: "Review", judgment: "Judgment" };
  const symbols = { passed: "P", failed: "F", unverified: "R", judgment: "J" };
  type ResultState = keyof typeof symbols;
  const plain = (value: string) => value.replace(/<[^>]*>/g, "").replace(/^\+\s*/, "").trim();
  const rendered = source.replace("<th>Item</th>", '<th scope="col" class="acceptance-status-heading">Status</th><th>Item</th>').replace(/<tr>\s*<td>(\d{3})<\/td>([\s\S]*?)<\/tr>/g, (_row, item, rest) => {
    const condition = plain([...rest.matchAll(/<td>([\s\S]*?)<\/td>/g)][1]?.[1] ?? "");
    const record = latest.get(item);
    const recordedState = record?.status as ResultState;
    const recordedCondition = record?.condition ? plain(record.condition) : "";
    const state: ResultState = standingPlus.has(item) && recordedState === "passed" ? "passed" : recordedCondition === condition && Object.hasOwn(symbols, recordedState) ? recordedState : "unverified";
    counts[state]++;
    counts.total++;
    const itemCell = standingPlus.has(item) ? "<strong>added to standing suite</strong>" : item;
    return `<tr id="${item}" data-acceptance-row="${state}"><td class="acceptance-current-status" title="${labels[state]}"><span class="acceptance-status acceptance-status--${state}" role="img" aria-label="${labels[state]}">${symbols[state]}</span></td><td>${itemCell}</td>${rest}</tr>`;
  });
  return { html: rendered, counts, applicable: counts.total, processCount: 0, lastCheckedAt: null };
};
const status = results && html ? (incrementSuite ? incrementAcceptanceStatus(html, records) : acceptanceStatus(html, records)) : null;
const standingRecords = acceptanceStatusHistory.records.filter(record => !(record.status === "unverified" && record.reviewer === "Codex Builder"));
const standingStatus = results && incrementSuite && standingHtml ? acceptanceStatus(standingHtml, standingRecords) : null;
const progress = lifecycleState(lifecycle);
const accepted = isAccepted(lifecycle, snapshot?.acceptedByDefault === true);
const published = lastPublished(lifecycle, records);
const stampActor = (event: { actor?: string } | undefined) => event?.actor ? ` (${event.actor})` : "";
const initializationStatus = progress.status;
const initializationLabel = initializationStatus === 'passed' ? 'Passed' : initializationStatus === 'failed' ? 'Failed' : 'Review';
const initializationSymbol = initializationStatus === 'passed' ? 'P' : initializationStatus === 'failed' ? 'F' : 'R';
const releaseDate = (entry: typeof snapshot) => {
 const state = lifecycleState(lifecycles[`../data/acceptance-lifecycle/${entry?.id}.json`]?.default);
 return state.releasePrepared?.at ?? state.deployed?.at ?? entry?.deployedAt ?? entry?.createdAt ?? entry?.milestoneCompletedAt;
};
const archivedSuites = sortAcceptanceSnapshots(acceptanceSnapshots);
const archivedRows = Array.from({ length: Math.ceil(archivedSuites.length / 2) }, (_, index) => archivedSuites.slice(index * 2, index * 2 + 2));
const recentSuite = archivedSuites[0];
const weeklySuite = archivedSuites.find(entry => /^weekly-\d{4}-\d{2}-\d{2}$/.test(entry.id));
const displayTables = (source: string, showStatusHint = true) => {
 let heading = "";
 const tables = [...source.matchAll(/<h[2-4][^>]*>[\s\S]*?<\/h[2-4]>|<table[\s\S]*?<\/table>/g)].map(([block]) => {
  if (block.startsWith('<h')) { heading = block; return ''; }
  const liveTable = block.replace(/<tr>(?:(?!<\/tr>)[\s\S])*?Process item: reported in the task report[\s\S]*?<\/tr>/g, "");
  return liveTable.includes('data-acceptance-row=') ? heading + liveTable.replaceAll('<th>Verification</th>', '<th>Test</th>').replaceAll('<th>Review prompt</th>', '<th>Test</th>').replace('>Current Status</th>', '>Status</th>').replaceAll('role="img"', 'role="img" tabindex="0"') : '';
 }).join('');
 return showStatusHint ? tables.replace(/<table[\s\S]*?<\/table>/, table => '<div class="hinted-table"><span class="status-hover-hint">* Hover for Status.</span>' + table + '</div>') : tables;
};
const testHtml = status ? displayTables(status.html, !incrementSuite) : '';
const standingTestHtml = standingStatus ? displayTables(standingStatus.html, !incrementSuite) : '';
---
<section class="acceptance-overview" aria-label={results ? "Recorded results" : "Acceptance testing"}>
{results && status ? <>
  {snapshot?.description && <h2 class="work-description">{incrementSuite ? `${accepted ? "Accepted" : "Not Accepted"}: ${snapshot.description}` : snapshot.description}{snapshot?.brief && <> <a class="working-brief-link" href={snapshot.brief.path}>(Working Brief)</a></>}</h2>}
  <div class="results-header-fields">
    <p><strong>Created:</strong> {milestoneDate(snapshot?.createdAt ?? lifecycle?.createdAt)}</p>
    <p><strong>Last published:</strong> {milestoneDate(published?.at)}{stampActor(published)}</p>
  </div>
  {incrementSuite && <h2 class="suite-heading">This increment has {snapshotItems.length} new Passing Acceptance Tests (PATs).</h2>}
  <p class="acceptance-counts">
    <span class="acceptance-status--unverified"><span aria-hidden="true">R</span> ({status!.counts.unverified}) Review</span>
    <span class="verdict-pair"><span class="acceptance-status--passed"><span aria-hidden="true">P</span> ({status!.counts.passed}/{status!.applicable}) PATs</span> <span aria-hidden="true">/</span> <span class="acceptance-status--failed"><span aria-hidden="true">F</span> ({status!.counts.failed}) PATs</span></span>
    <span class="acceptance-status--judgment"><span aria-hidden="true">J</span> ({status!.counts.judgment}) Judgment</span>
  </p>
  <div class="source-document acceptance-checklist" set:html={testHtml} />
  {standingStatus && <>
    <h2 class="suite-heading">The standing suite has {standingStatus.applicable} Passing Acceptance Tests (PATs).</h2>
    <div class="source-document acceptance-checklist" set:html={standingTestHtml} />
  </>}
</> : <p>Acceptance testing.</p>}
</section>
<style>
  .acceptance-overview .work-description { margin-block: 16px 12px; font-size: 1.5rem; line-height: 1.35; font-weight: 700; }
  .acceptance-overview :global(.working-brief-link) { display: inline-block; font-size: 1rem; font-weight: 400; }
  .results-header-fields { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 24px; margin-block: 16px; }
  .acceptance-overview .suite-heading { margin: 32px 0 8px; font-size: 1.5rem; }
  .acceptance-overview .acceptance-counts { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px 32px; margin-block: 8px 16px; font-weight: 600; }
  .acceptance-status--passed, .acceptance-checklist :global(.acceptance-status--passed) { color: #16803a; }
  .acceptance-status--failed, .acceptance-checklist :global(.acceptance-status--failed) { color: #dc2626; }
  .acceptance-status--unverified, .acceptance-checklist :global(.acceptance-status--unverified) { color: #287dcc; }
  .acceptance-status--judgment, .acceptance-checklist :global(.acceptance-status--judgment) { color: #bf4815; }
  .acceptance-checklist :global([data-acceptance-row="passed"] > td) { background: #effaf1; }
  .acceptance-checklist :global([data-acceptance-row="unverified"] > td) { background: #eef7ff; }
  .acceptance-checklist :global(.acceptance-status) { display: inline-block; font-size: 1.5rem; font-weight: 800; }
  .acceptance-checklist :global(th), .acceptance-checklist :global(td) { padding: 10px; border: 1px solid var(--rule); text-align: left; vertical-align: top; }
</style>
