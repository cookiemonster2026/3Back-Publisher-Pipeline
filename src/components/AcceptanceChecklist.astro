---
import { isAccepted, lifecycleState, lastPublished, sortAcceptanceSnapshots } from "../lib/acceptance-lifecycle.mjs";
import { acceptanceStatus } from "../lib/acceptance-status.mjs";

import { acceptanceSnapshots } from "../data/acceptance-snapshots.js";
import acceptanceStatusHistory from "../data/acceptance-status.json";
const { html, standingHtml = "", results = false, archive = false, snapshotId } = Astro.props;
const milestoneDate = (value: string | null | undefined) => value ? new Date(value).toLocaleString("en-US", { timeZone: "America/Chicago", timeZoneName: "short" }) : "Not Recorded";
const snapshot = acceptanceSnapshots.find(entry => entry.id === snapshotId);
const evidence = import.meta.glob<{ records: any[] }>("../data/acceptance-snapshots/*.json", { eager: true });
const records = snapshot ? evidence[`../data/acceptance-snapshots/${snapshot.id}.json`].records : [];
const housekeepingIncrement = snapshotId === "2026-09-11-171700";
const incrementAcceptanceStatus = (source: string, resultRecords: any[]) => {
  const latest = new Map<string, any>();
  for (const record of resultRecords) {
    const previous = latest.get(record.item);
    if (!previous || Date.parse(record.checkedAt) >= Date.parse(previous.checkedAt)) latest.set(record.item, record);
  }
  const counts = { passed: 0, failed: 0, unverified: 0, judgment: 0, total: 0 };
  const labels = { passed: "Passed", failed: "Failed", unverified: "Review", judgment: "Judgment" };
  const symbols = { passed: "P", failed: "F", unverified: "R", judgment: "J" };
  type ResultState = keyof typeof symbols;
  const plain = (value: string) => value.replace(/<[^>]*>/g, "").trim();
  const rendered = source.replace("<th>Item</th>", '<th scope="col" class="acceptance-status-heading">Status</th><th>Item</th>').replace(/<tr>\s*<td>(00[1-8])<\/td>([\s\S]*?)<\/tr>/g, (_row, item, rest) => {
    const condition = plain([...rest.matchAll(/<td>([\s\S]*?)<\/td>/g)][1]?.[1] ?? "");
    const record = latest.get(item);
    const recordedState = record?.status as ResultState;
    const state: ResultState = record?.condition === condition && Object.hasOwn(symbols, recordedState) ? recordedState : "unverified";
    counts[state]++;
    counts.total++;
    return `<tr id="${item}" data-acceptance-row="${state}"><td class="acceptance-current-status" title="${labels[state]}"><span class="acceptance-status acceptance-status--${state}" role="img" aria-label="${labels[state]}">${symbols[state]}</span></td><td>${item}</td>${rest}</tr>`;
  });
  return { html: rendered, counts, applicable: counts.total, processCount: 0, lastCheckedAt: null };
};
const status = results && html ? (housekeepingIncrement ? incrementAcceptanceStatus(html, records) : acceptanceStatus(html, records)) : null;
const standingStatus = results && housekeepingIncrement && standingHtml ? acceptanceStatus(standingHtml, acceptanceStatusHistory.records) : null;
const lifecycles = import.meta.glob<{ default: any }>("../data/acceptance-lifecycle/*.json", { eager: true });
const lifecycle = lifecycles[`../data/acceptance-lifecycle/${snapshotId}.json`]?.default;
const progress = lifecycleState(lifecycle);
const accepted = isAccepted(lifecycle, snapshot?.acceptedByDefault === true);
const published = lastPublished(lifecycle, records);
const stampActor = (event: { actor?: string } | undefined) => event?.actor ? ` (${event.actor})` : "";
const initializationStatus = progress.status;
const initializationLabel = initializationStatus === 'passed' ? 'Passed' : initializationStatus === 'failed' ? 'Failed' : 'Review';
const initializationSymbol = initializationStatus === 'passed' ? 'P' : initializationStatus === 'failed' ? 'F' : 'R';
const releaseDate = (entry: typeof snapshot) => {
 const state = lifecycleState(lifecycles[`../data/acceptance-lifecycle/${entry?.id}.json`]?.default);
 return state.releasePrepared?.at ?? state.deployed?.at ?? entry?.deployedAt ?? entry?.createdAt ?? entry?.milestoneCompletedAt;
};
const archivedSuites = sortAcceptanceSnapshots(acceptanceSnapshots);
const archivedRows = Array.from({ length: Math.ceil(archivedSuites.length / 2) }, (_, index) => archivedSuites.slice(index * 2, index * 2 + 2));
const recentSuite = archivedSuites[0];
const weeklySuite = archivedSuites.find(entry => /^weekly-\d{4}-\d{2}-\d{2}$/.test(entry.id));
const displayTables = (source: string, showStatusHint = true) => {
 let heading = "";
 const tables = [...source.matchAll(/<h[2-4][^>]*>[\s\S]*?<\/h[2-4]>|<table[\s\S]*?<\/table>/g)].map(([block]) => {
  if (block.startsWith('<h')) { heading = block; return ''; }
  const liveTable = block.replace(/<tr>(?:(?!<\/tr>)[\s\S])*?Process item: reported in the task report[\s\S]*?<\/tr>/g, "");
  return liveTable.includes('data-acceptance-row=') ? heading + liveTable.replaceAll('<th>Verification</th>', '<th>Test</th>').replaceAll('<th>Review prompt</th>', '<th>Test</th>').replace('>Current Status</th>', '>Status</th>').replaceAll('role="img"', 'role="img" tabindex="0"') : '';
 }).join('');
 return showStatusHint ? tables.replace(/<table[\s\S]*?<\/table>/, table => '<div class="hinted-table"><span class="status-hover-hint">* Hover for Status.</span>' + table + '</div>') : tables;
};
const testHtml = status ? displayTables(status.html, !housekeepingIncrement) : '';
const standingTestHtml = standingStatus ? displayTables(standingStatus.html, !housekeepingIncrement) : '';
---

<section class="acceptance-overview" aria-label={results ? "Recorded results" : "Acceptance testing"}>
{results && status ? <>
  {snapshot?.description && <h2 class="work-description">{housekeepingIncrement ? `${accepted ? "Accepted" : "Not Accepted"}: ${snapshot.description}` : snapshot.description}</h2>}
  <div class="results-header-fields">
    <p><strong>Created:</strong> {milestoneDate(snapshot?.createdAt ?? lifecycle?.createdAt)}</p>
    <p><strong>Last published:</strong> {milestoneDate(published?.at)}{stampActor(published)}</p>
    {!housekeepingIncrement && <p class:list={["acceptance-state", { "acceptance-status--judgment": accepted }]}><strong>{accepted ? "Accepted" : "Not accepted"}</strong></p>}
  </div>

  {lifecycle && !housekeepingIncrement && <h3>Initialize</h3>}
  {lifecycle && !housekeepingIncrement && <div class="source-document acceptance-checklist">
    <table><thead><tr><th class="acceptance-status-heading">Status</th><th>Item</th><th>Verifier</th><th>Acceptance condition</th><th>Test</th></tr></thead>
    <tbody><tr id="000" data-acceptance-row={initializationStatus}><td class="acceptance-current-status" title={progress.initialization?.failures?.join(' ') || initializationLabel}><span class={`acceptance-status acceptance-status--${initializationStatus}`} role="img" aria-label={initializationLabel}>{initializationSymbol}</span></td><td>000</td><td>Independent AI Reviewer</td><td>Read <a href="/docs/reviewer-agents/">Reviewer Agents.md</a> and confirm repository access, required information, and readiness to perform according to its instructions.</td><td>Record Pass or Fail for this handoff. If Fail, state why and stop.</td></tr></tbody></table>
  </div>}
  {housekeepingIncrement && <h2 class="suite-heading">This increment has 8 new Passing Acceptance Tests (PATs).</h2>}
  <p class="acceptance-counts">
    <span class="acceptance-status--unverified"><span aria-hidden="true">R</span> ({status!.counts.unverified}) Review</span>
    <span class="verdict-pair"><span class="acceptance-status--passed"><span aria-hidden="true">P</span> ({status!.counts.passed}/{status!.applicable}) PATs</span> <span aria-hidden="true">/</span> <span class="acceptance-status--failed"><span aria-hidden="true">F</span> ({status!.counts.failed}) PATs</span></span>
    <span class="acceptance-status--judgment"><span aria-hidden="true">J</span> ({status!.counts.judgment}) Judgment</span>
  </p>
  <div class="source-document acceptance-checklist" set:html={testHtml} />
  {standingStatus && <>
    <h2 class="suite-heading">The standing suite has {standingStatus.applicable} Passing Acceptance Tests (PATs).</h2>
    <p class="acceptance-counts">
      <span class="acceptance-status--unverified"><span aria-hidden="true">R</span> ({standingStatus.counts.unverified}) Review</span>
      <span class="verdict-pair"><span class="acceptance-status--passed"><span aria-hidden="true">P</span> ({standingStatus.counts.passed}/{standingStatus.applicable}) PATs</span> <span aria-hidden="true">/</span> <span class="acceptance-status--failed"><span aria-hidden="true">F</span> ({standingStatus.counts.failed}) PATs</span></span>
      <span class="acceptance-status--judgment"><span aria-hidden="true">J</span> ({standingStatus.counts.judgment}) Judgment</span>
    </p>
    {lifecycle && <><h3 class="initialize-heading">Initialize</h3><div class="source-document acceptance-checklist">
      <table><thead><tr><th class="acceptance-status-heading">Status</th><th>Item</th><th>Verifier</th><th>Acceptance condition</th><th>Test</th></tr></thead>
      <tbody><tr id="000" data-acceptance-row={initializationStatus}><td class="acceptance-current-status" title={progress.initialization?.failures?.join(' ') || initializationLabel}><span class={`acceptance-status acceptance-status--${initializationStatus}`} role="img" aria-label={initializationLabel}>{initializationSymbol}</span></td><td>000</td><td>Independent AI Reviewer</td><td>Read <a href="/docs/reviewer-agents/">Reviewer Agents.md</a> and confirm repository access, required information, and readiness to perform according to its instructions.</td><td>Record Pass or Fail for this handoff. If Fail, state why and stop.</td></tr></tbody></table>
    </div></>}
    <div class="source-document acceptance-checklist" set:html={standingTestHtml} />
  </>}
  {snapshot && acceptanceSnapshots.some(entry => entry.supersededBy === snapshot.id) && <details><summary>Earlier evidence</summary>{acceptanceSnapshots.filter(entry => entry.supersededBy === snapshot.id).map(entry => <p><a href={entry.path}>{entry.description}</a></p>)}</details>}
</> : <>
  <nav class="snapshot-links" aria-label="Recorded reviews">
    {archive ? <table class="snapshot-table">
      <thead><tr><th scope="col">Archive entry</th><th scope="col">Archive entry</th></tr></thead>
      <tbody>{archivedRows.map(row => <tr>{row.map(entry => <td><a href={entry.path}>{milestoneDate(releaseDate(entry))}{isAccepted(lifecycles[`../data/acceptance-lifecycle/${entry.id}.json`]?.default, entry.acceptedByDefault === true) ? " (Accepted)" : ""}</a><p class="snapshot-description">{entry.description}</p></td>)}</tr>)}</tbody>
    </table> : <>
      {recentSuite && <div><strong>Recent:</strong> <a href={recentSuite.path}>{milestoneDate(releaseDate(recentSuite))}</a></div>}
      <div><strong>Weekly regression:</strong> {weeklySuite ? <a href={weeklySuite.path}>{weeklySuite.id}</a> : "None yet. Runs Sunday only after an accepted increment."}</div>
    </>}

  </nav>
  {!archive && <>
  <p>The intent is to use AI to augment and accelerate the workflow while preserving human control and reducing preventable drift between intent and the live implementation.</p>
  <div class="acceptance-procedure">
    <p><strong>Precondition:</strong> Human chooses an idea and begins to think about implementation.</p>
    <ol>
      <li><strong>AI Specifier</strong>
        <ul>
          <li>Defines the specification, acceptance conditions, and tests.</li>
          <li><strong>Human:</strong> Defines intent and approves the specification.</li>
        </ul>
      </li>
      <li><strong>AI Builder</strong>
        <ul>
          <li>Implements the specification.</li>
          <li>Flags items <strong class="acceptance-status--unverified">R Review</strong> when changes may affect their status.</li>
          <li><strong>Human:</strong> Authorizes commit and deployment.</li>
        </ul>
      </li>
      <li><strong>Independent AI Reviewer</strong>
        <ul>
          <li>Resolves items flagged <strong class="acceptance-status--unverified">R Review</strong> through live checks and specified tests.</li>
          <li>Reports <strong class="acceptance-status--passed">P Pass</strong> or <strong class="acceptance-status--failed">F Fail</strong>, proposing corrections for failures.</li>
          <li>Flags <strong class="acceptance-status--judgment">J Judgment</strong> when it cannot propose a defensible correction or test.</li>
          <li><strong>Human:</strong> Approves proposed corrections and any condition or test changes.</li>
        </ul>
      </li>
    </ol>
    <p><strong>Postcondition:</strong> Human has resolved remaining <strong class="acceptance-status--judgment">J Judgment</strong> issues and accepted the results.</p>
    <p>* In steps 1–3, the human works iteratively with the AI.</p>
    <p><strong>Exception path:</strong> When resolution requires revisiting the specification or implementation, return to the relevant step and repeat review after deployment.</p>
  </div>
  <p>Weekly regression runs Sunday night only when a change suite was accepted since the last weekly date. Results appear on Acceptance Results as weekly-YYYY-MM-DD. A report is mailed to weeklyregression@3back.com with a link to that page. If no increment closed that week, it does not run and no mail is sent.</p>
  </>}
</>}
</section>

<style>
  .acceptance-checklist :global(tr[id]) { scroll-margin-top: 110px; }
  .acceptance-checklist :global(tr:target) { outline: 3px solid var(--amber); outline-offset: -3px; }
  .acceptance-overview { margin-block: 12px 32px; padding-block: 0 20px; border-bottom: 1px solid var(--rule); }
  .acceptance-overview h2 { margin: 0 0 12px; font-size: 1rem; line-height: 1.5; }
  .acceptance-checklist :global(.hinted-table) { position: relative; margin-block: 24px; }
  .acceptance-checklist :global(.hinted-table table) { margin-block: 0; }
  .acceptance-checklist :global(.status-hover-hint) { position: absolute; top: -19px; left: 0; font-size: .8rem; line-height: 18px; }
  .results-header-fields { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 24px; margin-block: 16px; }
  .results-header-fields p { margin: 0; white-space: nowrap; }
  .acceptance-state { grid-column: 1 / -1; color: var(--ink, #202723); opacity: .72; }
  .verdict-pair { display: inline-flex; flex-wrap: wrap; align-items: baseline; gap: 6px; }

  .acceptance-overview .work-description { margin-block: 16px 12px; font-size: 1.5rem; line-height: 1.35; font-weight: 700; }
  .acceptance-overview .suite-heading { margin: 32px 0 8px; font-size: 1.5rem; line-height: 1.35; color: var(--ink, #202723); }
  .acceptance-overview .initialize-heading { margin: 32px 0 8px; }
  .snapshot-entry p { margin-block: 4px 12px; }
  .snapshot-links { display: flex; min-width: 0; flex-wrap: wrap; gap: 8px 24px; margin-block: 12px 24px; }
  .snapshot-table { width: 100%; max-width: 100%; min-width: 0; border-collapse: collapse; table-layout: fixed; }
  :global(.snapshot-table thead) { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
  :global(.snapshot-table td) { width: 50%; min-width: 0; padding: 8px 12px 12px 0; border: 0; vertical-align: top; overflow-wrap: anywhere; }
  :global(.snapshot-table td + td) { padding-inline-start: 12px; }
  :global(.snapshot-table .snapshot-description) { margin: 4px 0 0; }
  .acceptance-procedure { margin-block: 28px; margin-inline-start: clamp(12px, 3vw, 32px); }
  .acceptance-overview .acceptance-procedure p { margin-block: 10px; line-height: 1.45; }
  .acceptance-overview .acceptance-procedure ol { padding-left: 1.5rem; margin-block: 12px; }
  .acceptance-overview .acceptance-procedure ol > li { margin-block: 12px; line-height: 1.45; }
  .acceptance-overview .acceptance-procedure ul { padding-left: 1.5rem; margin-block: 4px 0; list-style: disc; }
  .acceptance-overview .acceptance-procedure ul > li { margin-block: 3px; line-height: 1.45; }

  .acceptance-overview .acceptance-counts { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px 32px; margin-block: 8px 16px; font-size: 1rem; font-weight: 600; }
  .acceptance-checklist { min-width: 0; overflow-wrap: anywhere; }
  .acceptance-checklist :global(table) { display: block; max-width: 100%; overflow-x: auto; border-collapse: collapse; margin-block: 24px; }
  .acceptance-checklist :global(th), .acceptance-checklist :global(td) { min-width: 120px; padding: 10px; border: 1px solid var(--rule); text-align: left; vertical-align: top; }
  .acceptance-checklist :global(th) { background: var(--reading); font-weight: 700; }
  .acceptance-checklist :global(h3), .acceptance-checklist :global(h4) { margin-top: 32px; }
  .acceptance-status--passed, .acceptance-checklist :global(.acceptance-status--passed) { color: #16803a; }
  .acceptance-status--failed, .acceptance-checklist :global(.acceptance-status--failed) { color: #dc2626; }
  .acceptance-status--unverified, .acceptance-checklist :global(.acceptance-status--unverified) { color: #287dcc; }
  .acceptance-status--judgment, .acceptance-checklist :global(.acceptance-status--judgment) { color: #bf4815; }
  .acceptance-checklist :global([data-acceptance-row="passed"] > td) { background: #effaf1; }
  .acceptance-checklist :global([data-acceptance-row="failed"] > td) { background: #fff1f2; }
  .acceptance-checklist :global([data-acceptance-row="unverified"] > td) { background: #eef7ff; }
  .acceptance-checklist :global([data-acceptance-row="judgment"] > td) { background: #fff0e8; }
  .acceptance-checklist :global(.acceptance-status) { display: inline-block; font-size: 1.5rem; line-height: 1; font-weight: 800; }
  .source-document.acceptance-checklist :global(.acceptance-current-status), .source-document.acceptance-checklist :global(.acceptance-status-heading) { width: 64px; min-width: 64px; max-width: 64px; padding: 10px 4px; text-align: center; }
  @media (max-width: 600px) {
    .results-header-fields { display: grid; grid-template-columns: 1fr; gap: 8px; }
    .results-header-fields p { white-space: normal; overflow-wrap: anywhere; }
    .acceptance-overview .acceptance-counts { grid-template-columns: 1fr; gap: 8px; }
    :global(.snapshot-table), :global(.snapshot-table tbody), :global(.snapshot-table tr), :global(.snapshot-table td) { display: block; width: 100%; }
    :global(.snapshot-table tr) { margin-bottom: 16px; }
    :global(.snapshot-table td), :global(.snapshot-table td + td) { padding: 2px 0 12px; }
  }
</style>
