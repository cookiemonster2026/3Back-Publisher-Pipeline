---
import SiteLayout from "../layouts/SiteLayout.astro";

interface Props {
	title: string;
	description: string;
}

const { title, description } = Astro.props;
---

<SiteLayout title={`${title} | 3Back`} description={description}>
	<main id="main" class="policy-page">
		<article class="shell policy-content">
			<h1>{title}</h1>
			<slot />
		</article>
	</main>
</SiteLayout>

<style>
	.policy-page { background: var(--paper); }
	.policy-content { max-width: 880px; padding-block: clamp(72px, 10vw, 120px); }
	.policy-content :global(h1) { padding-bottom: 28px; border-bottom: 4px solid var(--amber); }
	.policy-content :global(h2) { margin: 52px 0 18px; font-size: clamp(1.65rem, 3vw, 2.35rem); }
	.policy-content :global(p), .policy-content :global(li) { color: var(--text-primary); }
	.policy-content :global(ul) { margin: 0 0 28px; padding-left: 24px; }
	.policy-content :global(li) { margin-bottom: 12px; }
	.policy-content :global(li::marker) { color: var(--amber); }
	.policy-content :global(a) { text-decoration-color: var(--amber); text-decoration-thickness: 2px; text-underline-offset: 3px; }
	.policy-content :global(a:hover) { color: var(--charcoal); text-decoration-thickness: 3px; }
	.policy-content :global(hr) { margin: 52px 0; border: 0; border-top: 1px solid var(--rule); }
</style>
