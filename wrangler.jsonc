{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "3back-publisher-pipeline",
  "compatibility_date": "2026-08-06",
  "build": {
    "command": "pnpm build",
    "watch_dir": ["src", "public", "scripts", "astro.config.mjs"]
  },
  "main": "./functions/worker.mjs",
  "rules": [
    {
      "type": "Data",
      "globs": ["**/*.pdf"],
      "fallthrough": false
    }
  ],
  "vars": {
    "CONTACT_FROM_EMAIL": "noreply@3back.com",
    "CONTACT_NOTIFICATION_EMAIL": "og@3back.com"
  },
  "assets": {
    "directory": "./dist"
  }
}
